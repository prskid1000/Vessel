diff --git a/libs/vkd3d-shader/dxbc.c b/libs/vkd3d-shader/dxbc.c
index 11ecf596..d015c57c 100644
--- a/libs/vkd3d-shader/dxbc.c
+++ b/libs/vkd3d-shader/dxbc.c
@@ -63,16 +63,30 @@ static void read_float(const char **ptr, float *f)
     read_dword(ptr, (DWORD *)f);
 }
 
+/* Vessel: TRACE, not WARN.
+ *
+ * These fire on every DXBC blob that is parsed, on a healthy run, by design --
+ * the DWORDs skipped are reserved fields the container format specifies, and
+ * skipping them is normal operation rather than a problem. At WARN they are the
+ * single largest source of output in a session: measured on the device
+ * 2026-08-13, one Resident Evil Requiem run logged 26,966 lines from this
+ * channel across 3,025 shaders -- 98% of the whole session once FEX was
+ * silenced.
+ *
+ * Nothing is lost. Vessel runs VKD3D_SHADER_DEBUG at `warn` deliberately, so a
+ * shader that fails to translate says so; that tier is exactly what this noise
+ * was burying. TRACE keeps them reachable (VKD3D_SHADER_DEBUG=trace) and out of
+ * the tier that has to stay readable. */
 static void skip_dword_unknown(const char **ptr, unsigned int count)
 {
     unsigned int i;
     DWORD d;
 
-    WARN("Skipping %u unknown DWORDs:\n", count);
+    TRACE("Skipping %u unknown DWORDs:\n", count);
     for (i = 0; i < count; ++i)
     {
         read_dword(ptr, &d);
-        WARN("\t0x%08x\n", (int)d);
+        TRACE("\t0x%08x\n", (int)d);
     }
 }
 
@@ -121,7 +135,10 @@ static int parse_dxbc(const char *data, size_t data_size,
         return VKD3D_ERROR_INVALID_ARGUMENT;
     }
 
-    WARN("Ignoring DXBC checksum.\n");
+    /* Vessel: TRACE, not WARN -- see skip_dword_unknown. vkd3d ignores the DXBC
+     * checksum on every blob it has ever parsed; a message that is true of every
+     * call is not a warning about anything. */
+    TRACE("Ignoring DXBC checksum.\n");
     skip_dword_unknown(&ptr, 4);
 
     read_dword(&ptr, &version);
