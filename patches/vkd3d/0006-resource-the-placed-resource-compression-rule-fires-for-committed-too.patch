         disable_compression = true;

+    /* Vessel: a committed resource cannot alias, and vkd3d says so itself.
+     *
+     * The rule above is stated for placed resources -- its comment opens with
+     * D3D12's placed-resource initialization rules -- but it is applied to every
+     * resource kind, because it keys off desc->Flags alone and never reads
+     * resource->flags. vkd3d has already answered the aliasing question
+     * elsewhere, and answered it the other way: vkd3d_check_subresource_overlap
+     * opens with "No aliasing possible if either resource is committed"
+     * (command.c:5525-5527), and this very function grants
+     * VK_IMAGE_CREATE_ALIAS_BIT to placed resources only. A committed texture's
+     * memory belongs to that image alone -- suballocated ones have their size and
+     * alignment padded to bufferImageGranularity expressly "to prevent resource
+     * aliasing" -- so there is no neighbour to clobber and no stale metadata to
+     * inherit.
+     *
