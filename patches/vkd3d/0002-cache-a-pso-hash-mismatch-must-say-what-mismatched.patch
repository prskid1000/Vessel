diff --git a/libs/vkd3d/cache.c b/libs/vkd3d/cache.c
index 14a57556..1611d8b9 100644
--- a/libs/vkd3d/cache.c
+++ b/libs/vkd3d/cache.c
@@ -455,10 +455,46 @@ HRESULT d3d12_cached_pipeline_state_validate(struct d3d12_device *device,
     /* Verify the expected PSO state that was used. This must match, or we have to fail compilation as per API spec. */
     if (compat->state_desc_compat_hash != pso_compat->compat.state_desc_compat_hash)
     {
+        /* Vessel: say which hashes, and whether the shaders are the same
+         * shaders.
+         *
+         * "PSO compatibility hash mismatch" on its own cannot separate the
+         * two things it might mean, and they have opposite conclusions:
+         *
+         *  - the application handed back a blob it captured for a genuinely
+         *    different pipeline state, which this is *required* to reject --
+         *    the contract is E_INVALIDARG and the application recompiles; or
+         *  - the same pipeline state hashed differently on two occasions,
+         *    which would be a defect here and make the cache worthless.
+         *
+         * The DXBC hashes separate them and are already in hand. They derive
+         * from shader bytecode alone, so equal shader hashes beside an
+         * unequal state hash means the application is presenting the same
+         * shaders under different state -- render target formats, sample
+         * description, DSV format -- and the rejection is correct. If they
+         * differ too, the blob belongs to another pipeline entirely.
+         *
+         * Printed at whichever level the surrounding code had already
+         * chosen, so this adds detail to a line that was being emitted
+         * anyway rather than adding a line to a noisy run. */
+        bool same_shaders = memcmp(compat->dxbc_blob_hashes,
+                pso_compat->compat.dxbc_blob_hashes,
+                sizeof(compat->dxbc_blob_hashes)) == 0;
+
         if (VKD3D_CONFIG_FLAG_IS_SET(PIPELINE_LIBRARY_LOG))
-            INFO("PSO compatibility hash mismatch.\n");
+        {
+            INFO("PSO compatibility hash mismatch: expected %016"PRIx64", blob has %016"PRIx64", shaders %s.\n",
+                    compat->state_desc_compat_hash,
+                    pso_compat->compat.state_desc_compat_hash,
+                    same_shaders ? "identical" : "also differ");
+        }
         else
-            WARN("PSO compatibility hash mismatch.\n");
+        {
+            WARN("PSO compatibility hash mismatch: expected %016"PRIx64", blob has %016"PRIx64", shaders %s.\n",
+                    compat->state_desc_compat_hash,
+                    pso_compat->compat.state_desc_compat_hash,
+                    same_shaders ? "identical" : "also differ");
+        }
         return E_INVALIDARG;
     }
 
diff --git a/libs/vkd3d/state.c b/libs/vkd3d/state.c
index 6dde6140..a85bb22d 100644
--- a/libs/vkd3d/state.c
+++ b/libs/vkd3d/state.c
@@ -6415,6 +6415,41 @@ HRESULT d3d12_pipeline_state_create(struct d3d12_device *device, VkPipelineBindP
 
         if (FAILED(hr))
         {
+            /* Vessel: name the state the rejected blob was measured against.
+             *
+             * cache.c reports the two hashes and whether the shader set moved;
+             * this reports the fields that most often make two otherwise
+             * identical pipelines hash apart, so the pair of lines answers "which
+             * part of the state changed" without needing another build to ask.
+             *
+             * Render target formats are the ones worth recognising on sight. A
+             * title reconfigures its targets when the swapchain is reallocated,
+             * and Requiem's swapchain is reallocated on this stack as a matter of
+             * course -- it asks for 1920x1080 and the session's desktop is
+             * smaller -- so blobs captured before the reallocation are measured
+             * against a different format set afterwards. That is a correct
+             * rejection, and it should be readable as one rather than being
+             * mistaken for a broken cache.
+             *
+             * Only on the failure path: a run where every blob validates prints
+             * none of this.
+             */
+            if (hr == E_INVALIDARG)
+            {
+                unsigned int rt;
+
+                WARN("Rejected blob was validated against %u RTV(s), DSV %#x, %ux%u samples, topology %u, flags %#x.\n",
+                        desc->rtv_formats.NumRenderTargets, (unsigned int)desc->dsv_format,
+                        desc->sample_desc.Count, desc->sample_desc.Quality,
+                        (unsigned int)desc->primitive_topology_type, (unsigned int)desc->flags);
+
+                /* Bounded by the array as well as by the count. The count is the
+                 * application's, and the hash that disagreed reads it unbounded. */
+                for (rt = 0; rt < desc->rtv_formats.NumRenderTargets &&
+                        rt < ARRAY_SIZE(desc->rtv_formats.RTFormats); rt++)
+                    WARN("  RTV %u format %#x.\n", rt, (unsigned int)desc->rtv_formats.RTFormats[rt]);
+            }
+
             if (object->root_signature)
                 d3d12_root_signature_dec_ref(object->root_signature);
             rwlock_destroy(&object->lock);
