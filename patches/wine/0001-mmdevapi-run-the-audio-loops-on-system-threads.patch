diff --git a/dlls/mmdevapi/main.c b/dlls/mmdevapi/main.c
index 66a63275f5..3c795cdb71 100644
--- a/dlls/mmdevapi/main.c
+++ b/dlls/mmdevapi/main.c
@@ -211,6 +211,12 @@ BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved)
         case DLL_PROCESS_DETACH:
             if (drvs.module_unixlib)
             {
+                /* The main loop now runs on a system thread owned by the unix
+                 * half, so stopping it is a unix call and has to happen while
+                 * the unix library is still mapped -- i.e. before the
+                 * FreeLibrary below, not after it as the PE-side
+                 * main_loop_stop() could be. */
+                wine_unix_call( main_loop_stop, NULL );
                 wine_unix_call( process_detach, NULL );
                 FreeLibrary( drvs.module );
                 if (midi_driver.module != drvs.module)
@@ -219,7 +225,6 @@ BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved)
                     FreeLibrary( midi_driver.module );
                 }
             }
-            main_loop_stop();
 
             if (!lpvReserved)
                 MMDevEnum_Free();
