+            if (!map_view( &grown, page, page_size, 0,
+                           VPROT_COMMITTED | VPROT_READ | VPROT_WRITE, 0, 0, granularity_mask ))
+            {
+                ERR( "grew the commit by one page at %p: a write ran off the end of the view at %p size %08lx\n",
+                     page, prev->base, prev->size );
+                ret = STATUS_SUCCESS;
