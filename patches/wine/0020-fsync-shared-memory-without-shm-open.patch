+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Android's libc does not implement shm_open()/shm_unlink(), and says so:
+ *
+ *     bits/posix_limits.h:
+ *     #define _POSIX_SHARED_MEMORY_OBJECTS __BIONIC_POSIX_FEATURE_MISSING
+ *     // mmap/munmap are implemented, but shm_open/shm_unlink are not.
+ *
+ * There is no stub in libc either, so a translation unit that calls them does
+ * not compile, let alone link. Three in Proton's tree do:
+ *
+ *     dlls/ntdll/unix/fsync.c   the client half of fast synchronisation
+ *     server/fsync.c            the wineserver half of it
+ *     dlls/ntdll/unix/virtual.c FEX's per-process statistics region
+ *
+ * A plain file is a complete substitute, because that is all shm_open ever was.
+ * On glibc it opens a path under /dev/shm, which is a tmpfs; every property the
+ * callers rely on comes from mmap( MAP_SHARED ) on the resulting descriptor,
+ * and MAP_SHARED on a regular file gives the same shared, coherent mapping.
+ * ftruncate, mmap, close and unlink are unchanged.
+ *
+ * The directory must be one that every process in the session agrees on and can
+ * write to. XDG_RUNTIME_DIR is that directory and Vessel always sets it; TMPDIR
+ * and a fixed path follow only so that an unset variable cannot silently send
+ * two processes to two different files -- which, for fsync, would mean a client
+ * that cannot find the server's region and calls exit(1).
+ *
+ * A leading '/' is mandatory in a POSIX shm name and is not part of any path,
+ * so it is dropped. Callers are left exactly as they were: each still builds
+ * the same name it always did, so both fsync halves still agree.
+ *
+ * Guarded on HAVE_SHM_OPEN, which configure defines through
+ * AC_SEARCH_LIBS(shm_open, rt), rather than on __ANDROID__. A glibc build gets
+ * the real functions and compiles none of this.
+ */
+
+#ifndef __WINE_VESSEL_SHM_H
+#define __WINE_VESSEL_SHM_H
+
+#ifndef HAVE_SHM_OPEN
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+static inline int vessel_shm_path( char *path, size_t len, const char *name )
+{
+    const char *dir = getenv( "XDG_RUNTIME_DIR" );
+
+    if (!dir || !*dir) dir = getenv( "TMPDIR" );
+    if (!dir || !*dir) dir = "/data/local/tmp";
+    if (*name == '/') name++;
+    if ((size_t)snprintf( path, len, "%s/%s", dir, name ) >= len)
+    {
+        errno = ENAMETOOLONG;
+        return -1;
+    }
+    return 0;
+}
+
+static inline int vessel_shm_open( const char *name, int flags, mode_t mode )
+{
+    char path[PATH_MAX];
+
+    if (vessel_shm_path( path, sizeof(path), name ) == -1) return -1;
+    return open( path, flags, mode );
+}
+
+static inline int vessel_shm_unlink( const char *name )
+{
+    char path[PATH_MAX];
+
+    if (vessel_shm_path( path, sizeof(path), name ) == -1) return -1;
+    return unlink( path );
+}
+
+#define shm_open   vessel_shm_open
+#define shm_unlink vessel_shm_unlink
+
+#endif /* HAVE_SHM_OPEN */
+
+#endif /* __WINE_VESSEL_SHM_H */
