ntdll: back the FEX stats shared mapping with memfd on bionic.

Android's libc has no POSIX shared memory: shm_open and shm_unlink do not
exist, and neither does the /dev/shm tmpfs they are implemented on top of.
The FEX stats hook carried by the upstream-arm64ec branch calls shm_open
directly, so cross-compiling Wine unix side for Android stops at:

    dlls/ntdll/unix/virtual.c:5971:10: error: call to undeclared function
    shm_open; ISO C99 and later do not support implicit function
    declarations [-Wimplicit-function-declaration]

memfd_create (bionic, API >= 30; Vessel builds against 35) gives the same
ftruncate-able MAP_SHARED descriptor the function actually uses. The one
capability it does not give is lookup by name from another process, so an
out-of-process FEX stats reader cannot attach on Android. Nothing in the
Vessel container does that -- FEX reaches the region through
NtQueryVirtualMemory, in process -- and the alternative is dropping the
information class outright.

Not suitable upstream as-is: a real fix would gate on a configure check
rather than __ANDROID__.
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index e43b50180fc..f7f7bcb0bd5
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -5945,6 +5945,47 @@ static unsigned int get_memory_image_info( HANDLE process, LPCVOID addr, MEMORY_
 }
 
 #if defined(linux) && defined(__aarch64__)
+
+#ifdef __ANDROID__
+/*
+ * bionic implements no POSIX shared memory at all: no shm_open, no shm_unlink,
+ * and no /dev/shm for them to operate on. memfd_create provides everything this
+ * function actually needs from shm_open — an ftruncate-able, MAP_SHARED-able
+ * anonymous descriptor — and nothing else.
+ *
+ * What is lost is lookup by name from another process, so an out-of-process FEX
+ * stats reader cannot attach to the region. FEX itself reaches it through
+ * NtQueryVirtualMemory from inside the same process, which still works.
+ *
+ * The descriptor is deliberately kept open between calls. Callers after the
+ * first arrive without O_CREAT and expect to reopen the *same* object by name;
+ * with a fresh memfd each time, every stats update would silently start from an
+ * empty region.
+ */
+static int fex_stats_fd = -1;
+
+static int fex_stats_shm_open( const char *name, int oflag )
+{
+    if (fex_stats_fd == -1) fex_stats_fd = memfd_create( name, MFD_CLOEXEC );
+    return fex_stats_fd;
+}
+
+static void fex_stats_shm_close( int fd )
+{
+    /* the memfd is the only handle on the region; closing it would free it */
+}
+#else
+static int fex_stats_shm_open( const char *name, int oflag )
+{
+    return shm_open( name, oflag, S_IRWXU | S_IRWXG | S_IRWXO );
+}
+
+static void fex_stats_shm_close( int fd )
+{
+    close( fd );
+}
+#endif
+
 NTSTATUS get_memory_fex_stats_shm( HANDLE process, LPCVOID addr, MEMORY_FEX_STATS_SHM_INFORMATION *info,
                                    SIZE_T len, SIZE_T *res_len)
 {
@@ -5968,7 +6009,7 @@ NTSTATUS get_memory_fex_stats_shm( HANDLE process, LPCVOID addr, MEMORY_FEX_STAT
         oflag |= O_CREAT | O_TRUNC;
     }
 
-    fd = shm_open( buf, oflag, S_IRWXU | S_IRWXG | S_IRWXO );
+    fd = fex_stats_shm_open( buf, oflag );
     if (fd == -1) return STATUS_INTERNAL_ERROR;
 
     if (ftruncate( fd, info->map_size )) goto err;
@@ -5976,14 +6017,14 @@ NTSTATUS get_memory_fex_stats_shm( HANDLE process, LPCVOID addr, MEMORY_FEX_STAT
     if (mmap( fex_stats_shm, info->map_size, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED, fd,
               0 ) == MAP_FAILED) goto err;
 
-    close( fd );
+    fex_stats_shm_close( fd );
 
     info->shm_base = fex_stats_shm;
     *res_len = len;
     return STATUS_SUCCESS;
 
 err:
-    close( fd );
+    fex_stats_shm_close( fd );
     return STATUS_INTERNAL_ERROR;
 }
 #endif
