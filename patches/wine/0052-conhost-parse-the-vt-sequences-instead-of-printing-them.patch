+/* Vessel: ENABLE_VIRTUAL_TERMINAL_INPUT, the read-side half.
+ *
+ * conhost never implemented this either -- the flag appears nowhere in the file
+ * or in kernelbase/console.c -- and the consequence is quieter than the output
+ * side but just as final: in raw mode a key event with no UnicodeChar is
+ * dropped, so arrows, Home/End, PgUp/PgDn, Insert/Delete and the function keys
+ * reach the program as nothing at all. Rendering the output correctly and then
+ * swallowing the arrow keys would be a strange place to stop.
+ *
+ * xterm encoding, because that is what asks for it: PSReadLine, GNU readline
+ * and PyREPL all set this flag and then parse xterm. The modifier form is
+ * CSI 1 ; m <final>, m = 1 + shift + 2*alt + 4*ctrl, which is what makes
+ * Ctrl+Left move by a word.
+ *
+ * Returns NULL for a key with no sequence, leaving the existing UnicodeChar
+ * path to handle it exactly as before. */
+static const WCHAR *vt_input_sequence( const KEY_EVENT_RECORD *key, WCHAR *buf, size_t size )
+{
+    unsigned int state = key->dwControlKeyState;
+    unsigned int mod = 1, n = 0;
+    const char *tilde = NULL;
+    char final = 0;
+
+    if (state & SHIFT_PRESSED)                            mod += 1;
+    if (state & (LEFT_ALT_PRESSED | RIGHT_ALT_PRESSED))   mod += 2;
+    if (state & (LEFT_CTRL_PRESSED | RIGHT_CTRL_PRESSED)) mod += 4;
+
+    switch (key->wVirtualKeyCode)
+    {
+    case VK_UP:     final = 'A'; break;
+    case VK_DOWN:   final = 'B'; break;
+    case VK_RIGHT:  final = 'C'; break;
+    case VK_LEFT:   final = 'D'; break;
+    case VK_HOME:   final = 'H'; break;
+    case VK_END:    final = 'F'; break;
+
+    case VK_INSERT: tilde = "2";  break;
+    case VK_DELETE: tilde = "3";  break;
+    case VK_PRIOR:  tilde = "5";  break;
+    case VK_NEXT:   tilde = "6";  break;
+    case VK_F5:     tilde = "15"; break;
+    case VK_F6:     tilde = "17"; break;
+    case VK_F7:     tilde = "18"; break;
+    case VK_F8:     tilde = "19"; break;
+    case VK_F9:     tilde = "20"; break;
+    case VK_F10:    tilde = "21"; break;
+    case VK_F11:    tilde = "23"; break;
+    case VK_F12:    tilde = "24"; break;
+
+    /* F1-F4 are SS3 rather than CSI. A quirk of the encoding, not of this
+     * implementation; readline's keymaps expect exactly that. */
+    case VK_F1: case VK_F2: case VK_F3: case VK_F4:
+        if (size < 4) return NULL;
+        buf[0] = 0x1b; buf[1] = 'O';
+        buf[2] = 'P' + (key->wVirtualKeyCode - VK_F1);
+        buf[3] = 0;
+        return buf;
+
+    default:
+        return NULL;
+    }
+
+    /* Built a character at a time rather than with swprintf, which nothing else
+     * in this file uses and which would add a header dependency for four short
+     * strings. */
+    if (size < 12) return NULL;
+    buf[n++] = 0x1b;
+    buf[n++] = '[';
+    if (tilde) while (*tilde) buf[n++] = *tilde++;
+    else if (mod > 1) buf[n++] = '1';
+
+    if (mod > 1)
+    {
+        buf[n++] = ';';
+        buf[n++] = '0' + mod;   /* mod is 2..8, always one digit */
+    }
+    buf[n++] = tilde ? '~' : final;
+    buf[n] = 0;
+    return buf;
+}
