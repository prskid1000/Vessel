         {
             switch (buffer[i])
diff --git a/programs/conhost/conhost.h b/programs/conhost/conhost.h
index d3485156894..e04670229e3 100644
--- a/programs/conhost/conhost.h
+++ b/programs/conhost/conhost.h
@@ -133,6 +133,31 @@ struct screen_buffer
     RECT                   win;                 /* current visible window on the screen buffer */
     struct font_info       font;                /* console font information */
     struct wine_rb_entry   entry;               /* map entry */
+
+    /* Vessel: state for the VT escape parser in write_console.
+     *
+     * On the screen buffer and not on write_console's stack, because a program
+     * is free to write ESC [ in one call and 31m in the next -- readline and
+     * PSReadLine both do, since they build a sequence and flush on whatever
+     * buffer boundary happens to fall. A parser that resets between calls loses
+     * the sequence and prints the tail: the same garbage this exists to remove,
+     * only rarer and harder to reproduce.
+     *
+     * Zero-initialised by the calloc in create_screen_buffer, which is what
+     * makes VT_GROUND == 0 and vt_ready == 0 the correct starting state. */
+    unsigned int           vt_state;            /* enum vt_parse_state */
+    WCHAR                  vt_seq[64];          /* accumulated CSI/OSC body */
+    unsigned int           vt_len;
+    unsigned int           vt_saved_x;          /* CSI s / CSI u */
+    unsigned int           vt_saved_y;
+    unsigned short         vt_default_attr;     /* what SGR 0 restores */
+    unsigned int           vt_ready;            /* vt_default_attr captured */
+    /* SGR 7 is reverse video and SGR 27 turns it off again, which only works if
+     * the un-reversed colours still exist somewhere. Swapping `attr` in place
+     * loses them: 27 would have nothing to restore from. So SGR writes here and
+     * `attr` is derived. */
+    unsigned short         vt_base_attr;
+    unsigned int           vt_reverse;
 };
 
