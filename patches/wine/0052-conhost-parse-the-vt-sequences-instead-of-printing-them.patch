+/* Vessel: a VT escape parser for the windowed console.
+ *
+ * conhost emits VT on the tty path (set_tty_cursor, set_tty_attr) and never
+ * learned to read it, so with ENABLE_VIRTUAL_TERMINAL_PROCESSING set the
+ * sequences reached the screen as text -- "[?2004h[?25l[1;35m" where a prompt
+ * should be. WineHQ bug 49780. Python's REPL, Node's readline and PowerShell's
+ * PSReadLine all drive the terminal this way.
+ *
+ * Two earlier attempts answered through the console *mode* -- masking the bit,
+ * then failing SetConsoleMode -- and both were measured doing nothing, because
+ * these programs emit VT whatever the console reports. There is no mode answer.
+ *
+ * **The governing rule: a sequence must never reach the screen, including one
+ * this does not implement.** Every unhandled dispatch swallows. Missing an
+ * effect costs a few characters; printing the sequence costs the screen.
+ */
+enum vt_parse_state
+{
+    VT_GROUND = 0,   /* zero, so calloc gives the right initial state */
+    VT_ESC,
+    VT_CSI,
+    VT_OSC,
+    VT_OSC_ESC,
+};
+
+/* ANSI orders its colour bits blue-green-red and the console orders them
+ * red-green-blue, so the two disagree on every colour that is not a grey. */
+static unsigned short vt_ansi_to_attr( unsigned int n )
+{
+    return ((n & 1) ? FOREGROUND_RED   : 0) |
+           ((n & 2) ? FOREGROUND_GREEN : 0) |
+           ((n & 4) ? FOREGROUND_BLUE  : 0);
+}
+
+static void vt_erase( struct screen_buffer *screen_buffer, unsigned int from, unsigned int to,
+                      RECT *update_rect )
+{
+    unsigned int cells = screen_buffer->width * screen_buffer->height, i;
+
+    if (to > cells) to = cells;
+    if (from >= to) return;
+    for (i = from; i < to; i++)
+    {
+        screen_buffer->data[i].ch   = ' ';
+        /* The *current* attribute, which is what erasing is defined to use --
+         * "the background color of erased cells is colored according to the
+         * current SGR state" for both ED and EL. An earlier revision filled
+         * with the screen default instead, on the theory that conhost does not
+         * implement background-colour erase; that was wrong, and it is recorded
+         * here so it is not tried a third time. If a colour is appearing where
+         * it should not, the fault is in what SGR left in `attr`, not in the
+         * erase honouring it. */
+        screen_buffer->data[i].attr = screen_buffer->attr;
+    }
+    update_rect->left   = 0;
+    update_rect->right  = max( update_rect->right, screen_buffer->width - 1 );
+    update_rect->top    = min( update_rect->top,    from / screen_buffer->width );
+    update_rect->bottom = max( update_rect->bottom, (to - 1) / screen_buffer->width );
+}
+
+static void vt_apply_sgr( struct screen_buffer *screen_buffer, const unsigned int *params,
+                          unsigned int count )
+{
+    unsigned int i;
+
+    for (i = 0; i < count || (!count && !i); i++)
+    {
+        unsigned int p = count ? params[i] : 0;   /* bare CSI m means CSI 0 m */
+
+        if (!p)
+        {
+            screen_buffer->vt_base_attr = screen_buffer->vt_default_attr;
+            screen_buffer->vt_reverse = 0;
+        }
+        else if (p == 1)  screen_buffer->vt_base_attr |= FOREGROUND_INTENSITY;
+        else if (p == 22) screen_buffer->vt_base_attr &= ~FOREGROUND_INTENSITY;
+        else if (p == 7)  screen_buffer->vt_reverse = 1;
+        else if (p == 27) screen_buffer->vt_reverse = 0;
+        else if (p >= 30 && p <= 37)
+            screen_buffer->vt_base_attr = (screen_buffer->vt_base_attr & ~0x07) |
+                                          vt_ansi_to_attr( p - 30 );
+        else if (p == 39)
+            screen_buffer->vt_base_attr = (screen_buffer->vt_base_attr & ~0x07) |
+                                          (screen_buffer->vt_default_attr & 0x07);
+        else if (p >= 40 && p <= 47)
+            screen_buffer->vt_base_attr = (screen_buffer->vt_base_attr & ~0x70) |
+                                          (vt_ansi_to_attr( p - 40 ) << 4);
+        else if (p == 49)
+            screen_buffer->vt_base_attr = (screen_buffer->vt_base_attr & ~0x70) |
+                                          (screen_buffer->vt_default_attr & 0x70);
+        else if (p >= 90 && p <= 97)
+            screen_buffer->vt_base_attr = (screen_buffer->vt_base_attr & ~0x07) |
+                                          vt_ansi_to_attr( p - 90 ) | FOREGROUND_INTENSITY;
+        else if (p >= 100 && p <= 107)
+            screen_buffer->vt_base_attr = (screen_buffer->vt_base_attr & ~0x70) |
+                                          (vt_ansi_to_attr( p - 100 ) << 4) | BACKGROUND_INTENSITY;
+        else if (p == 38 || p == 48)
+        {
+            /* 38;5;n and 38;2;r;g;b. Not approximated -- the point is to eat the
+             * parameters so they are not mistaken for further SGR codes. */
+            if (i + 1 < count && params[i + 1] == 5) i += 2;
+            else if (i + 1 < count && params[i + 1] == 2) i += 4;
+        }
+        /* 2 dim, 3 italic, 4 underline and their resets have no console
+         * attribute to carry them and are dropped rather than approximated. */
+    }
+
+    screen_buffer->attr = screen_buffer->vt_reverse
+            ? (unsigned short)(((screen_buffer->vt_base_attr & 0x0f) << 4) |
+                               ((screen_buffer->vt_base_attr & 0xf0) >> 4))
+            : screen_buffer->vt_base_attr;
+}
+
+static void vt_dispatch_csi( struct screen_buffer *screen_buffer, RECT *update_rect )
+{
+    unsigned int params[16], count = 0, i, priv = 0, cursor;
+    WCHAR final = screen_buffer->vt_seq[screen_buffer->vt_len - 1];
+
+    i = 0;
+    if (screen_buffer->vt_seq[0] == '?') { priv = 1; i = 1; }
+
+    for (; i + 1 < screen_buffer->vt_len && count < ARRAY_SIZE(params); )
+    {
+        unsigned int v = 0;
+        BOOL digits = FALSE;
+        while (i + 1 < screen_buffer->vt_len && screen_buffer->vt_seq[i] >= '0' &&
+               screen_buffer->vt_seq[i] <= '9')
+        {
+            v = v * 10 + (screen_buffer->vt_seq[i] - '0');
+            digits = TRUE;
+            i++;
+        }
+        params[count++] = digits ? v : 0;
+        if (i + 1 < screen_buffer->vt_len && screen_buffer->vt_seq[i] == ';') i++;
+        else break;
+    }
+
+    /* Vessel: every sequence, as received -- to a FILE, not to stderr.
+     *
+     * The first version of this used MESSAGE() and produced nothing, and the
+     * reason is worth keeping: **no conhost output reaches the session log at
+     * all.** Grepping a full session for "conhost" returns zero lines, and the
+     * process tags present are explorer.exe, fexofflinecompiler and the guest --
+     * never the console host. conhost is spawned by wineconsole with its own
+     * handles, so anything it writes to stderr goes nowhere this project can
+     * read. Every conhost diagnostic ever added here was invisible.
+     *
+     * `C:\vessel\tmp\` is a real directory in every session -- SessionRuntime's
+     * linkVesselTmp points it at the container's scratch, which is also how
+     * VESSEL_GFX_STATS reaches the host. A DOS path because a PE process cannot
+     * open a unix one; that lesson cost a day earlier.
+     *
+     * Opened per call and closed again: this is a diagnostic that exists to be
+     * removed, and a handle held open across a console's lifetime is a thing to
+     * clean up. A shell emits a handful of these per keystroke. */
+    {
+        unsigned int k;
+        char dbg[192];
+        int off = snprintf( dbg, sizeof(dbg), "csi %s", priv ? "?" : "" );
+        FILE *f;
+
+        for (k = 0; k < count && off > 0 && off < (int)sizeof(dbg); k++)
+            off += snprintf( dbg + off, sizeof(dbg) - off, "%u%s", params[k],
+                             k + 1 < count ? ";" : "" );
+
+        if ((f = fopen( "C:\\vessel\\tmp\\vt-trace.log", "a" )))
+        {
+            fprintf( f, "%s %c  attr=%04x base=%04x rev=%u default=%04x\n", dbg, (char)final,
+                     screen_buffer->attr, screen_buffer->vt_base_attr,
+                     screen_buffer->vt_reverse, screen_buffer->vt_default_attr );
+            fclose( f );
+        }
+    }
+
+    switch (final)
+    {
+    case 'm':
+        vt_apply_sgr( screen_buffer, params, count );
+        break;
+
+    case 'H':
+    case 'f':
+        screen_buffer->cursor_y = min( count > 0 && params[0] ? params[0] - 1 : 0,
+                                       screen_buffer->height - 1 );
+        screen_buffer->cursor_x = min( count > 1 && params[1] ? params[1] - 1 : 0,
+                                       screen_buffer->width - 1 );
+        break;
+
+    case 'A':
+        cursor = count && params[0] ? params[0] : 1;
+        screen_buffer->cursor_y -= min( cursor, screen_buffer->cursor_y );
+        break;
+    case 'B':
+        cursor = count && params[0] ? params[0] : 1;
+        screen_buffer->cursor_y = min( screen_buffer->cursor_y + cursor,
+                                       screen_buffer->height - 1 );
+        break;
+    case 'C':
+        cursor = count && params[0] ? params[0] : 1;
+        screen_buffer->cursor_x = min( screen_buffer->cursor_x + cursor,
+                                       screen_buffer->width - 1 );
+        break;
+    case 'D':
+        cursor = count && params[0] ? params[0] : 1;
+        screen_buffer->cursor_x -= min( cursor, screen_buffer->cursor_x );
+        break;
+    case 'G':
+        /* CHA. readline uses this every keystroke to return to column zero. */
+        screen_buffer->cursor_x = min( count && params[0] ? params[0] - 1 : 0,
+                                       screen_buffer->width - 1 );
+        break;
+
+    case 'J':
+    {
+        unsigned int at = screen_buffer->cursor_y * screen_buffer->width + screen_buffer->cursor_x;
+        unsigned int cells = screen_buffer->width * screen_buffer->height;
+
+        if (!count || !params[0]) vt_erase( screen_buffer, at, cells, update_rect );
+        else if (params[0] == 1)  vt_erase( screen_buffer, 0, at + 1, update_rect );
+        else                      vt_erase( screen_buffer, 0, cells, update_rect );
+        break;
+    }
+    case 'K':
+    {
+        unsigned int row = screen_buffer->cursor_y * screen_buffer->width;
+
+        if (!count || !params[0])
+            vt_erase( screen_buffer, row + screen_buffer->cursor_x,
+                      row + screen_buffer->width, update_rect );
+        else if (params[0] == 1)
+            vt_erase( screen_buffer, row, row + screen_buffer->cursor_x + 1, update_rect );
+        else
+            vt_erase( screen_buffer, row, row + screen_buffer->width, update_rect );
+        break;
+    }
+
+    case 's':
+        screen_buffer->vt_saved_x = screen_buffer->cursor_x;
+        screen_buffer->vt_saved_y = screen_buffer->cursor_y;
+        break;
+    case 'u':
+        screen_buffer->cursor_x = min( screen_buffer->vt_saved_x, screen_buffer->width - 1 );
+        screen_buffer->cursor_y = min( screen_buffer->vt_saved_y, screen_buffer->height - 1 );
+        break;
+
+    case 'h':
+    case 'l':
+        /* 25 is the cursor and the only private mode here with an effect worth
+         * having; 2004 (bracketed paste), 1049 (alternate screen) and the mouse
+         * modes are accepted and ignored, which is what stops "[?2004h" from
+         * appearing on screen. */
+        if (priv && count && params[0] == 25)
+            screen_buffer->cursor_visible = (final == 'h');
+        break;
+
+    default:
+        break;
+    }
+}
+
+/* Returns TRUE when the character was part of an escape sequence and must not
+ * be written to the screen. */
+static BOOL vt_consume( struct screen_buffer *screen_buffer, WCHAR ch, RECT *update_rect )
+{
+    if (!screen_buffer->vt_ready)
+    {
+        screen_buffer->vt_default_attr = screen_buffer->attr;
+        screen_buffer->vt_base_attr = screen_buffer->attr;
+        screen_buffer->vt_ready = 1;
+    }
+
+    switch (screen_buffer->vt_state)
+    {
+    case VT_GROUND:
+        if (ch != 0x1b) return FALSE;
+        screen_buffer->vt_state = VT_ESC;
+        return TRUE;
+
+    case VT_ESC:
+        screen_buffer->vt_len = 0;
+        if (ch == '[')      screen_buffer->vt_state = VT_CSI;
+        else if (ch == ']') screen_buffer->vt_state = VT_OSC;
+        else                screen_buffer->vt_state = VT_GROUND;  /* ESC c, ESC ( B, ESC 7 */
+        return TRUE;
+
+    case VT_CSI:
+        if (screen_buffer->vt_len < ARRAY_SIZE(screen_buffer->vt_seq))
+            screen_buffer->vt_seq[screen_buffer->vt_len++] = ch;
+        if ((ch >= 0x40 && ch <= 0x7e) ||
+            screen_buffer->vt_len == ARRAY_SIZE(screen_buffer->vt_seq))
+        {
+            if (ch >= 0x40 && ch <= 0x7e) vt_dispatch_csi( screen_buffer, update_rect );
+            screen_buffer->vt_state = VT_GROUND;
+        }
+        return TRUE;
+
+    case VT_OSC:
+        if (ch == 0x07) screen_buffer->vt_state = VT_GROUND;      /* BEL */
+        else if (ch == 0x1b) screen_buffer->vt_state = VT_OSC_ESC;
+        return TRUE;
+
+    case VT_OSC_ESC:
+        screen_buffer->vt_state = (ch == 0x5c) ? VT_GROUND : VT_ESC;   /* ESC backslash is ST */
+        return TRUE;
+    }
+    return FALSE;
+}
