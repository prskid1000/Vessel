+
+static DWORD default_channel_mask(WORD channels)
+{
+    switch(channels){
+    case 1: return SPEAKER_FRONT_CENTER;
+    case 2: return SPEAKER_FRONT_LEFT | SPEAKER_FRONT_RIGHT;
+    case 4: return KSAUDIO_SPEAKER_QUAD;
+    case 6: return KSAUDIO_SPEAKER_5POINT1;
+    case 8: return KSAUDIO_SPEAKER_7POINT1_SURROUND;
+    }
+    return (channels >= 32) ? ~0u : ((1u << channels) - 1);
+}
+
+/* Route each requested static object onto the channels of dev_mask. A speaker the
+ * device has is copied straight through; one it lacks is folded onto the nearest
+ * front channel(s) at -3 dB, LFE is dropped. With dev_mask == the requested speakers
+ * this is the identity layout Wine always used. */
+static void route_static_objects(SpatialAudioStreamImpl *stream, AudioObjectType static_mask, DWORD dev_mask)
+{
+    UINT32 i, left = speaker_channel(dev_mask, SPEAKER_FRONT_LEFT),
+           right = speaker_channel(dev_mask, SPEAKER_FRONT_RIGHT),
+           centre = speaker_channel(dev_mask, SPEAKER_FRONT_CENTER);
+    const float fold = 0.70710678f;
+
+    if(left == ~0) left = (right != ~0) ? right : (centre != ~0 ? centre : 0);
+    if(right == ~0) right = left;
+
+    for(i = 0; i < ARRAY_SIZE(stream->static_route); ++i){
+        UINT32 chan = speaker_channel(dev_mask, static_speaker[i]);
+        stream->static_route[i].chan[0] = stream->static_route[i].chan[1] = ~0;
+        stream->static_route[i].gain[0] = stream->static_route[i].gain[1] = 0.0f;
+        if(!(static_mask & (AudioObjectType_FrontLeft << i)))
+            continue;
+        if(chan != ~0){
+            stream->static_route[i].chan[0] = chan;
+            stream->static_route[i].gain[0] = 1.0f;
+        }else if(static_side[i] == -1){
+            stream->static_route[i].chan[0] = left;
+            stream->static_route[i].gain[0] = fold;
+        }else if(static_side[i] == 1){
+            stream->static_route[i].chan[0] = right;
+            stream->static_route[i].gain[0] = fold;
+        }else if(static_side[i] == 0){
+            stream->static_route[i].chan[0] = left;
+            stream->static_route[i].gain[0] = fold;
+            if(right != left){
+                stream->static_route[i].chan[1] = right;
+                stream->static_route[i].gain[1] = fold;
+            }
+        }
+        TRACE("routing static object %u to %d/%d\n", i,
+                (int)stream->static_route[i].chan[0], (int)stream->static_route[i].chan[1]);
+    }
+}
+
+static DWORD static_mask_to_speakers(AudioObjectType static_mask)
+{
+    DWORD mask = 0;
+    UINT32 i;
+    for(i = 0; i < ARRAY_SIZE(static_speaker); ++i)
+        if(static_mask & (AudioObjectType_FrontLeft << i))
+            mask |= static_speaker[i];
+    return mask;
+}
+
+static WORD count_bits(DWORD mask)
+{
+    WORD n = 0;
+    while(mask){
+        mask &= mask - 1;
+        ++n;
+    }
+    return n;
+}
+
+static HRESULT get_device_layout(IAudioClient *client, WORD *channels, DWORD *mask)
+{
+    WAVEFORMATEX *mix;
+    HRESULT hr = IAudioClient_GetMixFormat(client, &mix);
+    if(FAILED(hr))
+        return hr;
+    *channels = mix->nChannels;
+    if(mix->wFormatTag == WAVE_FORMAT_EXTENSIBLE && ((WAVEFORMATEXTENSIBLE *)mix)->dwChannelMask
+            && count_bits(((WAVEFORMATEXTENSIBLE *)mix)->dwChannelMask) == mix->nChannels)
+        *mask = ((WAVEFORMATEXTENSIBLE *)mix)->dwChannelMask;
+    else
+        *mask = default_channel_mask(mix->nChannels);
+    CoTaskMemFree(mix);
+    return S_OK;
+}
+
+static void set_stream_format(SpatialAudioStreamImpl *stream, WORD channels, DWORD mask)
+{
+    stream->stream_fmtex.Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
