+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <stddef.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "ddk/hidtypes.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+
+#include "unix_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(plugplay);
+
+/*
+ * Every other backend in this directory opens a device node. On Android an app
+ * cannot: /dev/input is root:input 0660 and untrusted_app is in neither group,
+ * which is why this build configures --without-sdl --without-udev --without-usb
+ * and why winebus has enumerated nothing at all. The only thing on the device
+ * that can see a gamepad is Android's own InputDevice API, and that lives in
+ * the app -- so the app is the bus, and this is its client half.
+ *
+ * The transport is the same shape as patches/wine/0005: a filesystem AF_UNIX
+ * SOCK_STREAM socket whose path arrives in an environment variable, absent when
+ * the app did not open one, in which case this backend reports itself
+ * unimplemented and winebus carries on exactly as it did before.
+ *
+ * The frame is fixed at 20 bytes in both directions, native byte order. Fixed
+ * rather than length-prefixed because there is one producer, one consumer and
+ * six message shapes between them; a short read is then a torn frame rather
+ * than a desynchronised stream, and the reader can simply keep accumulating.
+ *
+ *   app -> guest
+ *     0x01 ADDED    index                       a pad appeared in slot `index`
+ *     0x02 REMOVED  index                       it went away
+ *     0x03 STATE    index, buttons, hat, axes   its current state
+ *
+ *   guest -> app
+ *     0x81 RUMBLE   index, low, high, duration  play this on the pad's motors
+ *
+ * Axis values are Android's convention, which is also SDL's: signed, full
+ * scale, and Y positive *downwards*. They are negated on the way into the HID
+ * report exactly as bus_sdl.c does, with the same `-v - 1` so that the extremes
+ * stay symmetrical -- see the "match XUSB / GIP protocol" comment there.
+ */
+
+#define VESSEL_FRAME_SIZE 20
+
+#define VESSEL_MSG_ADDED   0x01
+#define VESSEL_MSG_REMOVED 0x02
+#define VESSEL_MSG_STATE   0x03
+#define VESSEL_MSG_RUMBLE  0x81
+
+/* Four, because XInput has four slots and there is no fifth thing to be. */
+#define VESSEL_PAD_MAX 4
+
+/*
+ * The pad presents as a wired Xbox 360 controller.
+ *
+ * Not vanity: `winexinput.sys` only attaches to a device winebus marked
+ * `is_gamepad`, and a great many games sniff the vid/pid directly and take a
+ * different path for "an Xbox controller" than for "a gamepad". 045e:028e is
+ * the one every title has been tested against for fifteen years. It is also
+ * absent from `is_hidraw_enabled`'s prefer-hidraw list, which matters: a device
+ * that wants hidraw but is not hidraw is dropped by the bus thread.
+ */
+#define VESSEL_VID 0x045e
+#define VESSEL_PID 0x028e
+
+struct vessel_device
+{
+    struct unix_device unix_device;
+    UINT index;
+};
+
+static inline struct vessel_device *impl_from_unix_device(struct unix_device *iface)
+{
+    return CONTAINING_RECORD(iface, struct vessel_device, unix_device);
+}
+
+static int vessel_fd = -1;
+static int vessel_stop_read = -1;
+static int vessel_stop_write = -1;
+static struct unix_device *vessel_devices[VESSEL_PAD_MAX];
+static struct list vessel_event_queue = LIST_INIT(vessel_event_queue);
+
+/* Buffered because a stream socket may hand back a torn frame at any boundary. */
+static BYTE vessel_partial[VESSEL_FRAME_SIZE];
+static UINT vessel_partial_len;
+
+static void vessel_write_frame(const BYTE *frame)
+{
+    UINT written = 0;
+    ssize_t ret;
+
+    if (vessel_fd < 0) return;
+    while (written < VESSEL_FRAME_SIZE)
+    {
+        ret = write(vessel_fd, frame + written, VESSEL_FRAME_SIZE - written);
+        if (ret > 0) written += ret;
+        else if (ret < 0 && errno == EINTR) continue;
+        else
+        {
+            /* The app went away. Say so once; the read side will notice too and
+             * take the devices down in order. */
+            WARN("vessel: could not write to the pad socket: %s\n", strerror(errno));
+            return;
+        }
+    }
+}
+
+static void vessel_device_destroy(struct unix_device *iface)
+{
+}
+
+static NTSTATUS vessel_device_start(struct unix_device *iface)
+{
+    return STATUS_SUCCESS;
+}
+
+static void vessel_device_stop(struct unix_device *iface)
+{
+    struct vessel_device *impl = impl_from_unix_device(iface);
+    if (impl->index < VESSEL_PAD_MAX && vessel_devices[impl->index] == iface)
+        vessel_devices[impl->index] = NULL;
+}
+
+/*
+ * Rumble goes back up the same socket.
+ *
+ * This is the whole argument for a HID device over an XInput shim, so it is
+ * wired even though the pad on the desk may have no motors: the app forwards it
+ * to the controller's own vibrator if it has one and drops it otherwise, which
+ * is a decision only the app can make.
+ */
+static NTSTATUS vessel_device_haptics_start(struct unix_device *iface, UINT duration_ms,
+                                            USHORT rumble_intensity, USHORT buzz_intensity,
+                                            USHORT left_intensity, USHORT right_intensity)
+{
+    struct vessel_device *impl = impl_from_unix_device(iface);
+    BYTE frame[VESSEL_FRAME_SIZE] = {0};
+
+    TRACE("iface %p, duration_ms %u, rumble %u, buzz %u.\n", iface, duration_ms,
+          rumble_intensity, buzz_intensity);
+
+    frame[0] = VESSEL_MSG_RUMBLE;
+    frame[1] = impl->index;
+    memcpy(frame + 2, &rumble_intensity, sizeof(USHORT));
+    memcpy(frame + 4, &buzz_intensity, sizeof(USHORT));
+    memcpy(frame + 6, &duration_ms, sizeof(UINT));
+    vessel_write_frame(frame);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS vessel_device_haptics_stop(struct unix_device *iface)
+{
+    return vessel_device_haptics_start(iface, 0, 0, 0, 0, 0);
+}
+
+static NTSTATUS vessel_device_physical_device_control(struct unix_device *iface, USAGE control)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS vessel_device_physical_device_set_gain(struct unix_device *iface, BYTE percent)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS vessel_device_physical_effect_control(struct unix_device *iface, BYTE index,
+                                                      USAGE control, BYTE iterations)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS vessel_device_physical_effect_update(struct unix_device *iface, BYTE index,
+                                                     struct effect_params *params)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+static const struct hid_device_vtbl vessel_device_vtbl =
+{
+    vessel_device_destroy,
+    vessel_device_start,
+    vessel_device_stop,
+    vessel_device_haptics_start,
+    vessel_device_haptics_stop,
+    vessel_device_physical_device_control,
+    vessel_device_physical_device_set_gain,
+    vessel_device_physical_effect_control,
+    vessel_device_physical_effect_update,
+};
+
+static void vessel_add_device(UINT index)
+{
+    const USAGE_AND_PAGE device_usage = {.UsagePage = HID_USAGE_PAGE_GENERIC,
+                                         .Usage = HID_USAGE_GENERIC_GAMEPAD};
+    struct device_desc desc =
+    {
+        .vid = VESSEL_VID,
+        .pid = VESSEL_PID,
+        .version = 0x0114,
+        .input = -1,
+        .uid = index,
+        .bus_type = BUS_TYPE_USB,
+        .is_gamepad = TRUE,
+        .is_hidraw = FALSE,
+        .manufacturer = {'V','e','s','s','e','l',0},
+        .product = {'V','e','s','s','e','l',' ','C','o','n','t','r','o','l','l','e','r',0},
+        .serialnumber = {'0','0','0','0',0},
+    };
+    struct vessel_device *impl;
+    struct unix_device *iface;
+
+    if (index >= VESSEL_PAD_MAX) return;
+    if (vessel_devices[index]) return;
+
+    desc.serialnumber[3] = '0' + index;
+
+    if (!(iface = hid_device_create(&vessel_device_vtbl, sizeof(struct vessel_device))))
+    {
+        ERR("vessel: out of memory creating pad %u\n", index);
+        return;
+    }
+    impl = impl_from_unix_device(iface);
+    impl->index = index;
+
+    /* Built here rather than in `start`, because the bus thread asks for the
+     * report descriptor the moment it sees DEVICE_CREATED -- it has to know the
+     * usages before it can decide whether the device is wanted at all. */
+    if (!hid_device_begin_report_descriptor(iface, &device_usage) ||
+        !hid_device_add_gamepad(iface) ||
+        !hid_device_add_haptics(iface) ||
+        !hid_device_end_report_descriptor(iface))
+    {
+        ERR("vessel: could not build the report descriptor for pad %u\n", index);
+        return;
+    }
+
+    /* Centred, not zeroed: an unread report is a stick held hard left until the
+     * first state frame arrives, and on a menu that is a cursor that will not
+     * stop moving. */
+    hid_device_set_abs_axis(iface, 0, 0);
+    hid_device_set_abs_axis(iface, 1, 0);
+    hid_device_set_abs_axis(iface, 2, 0);
+    hid_device_set_abs_axis(iface, 3, 0);
+    hid_device_set_abs_axis(iface, 4, 0);
+    hid_device_set_abs_axis(iface, 5, 0);
+    hid_device_move_hatswitch(iface, 0, 0, 0);
+
+    vessel_devices[index] = iface;
+    if (!bus_event_queue_device_created(&vessel_event_queue, iface, &desc))
+        ERR("vessel: could not queue the arrival of pad %u\n", index);
+    else
+        TRACE("vessel: pad %u arrived\n", index);
+}
+
+static void vessel_remove_device(UINT index)
+{
+    struct unix_device *iface;
+
+    if (index >= VESSEL_PAD_MAX) return;
+    if (!(iface = vessel_devices[index])) return;
+
+    vessel_devices[index] = NULL;
+    bus_event_queue_device_removed(&vessel_event_queue, iface);
+    TRACE("vessel: pad %u went away\n", index);
+}
+
+static void vessel_set_state(UINT index, const BYTE *frame)
+{
+    struct hid_device_state *state;
+    struct unix_device *iface;
+    UINT16 buttons;
+    INT16 axis[4];
+    UINT16 trigger[2];
+    BYTE hat;
+    UINT i;
+
+    if (index >= VESSEL_PAD_MAX) return;
+    if (!(iface = vessel_devices[index]))
+    {
+        /* Legitimate for the frame or two between the app dropping a pad and
+         * the guest hearing about it, so counted rather than said every time. */
+        static unsigned int missing;
+        if (missing++ < 10) WARN("vessel: state for pad %u but no device\n", index);
+        return;
+    }
+
+    memcpy(&buttons, frame + 2, sizeof(buttons));
+    hat = frame[4];
+    memcpy(axis, frame + 6, sizeof(axis));
+    memcpy(trigger, frame + 14, sizeof(trigger));
+
+    TRACE("vessel: pad %u axes %d %d %d %d buttons %#x\n", index,
+          axis[0], axis[1], axis[2], axis[3], buttons);
+
+    /* Buttons are HID usages 1..16, so bit n is usage n+1 -- which is A, B, X,
+     * Y, LB, RB, Back, Start, LThumb, RThumb, Guide, in the order xinput1_3
+     * reads them. The app owns that order; nothing here reinterprets it. */
+    for (i = 0; i < 16; i++) hid_device_set_button(iface, i, (buttons >> i) & 1);
+
+    /* Y and RY inverted on the way in, the same `-v - 1` bus_sdl.c applies, so
+     * that -32768 and 32767 stay each other's opposite after the flip. */
+    hid_device_set_abs_axis(iface, 0, axis[0]);
+    hid_device_set_abs_axis(iface, 1, -axis[1] - 1);
+    hid_device_set_abs_axis(iface, 2, axis[2]);
+    hid_device_set_abs_axis(iface, 3, -axis[3] - 1);
+    hid_device_set_abs_axis(iface, 4, trigger[0]);
+    hid_device_set_abs_axis(iface, 5, trigger[1]);
+
+    /* The hat is a bitmask on the wire and a direction in the report, because a
+     * d-pad can be pressed in two directions at once and a HID hatswitch has one
+     * value for each of the eight that means. */
+    hid_device_set_hatswitch_x(iface, 0, ((hat & 8) ? 1 : 0) - ((hat & 4) ? 1 : 0));
+    hid_device_set_hatswitch_y(iface, 0, ((hat & 2) ? 1 : 0) - ((hat & 1) ? 1 : 0));
+
+    /* **Assembling the report is not delivering it.** hid_device_sync_report
+     * only swaps this report against the previous one and answers whether it
+     * changed; it hands nothing to the driver. Every other backend follows it
+     * with bus_event_queue_input_report -- bus_sdl.c at four sites, bus_iohid.c
+     * at one -- and without that call the pad enumerates perfectly, answers
+     * XInput, DirectInput and winmm, and every axis reads dead centre forever.
+     * Nothing errors anywhere, which is exactly how it came to ship: measured
+     * on the device with a real controller held hard left, the guest read
+     * x=32767 y=32767 buttons=0 while the app was submitting frames. */
+    if (!hid_device_sync_report(iface))
+    {
+        TRACE("vessel: pad %u report unchanged\n", index);
+        return;
+    }
+
+    state = &iface->hid_device_state;
+    bus_event_queue_input_report(&vessel_event_queue, iface, state->report_buf, state->report_len);
+}
+
+static void vessel_handle_frame(const BYTE *frame)
+{
+    switch (frame[0])
+    {
+    case VESSEL_MSG_ADDED: vessel_add_device(frame[1]); break;
+    case VESSEL_MSG_REMOVED: vessel_remove_device(frame[1]); break;
+    case VESSEL_MSG_STATE: vessel_set_state(frame[1], frame); break;
+    default: WARN("vessel: unknown frame type %#x\n", frame[0]); break;
+    }
+}
+
+/* Every pad the app told us about, withdrawn -- the app is gone. */
+static void vessel_remove_all(void)
+{
+    UINT i;
+    for (i = 0; i < VESSEL_PAD_MAX; i++) vessel_remove_device(i);
+}
+
+/*
+ * Connect to `path`, which is abstract if it starts with '@'.
+ *
+ * Abstract is what the app actually serves, and the '@' is the convention every
+ * unix tool uses to say so. The reason is on the app's side: binding a
+ * filesystem socket needs `android.system.UnixSocketAddress`, which is not
+ * public API, so `LocalServerSocket` and the abstract namespace are the only
+ * route a Play-installable app has. It is the better address here anyway --
+ * nothing to unlink after a kill, and no 108-byte path to fit a sandbox path
+ * into. libxcb already reaches the app's X server exactly this way.
+ *
+ * The filesystem form is kept because it costs three lines and it is what every
+ * other unix socket in this tree looks like.
+ */
+static int vessel_connect(const char *path)
+{
+    struct sockaddr_un addr = {0};
+    socklen_t len;
+    int fd;
+
+    if (strlen(path) >= sizeof(addr.sun_path))
+    {
+        ERR("vessel: pad socket path is %zu bytes and sun_path holds %zu\n",
+            strlen(path), sizeof(addr.sun_path));
+        return -1;
+    }
+
+    if ((fd = socket(AF_UNIX, SOCK_STREAM, 0)) < 0)
+    {
+        ERR("vessel: could not create the pad socket: %s\n", strerror(errno));
+        return -1;
+    }
+
+    addr.sun_family = AF_UNIX;
+    if (path[0] == '@')
+    {
+        /* A leading NUL is what makes the kernel read the rest as a name in the
+         * abstract namespace, and the length must stop at the end of that name
+         * -- sizeof(addr) would pad it with NULs that become part of it. */
+        addr.sun_path[0] = '\0';
+        strcpy(addr.sun_path + 1, path + 1);
+        len = offsetof(struct sockaddr_un, sun_path) + 1 + strlen(path + 1);
+    }
+    else
+    {
+        strcpy(addr.sun_path, path);
+        len = sizeof(addr);
+    }
+
+    if (connect(fd, (struct sockaddr *)&addr, len) < 0)
+    {
+        /* Not an error: a container started outside the app has no app to talk
+         * to, and the rest of winebus is unaffected. */
+        WARN("vessel: no pad server at %s: %s\n", path, strerror(errno));
+        close(fd);
+        return -1;
+    }
+
+    return fd;
+}
+
+NTSTATUS vessel_bus_init(void *args)
+{
+    const char *path = getenv("WINE_PAD_SOCKET");
+    int pipefd[2];
+
+    TRACE("args %p\n", args);
+
+    if (!path || !*path)
+    {
+        TRACE("vessel: WINE_PAD_SOCKET is not set, no pad bus\n");
+        return STATUS_NOT_IMPLEMENTED;
+    }
+
+    if ((vessel_fd = vessel_connect(path)) < 0) return STATUS_NOT_SUPPORTED;
+
+    /* A self-pipe, so that stopping the bus does not have to wait out a poll.
+     * The alternative -- a timeout on the poll -- makes shutdown take as long as
+     * the timeout, every time, on a device where a session is stopped often. */
+    if (pipe(pipefd) < 0)
+    {
+        ERR("vessel: could not create the stop pipe: %s\n", strerror(errno));
+        close(vessel_fd);
+        vessel_fd = -1;
+        return STATUS_UNSUCCESSFUL;
+    }
+    vessel_stop_read = pipefd[0];
+    vessel_stop_write = pipefd[1];
+    vessel_partial_len = 0;
+
+    /* The one line kept at a level a session log shows. Everything else about
+     * this bus is only worth reading once you know it connected at all, and
+     * this is the line that says the app and the guest found each other. */
+    ERR("vessel: pad bus connected to %s\n", path);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS vessel_bus_wait(void *args)
+{
+    struct bus_event *result = args;
+    struct pollfd pfd[2];
+    BYTE buffer[VESSEL_FRAME_SIZE * 16];
+    ssize_t got;
+    UINT offset;
+
+    for (;;)
+    {
+        if (bus_event_queue_pop(&vessel_event_queue, result)) return STATUS_PENDING;
+
+        pfd[0].fd = vessel_fd;
+        pfd[0].events = POLLIN;
+        pfd[0].revents = 0;
+        pfd[1].fd = vessel_stop_read;
+        pfd[1].events = POLLIN;
+        pfd[1].revents = 0;
+
+        if (poll(pfd, 2, -1) < 0)
+        {
+            if (errno == EINTR) continue;
+            ERR("vessel: poll failed: %s\n", strerror(errno));
+            break;
+        }
+
+        if (pfd[1].revents) break;
+        if (!pfd[0].revents) continue;
+
+        got = read(vessel_fd, buffer, sizeof(buffer));
+        if (got < 0 && errno == EINTR) continue;
+        if (got <= 0)
+        {
+            /* The app closed the socket, which on this device means the session
+             * is going down. Withdraw the pads rather than leaving a game
+             * holding a device that answers nothing. */
+            if (got < 0) WARN("vessel: pad socket read failed: %s\n", strerror(errno));
+            else TRACE("vessel: the app closed the pad socket\n");
+            vessel_remove_all();
+            close(vessel_fd);
+            vessel_fd = -1;
+            /* Drain what the withdrawal queued before saying there is no more. */
+            if (bus_event_queue_pop(&vessel_event_queue, result)) return STATUS_PENDING;
+            break;
+        }
+
+        for (offset = 0; offset < (UINT)got; )
+        {
+            UINT want = VESSEL_FRAME_SIZE - vessel_partial_len;
+            UINT have = (UINT)got - offset;
+            UINT take = have < want ? have : want;
+
+            memcpy(vessel_partial + vessel_partial_len, buffer + offset, take);
+            vessel_partial_len += take;
+            offset += take;
+
+            if (vessel_partial_len < VESSEL_FRAME_SIZE) break;
+            vessel_partial_len = 0;
+            vessel_handle_frame(vessel_partial);
+        }
+    }
+
+    vessel_remove_all();
+    bus_event_queue_destroy(&vessel_event_queue);
+    result->type = BUS_EVENT_TYPE_NONE;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS vessel_bus_stop(void *args)
+{
+    char wake = 1;
+
+    if (vessel_stop_write < 0) return STATUS_SUCCESS;
+    if (write(vessel_stop_write, &wake, 1) != 1)
+        WARN("vessel: could not wake the pad bus: %s\n", strerror(errno));
+    return STATUS_SUCCESS;
+}
diff --git a/dlls/winebus.sys/main.c b/dlls/winebus.sys/main.c
index a6227be9908..b61b077bb9e 100644
--- a/dlls/winebus.sys/main.c
+++ b/dlls/winebus.sys/main.c
@@ -1263,6 +1263,20 @@ static NTSTATUS iohid_driver_init(void)
     return bus_main_thread_start(&bus);
 }
 
+/* No registry switch: the bus reports itself unimplemented when the app did not
+ * hand it a socket, which is the same thing and one fewer knob to get wrong. */
+static NTSTATUS vessel_driver_init(void)
+{
+    struct bus_main_params bus =
+    {
+        .name = L"VESSEL",
+        .init_args = &options,
+        .init_code = vessel_init,
+        .wait_code = vessel_wait,
+    };
+    return bus_main_thread_start(&bus);
+}
+
 static NTSTATUS fdo_pnp_dispatch(DEVICE_OBJECT *device, IRP *irp)
 {
     IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation(irp);
@@ -1282,6 +1296,7 @@ static NTSTATUS fdo_pnp_dispatch(DEVICE_OBJECT *device, IRP *irp)
         if (!sdl_driver_init()) options.disable_input = TRUE;
         udev_driver_init();
