+/******************************************************************************
+ *              DllCanUnloadNow        [OLE32.@]
+ *
+ * Vessel: ole32 is a system library and is never unloadable, so this always
+ * answers S_FALSE.
+ *
+ * Wine did not export it at all -- it is absent from ole32.spec and implemented
+ * nowhere in dlls/ole32 -- while Windows does. explorer.exe probes for it on
+ * every start, through the ordinary CoFreeUnusedLibraries path, and logged
+ *   module:LdrGetProcedureAddress "DllCanUnloadNow" (ordinal 0) not found
+ * eight times a session.
+ *
+ * Behaviourally this is a no-op: a caller that cannot find the entry point
+ * already treats the library as un-unloadable, which is the same answer S_FALSE
+ * gives. It exists so the probe succeeds and says so out loud, rather than
+ * failing and being interpreted.
+ */
+HRESULT WINAPI DllCanUnloadNow(void)
+{
+    return S_FALSE;
+}
+
