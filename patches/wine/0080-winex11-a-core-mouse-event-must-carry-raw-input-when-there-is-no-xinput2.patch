+/***********************************************************************
+ *              Vessel: raw mouse input without XInput2
+ *
+ * Raw mouse input has one producer upstream -- X11DRV_RawMotion() and
+ * X11DRV_RawButtonEvent(), both XI2 -- and the core paths deliberately suppress
+ * it with SEND_HWMSG_NO_RAW so the two halves do not double each other. Vessel's
+ * X server has no XInput extension, so xinput2_available is FALSE, that
+ * producer never runs, and WM_INPUT is never posted for a mouse: DirectInput and
+ * RegisterRawInputDevices() see nothing. Caribbean Legend reads its mouse
+ * through dinput8 and its menu could not be clicked.
+ *
+ * **Motion comes from the X server's own message when there is one.** Deriving
+ * raw motion from core pointer positions cannot work for a game that locks the
+ * mouse: positions are clamped to the screen, so Empyrion's mouse-look turned
+ * until the pointer reached the screen edge and then stopped. Vessel's X server
+ * sends the motion it was asked for, before clamping, as a _VESSEL_RAW_MOTION
+ * ClientMessage (handled in event.c); once one has arrived, raw motion comes
+ * only from those and core motion stops producing it, so nothing is doubled.
+ *
+ * **Before that, relative, and measured across warps.** The fallback for an X
+ * server that sends no such message: deltas between core positions, never the
+ * absolute position (which made dinput subtract a cursor the same event had
+ * already moved -- the game's cursor drifted off screen), and with the
+ * reference point moved by X11DRV_SetCursorPos, process-wide, so a game that
+ * re-centres every frame is not measured from where the pointer was before.
+ *
+ * Buttons always come from the core event; raw input needs them too.
+ */
+static pthread_mutex_t raw_base_mutex = PTHREAD_MUTEX_INITIALIZER;
+static int raw_base_x, raw_base_y;
+static BOOL raw_have_base;
+static BOOL raw_motion_from_server;
+
+static void set_raw_base( int x, int y )
+{
+    pthread_mutex_lock( &raw_base_mutex );
+    raw_base_x = x;
+    raw_base_y = y;
+    raw_have_base = TRUE;
+    pthread_mutex_unlock( &raw_base_mutex );
+}
+
+static void send_raw_relative( int dx, int dy, DWORD flags )
+{
+    INPUT raw = { .type = INPUT_MOUSE };
+
+    raw.mi.dx = dx;
+    raw.mi.dy = dy;
+    raw.mi.dwFlags = flags;
+    raw.mi.time = NtGetTickCount();
+    NtUserSendHardwareInput( 0, SEND_HWMSG_NO_MSG, &raw, 0 );
+}
+
+/* _VESSEL_RAW_MOTION, from event.c: the motion as the X server received it. */
+void x11drv_vessel_raw_motion( int dx, int dy )
+{
+    raw_motion_from_server = TRUE;
+    if (dx || dy) send_raw_relative( dx, dy, MOUSEEVENTF_MOVE );
+}
+
+static void send_raw_from_core_event( const INPUT *input )
+{
+    /* A copy, so buttons keep everything they carry -- mouseData is the wheel
+     * delta -- and only the motion half is rewritten. */
+    INPUT raw = *input;
+
+    raw.mi.dwFlags &= ~(MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_MOVE);
+    raw.mi.dx = 0;
+    raw.mi.dy = 0;
+
+    if ((input->mi.dwFlags & MOUSEEVENTF_MOVE) && !raw_motion_from_server)
+    {
+        int dx = 0, dy = 0;
+
+        pthread_mutex_lock( &raw_base_mutex );
+        if (raw_have_base)
+        {
+            dx = input->mi.dx - raw_base_x;
+            dy = input->mi.dy - raw_base_y;
+        }
+        raw_base_x = input->mi.dx;
+        raw_base_y = input->mi.dy;
+        raw_have_base = TRUE;
+        pthread_mutex_unlock( &raw_base_mutex );
+
+        if (dx || dy)
+        {
+            raw.mi.dx = dx;
+            raw.mi.dy = dy;
+            raw.mi.dwFlags |= MOUSEEVENTF_MOVE;
+        }
+    }
+
+    /* Nothing left: a move with no movement, or motion the X server reports. */
+    if (!raw.mi.dwFlags) return;
+    NtUserSendHardwareInput( 0, SEND_HWMSG_NO_MSG, &raw, 0 );
+}
+
+static BOOL core_event_needs_raw(void)
+{
+#ifdef HAVE_X11_EXTENSIONS_XINPUT2_H
+    return !xinput2_available;
+#else
+    return TRUE;
+#endif
+}
+
 /***********************************************************************
  *		send_mouse_input
  *
@@ -637,6 +744,7 @@ static void send_mouse_input( HWND hwnd, Window window, unsigned int state, INPU
         struct x11drv_thread_data *thread_data = x11drv_thread_data();
         if (!thread_data->clipping_cursor || thread_data->clip_window != window) return;
         NtUserSendHardwareInput( hwnd, SEND_HWMSG_NO_RAW, input, 0 );
+        if (core_event_needs_raw()) send_raw_from_core_event( input );
         return;
     }
 
@@ -661,6 +769,7 @@ static void send_mouse_input( HWND hwnd, Window window, unsigned int state, INPU
     }
 
     NtUserSendHardwareInput( hwnd, SEND_HWMSG_NO_RAW, input, 0 );
+    if (core_event_needs_raw()) send_raw_from_core_event( input );
 }
 
 #ifdef SONAME_LIBXCURSOR
@@ -1487,6 +1596,8 @@ BOOL X11DRV_SetCursorPos( INT x, INT y )
     pXFixesHideCursor( data->display, root_window );
     XWarpPointer( data->display, root_window, root_window, 0, 0, 0, 0, pos.x, pos.y );
     data->warp_serial = NextRequest( data->display );
+    /* Vessel: fallback raw deltas are measured from where the pointer now is. */
+    if (core_event_needs_raw()) set_raw_base( x, y );
     pXFixesShowCursor( data->display, root_window );
     XFlush( data->display ); /* avoids bad mouse lag in games that do their own mouse warping */
     TRACE( "warped to %d,%d serial %lu\n", x, y, data->warp_serial );
