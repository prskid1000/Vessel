diff --git a/dlls/ntdll/signal_arm64ec.c b/dlls/ntdll/signal_arm64ec.c
--- a/dlls/ntdll/signal_arm64ec.c
+++ b/dlls/ntdll/signal_arm64ec.c
@@ -1455,10 +1455,59 @@
 /**************************************************************************
  *              RtlIsEcCode (NTDLL.@)
  */
+/* Vessel: an address this bitmap does not cover is not EC code, it is not a
+ * fault.
+ *
+ * `alloc_arm64ec_map` in unix/virtual.c sizes the map at one bit per page of the
+ * address space and no further, and neither this function nor its unix twin
+ * `is_ec_code` bounded the index. An address past the end therefore read off the
+ * end of the allocation -- an access violation raised inside a query that has no
+ * business failing, because every caller is asking a question and the answer for
+ * an address that cannot be code is FALSE.
+ *
+ * FEX asks this about every guest branch target under ARM64EC
+ * (BranchTargetInMultiblockRange), so one bad target is enough. Resident Evil
+ * Requiem died on it every run: `code c0000005 at RtlIsEcCode +0x10` repeated 34
+ * times with the address identical each time, 7200 bytes of guest stack per
+ * delivery, until 4 MB was gone and the overflow was unrecoverable.
+ *
+ * **The bound comes from HighestUserAddress, and the first version of this patch
+ * is why that matters.** It cached the map's extent from NtQueryVirtualMemory at
+ * first use, which answers with one region rather than the whole reservation --
+ * so the bound came out too small, real EC addresses started reporting as not-EC,
+ * and Metro 2033 went from working to dying in an unrepairable write fault. A
+ * wrong FALSE here is a bigger lie than the out-of-range read this prevents: it
+ * tells the emulator that native ARM64EC code is x86-64 to translate. Measured,
+ * both directions, on the device.
+ *
+ * HighestUserAddress cannot be wrong in that way. It is the same quantity that
+ * sized the map, it is a fixed property of the address space rather than of one
+ * allocation's layout, and an address above it is not user code by definition --
+ * so the conservative direction and the correct direction are the same one. The
+ * query is made once; a failure leaves the limit at zero and every address reads
+ * as not-EC, which is the old behaviour minus the fault.
+ *
+ * The unix twin is deliberately left alone. Identical shape, identical hazard,
+ * but nothing has been observed faulting there and it is an inline on a hot path
+ * this change has not been measured against. One fix for the fault that was
+ * actually seen. */
 BOOLEAN WINAPI RtlIsEcCode( ULONG_PTR ptr )
 {
+    static ULONG_PTR user_limit;
     const UINT64 *map = (const UINT64 *)NtCurrentTeb()->Peb->EcCodeBitMap;
     ULONG_PTR page = ptr / page_size;
+
+    if (!map) return FALSE;
+
+    if (!user_limit)
+    {
+        SYSTEM_BASIC_INFORMATION sbi;
+
+        if (NtQuerySystemInformation( SystemBasicInformation, &sbi, sizeof(sbi), NULL )) return FALSE;
+        user_limit = (ULONG_PTR)sbi.HighestUserAddress;
+    }
+
+    if (ptr > user_limit) return FALSE;
     return (map[page / 64] >> (page & 63)) & 1;
 }
 
