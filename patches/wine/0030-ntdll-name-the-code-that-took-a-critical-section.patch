+/* Vessel: where the current owner took the lock, and which code called it.
+ *
+ * RtlpWaitForCriticalSection names the owning *thread* on a timeout, which says
+ * who is holding a lock and nothing about why. Resolving an address against the
+ * module bases loaddll already prints names the DLL and the offset.
+ *
+ * ONE ADDRESS WAS NOT ENOUGH, AND THE LOG SAID SO. Measured on a real deadlock:
+ *
+ *   sync:RtlpWaitForCriticalSection section 00000000388A7E28 "?" wait timed out
+ *   in thread 0184, blocked by 021c which took it at 0000006FFFF246B0,
+ *   retrying (60 sec)
+ *
+ * That address is ntdll+0xe46b0 in the exact ntdll that was running, and the
+ * nearest symbol is $ientry_thunk$cdecl$i8$i8 -- ntdll's own ARM64EC
+ * entry-thunk table. The lock had been taken by emulated x86-64 code calling in
+ * through a thunk, so the return address recorded was the thunk's own. Every
+ * x64-origin acquisition resolves to that same anonymous region however often
+ * it fires, which made the instrument useless for exactly the case it exists
+ * for.
+ *
+ * Hence the second address, and it is one frame-pointer hop rather than a stack
+ * walk. FEX pops the return address the guest's CALL pushed into lr and
+ * branches to the entry thunk (native/fex/Source/Windows/ARM64EC/Module.S,
+ * ExitFunctionSuspendResumePoint), and the thunk parks it in an ordinary
+ * AArch64 frame record. Disassembled out of the shipped ntdll rather than
+ * assumed:
+ *
+ *   $ientry_thunk$cdecl$i8$i8:
+ *     stp     q6, q7, [sp, #-0xb0]!
+ *     ...
+ *     stp     x29, x30, [sp, #0xa0]   <- x30 here is the GUEST return address
+ *     add     x29, sp, #0xa0
+ *     blr     x9                      <- calls RtlEnterCriticalSection
+ *
+ * So the first saved lr in the x29 chain that is not inside ntdll is the guest
+ * caller, in a module loaddll has already named. A native caller -- kernelbase,
+ * or anything that calls EnterCriticalSection directly -- falls out of the same
+ * walk one hop earlier, so one mechanism covers both and neither needs to be
+ * detected.
+ *
+ * One case does not yield the guest and is left alone rather than filtered: if
+ * the x64 caller left rsp only 8-byte aligned, FEX leaves the return address on
+ * the stack and hands the thunk lr = X64ReturnInstr instead (ret_sp_misaligned,
+ * same file). The walk then names libarm64ecfex, which is still a module, still
+ * resolvable, and still not a thunk.
+ *
+ * COST, because this is one of the hottest paths in the process: a bounded loop
+ * of at most CRIT_SITE_FRAMES iterations, two loads and three compares each,
+ * which stops on the first or second in both cases above. No unwind tables, no
+ * locks, no allocation, and nothing that can re-enter a critical section. That
+ * is why it is unconditional rather than gated on an environment variable: a
+ * gate would have to read the environment lazily from inside the process heap's
+ * own lock, which is a recursion hazard bought for less than it costs. The
+ * acquire this sits beside already executes ldaxr/stlxr and a `dmb ish` full
+ * barrier -- read out of the shipped RtlEnterCriticalSection, not assumed --
+ * and a handful of L1-hot loads will not be what dominates that.
+ *
+ * RtlCaptureStackBackTrace is rejected on both counts. It is an unwind-table
+ * lookup and a virtual unwind per frame, far too expensive to run on every
+ * acquisition, and patches/wine/0029 already measured that it does not answer
+ * this question anyway: for guest callers the captured frames stop at the entry
+ * thunk.
+ *
+ * A side table rather than the debug info, because there is no room in it:
+ * RTL_CRITICAL_SECTION_DEBUG.Spare is `DWORD_PTR Spare[8/sizeof(DWORD_PTR)]`
+ * under __WINESRC__ (winnt.h:6254), which is a single element on 64-bit, and
+ * Wine already keeps the section's name there. Spare[1] does not exist here and
+ * writing it would corrupt whatever follows the struct.
+ *
+ * Deliberately lossy and lock-free: a fixed table that can never fail or
+ * allocate, indexed by the section's own address. A collision or a torn read
+ * costs one wrong diagnostic line, which is the right trade for a counter that
+ * every lock acquisition in the process runs through. Nothing outside the ERR
+ * below reads it.
+ */
+#define CRIT_SITE_SLOTS 1024
+#define CRIT_SITE_FRAMES 8
+/* How far to look past a taken slot before giving up and evicting.
+ *
+ * **Measured, and the reason this exists.** With one slot per section and no
+ * probing, `took it at 0` was the common answer on a busy title: the key check
+ * below turns a collision into NULL, so any *other* section hashing to the same
+ * slot silently unnames a lock that is still held. A Requiem session reported
+ * one stuck section with a named holder and another with zero in the same
+ * minute, which is exactly what eviction looks like -- the named one had simply
+ * not been overwritten yet. Four probes and four times the slots make that
+ * rare; clearing on release, below, makes free slots the normal case. */
+#define CRIT_SITE_PROBES 4
+
+static const RTL_CRITICAL_SECTION *crit_site_keys[CRIT_SITE_SLOTS];
+static void *crit_site_addrs[CRIT_SITE_SLOTS];
+static void *crit_site_callers[CRIT_SITE_SLOTS];
+
+static inline unsigned int crit_site_slot( const RTL_CRITICAL_SECTION *crit )
+{
+    /* >> 4 because sections are allocated on at least 16-byte boundaries and
+     * the low bits are therefore always zero. */
+    return (unsigned int)(((ULONG_PTR)crit >> 4) % CRIT_SITE_SLOTS);
+}
+
+#if defined(__aarch64__) || defined(__arm64ec__)
+
+/* Is an address inside ntdll's own image? __ImageBase is the linker's and
+ * SizeOfImage comes out of our own headers, so this needs no loader lock and no
+ * allocation -- RtlPcToFileHeader would take the loader lock and could not be
+ * called from here. The cached size is written identically by every thread that
+ * computes it, so the missing barrier cannot produce a value that was never
+ * valid. */
+static inline BOOL crit_site_in_ntdll( ULONG_PTR addr )
+{
+    extern IMAGE_DOS_HEADER __ImageBase;
+    static ULONG image_size;
+
+    if (!image_size)
+    {
+        const IMAGE_NT_HEADERS *nt = (const IMAGE_NT_HEADERS *)((const char *)&__ImageBase + __ImageBase.e_lfanew);
+        image_size = nt->OptionalHeader.SizeOfImage;
+    }
+    return addr - (ULONG_PTR)&__ImageBase < image_size;
+}
+
+/* The first return address outside ntdll, walked one frame record at a time.
+ *
+ * AArch64 only, because the {saved x29, saved x30} pair is what makes this two
+ * loads instead of an unwind. Every pointer is range-checked against this
+ * thread's own stack before it is dereferenced, so a frame that established no
+ * record -- this build omits frame pointers where it can -- can cost a wrong
+ * answer but never a fault.
+ *
+ * DECLSPEC_NOINLINE is not decoration, it is a measurement. Inlined, clang
+ * unrolls the loop into all three recording sites: RtlTryEnterCriticalSection
+ * alone went from 0x40 bytes in the shipped ntdll to more than 0x360 in the
+ * object file. Out of line it is 0xb8 and one bl, and the walk is one shared
+ * copy. Starting a frame deeper costs nothing, because every frame that adds is
+ * inside ntdll and the loop skips exactly those. */
+static DECLSPEC_NOINLINE void *crit_section_caller(void)
+{
+    ULONG_PTR low = (ULONG_PTR)NtCurrentTeb()->Tib.StackLimit;
+    ULONG_PTR high = (ULONG_PTR)NtCurrentTeb()->Tib.StackBase;
+    ULONG_PTR frame = (ULONG_PTR)__builtin_frame_address(0);
+    unsigned int i;
+
+    for (i = 0; i < CRIT_SITE_FRAMES; i++)
+    {
+        ULONG_PTR next, site;
+
+        if (frame & 15) break;
+        if (frame < low || frame + 2 * sizeof(ULONG_PTR) > high) break;
+        next = ((const ULONG_PTR *)frame)[0];
+        site = ((const ULONG_PTR *)frame)[1];
+        if (!site) break;
+        if (!crit_site_in_ntdll( site )) return (void *)site;
+        if (next <= frame) break;   /* the chain only ever grows upwards */
+        frame = next;
+    }
+    return NULL;
+}
+
+#else  /* the frame record above is AArch64's; elsewhere only the site is known */
+
+static void *crit_section_caller(void)
+{
+    return NULL;
+}
+
+#endif
+
+/* This section's slot, or the first free one after it. Returns the base slot
+ * when neither exists, which is the eviction case and still bounded. */
+static inline unsigned int crit_site_find( const RTL_CRITICAL_SECTION *crit, int for_write )
+{
+    unsigned int base = crit_site_slot( crit );
+    unsigned int i;
+
+    for (i = 0; i < CRIT_SITE_PROBES; i++)
+    {
+        unsigned int slot = (base + i) % CRIT_SITE_SLOTS;
+
+        if (crit_site_keys[slot] == crit) return slot;
+        if (for_write && !crit_site_keys[slot]) return slot;
+    }
+    return base;
+}
+
+static inline void crit_section_note_site( const RTL_CRITICAL_SECTION *crit, void *site )
+{
+    unsigned int slot = crit_site_find( crit, TRUE );
+    /* the key last, so a reader that matches it has the best chance of seeing
+     * the two values that belong with it */
+    crit_site_addrs[slot] = site;
+    crit_site_callers[slot] = crit_section_caller();
+    crit_site_keys[slot] = crit;
+}
+
+/* Released, so the slot is free for the next section rather than held until
+ * something evicts it. This is what keeps probing cheap: a process with a few
+ * hundred live sections leaves most slots empty, so a colliding section finds
+ * space instead of unnaming whatever was there. */
+static inline void crit_section_forget_site( const RTL_CRITICAL_SECTION *crit )
+{
+    unsigned int base = crit_site_slot( crit );
+    unsigned int i;
+
+    for (i = 0; i < CRIT_SITE_PROBES; i++)
+    {
+        unsigned int slot = (base + i) % CRIT_SITE_SLOTS;
+
+        if (crit_site_keys[slot] != crit) continue;
+        crit_site_keys[slot] = NULL;
+        return;
+    }
+}
+
+static inline void *crit_section_get_site( const RTL_CRITICAL_SECTION *crit, void **caller )
+{
+    unsigned int slot = crit_site_find( crit, FALSE );
+    *caller = NULL;
+    if (crit_site_keys[slot] != crit) return NULL;
+    *caller = crit_site_callers[slot];
+    return crit_site_addrs[slot];
+}
+
