+        glsl_dst_cleanup(&dst, &gen->string_buffers);
+    }
+    else
+    {
+        vkd3d_string_buffer_printf(buffer, ";\n");
+    }
+
+    if (buffer != gen->buffer)
+        vkd3d_string_buffer_release(&gen->string_buffers, buffer);
