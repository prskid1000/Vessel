+        return;
+    }
+
+    /* TODO: Instead of marking all variable stores as read, we could only do
+     * it for the components within range. */
+    count = hlsl_type_component_count(var->data_type);
+    for (i = 0; i < count; ++i)
+    {
+        dse_mark_all_var_component_stores(ctx, state, var, i);
+    }
