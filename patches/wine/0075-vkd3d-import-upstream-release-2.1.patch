+            vsir->denormal_mode_f32 = VKD3D_SHADER_DENORMAL_MODE_ANY;
+        }
+        if (!vsir->denormal_mode_override_f64)
+        {
+            vsir->denormal_mode_override_f64 = true;
+            vsir->denormal_mode_f64 = VKD3D_SHADER_DENORMAL_MODE_ANY;
+        }
+    }
+}
