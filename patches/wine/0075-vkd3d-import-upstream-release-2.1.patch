+        const_index = true;
+        v_index = 0;
+    }
+    else if (index->reg.type == VSIR_REGISTER_IMMCONST)
+    {
+        const_index = true;
+        swizzle = vsir_swizzle_get_component(index->swizzle, vkd3d_ctz(index_mask));
+        v_index = index->reg.u.immconst_u32[swizzle] * stride;
