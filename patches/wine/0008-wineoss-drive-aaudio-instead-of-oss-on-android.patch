+static NTSTATUS oss_get_next_packet_size(void *args)
+{
+    struct get_next_packet_size_params *params = args;
+    struct oss_stream *stream = handle_get_stream(params->stream);
+    UINT32 *frames = params->frames;
+
+    oss_lock(stream);
