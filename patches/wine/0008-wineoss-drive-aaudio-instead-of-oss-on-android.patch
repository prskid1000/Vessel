+     * iterating the guest goes silent with nothing else in the log to say so.
+     * One line at each end costs nothing per stream and tells a future reader
+     * which half of the driver to suspect. */
+    TRACE("timer loop entered, period %d hns\n", (int)stream->period);
+
+    while(!stream->please_quit){
+        if(stream->playing){
+            if(stream->flow == eRender && stream->held_frames)
+                oss_write_data(stream);
+            else if(stream->flow == eCapture)
