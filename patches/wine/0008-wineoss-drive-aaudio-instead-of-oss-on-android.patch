+static WAVEFORMATEXTENSIBLE *clone_format(const WAVEFORMATEX *fmt)
+{
+    WAVEFORMATEXTENSIBLE *ret;
+    size_t size;
+
+    if(fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE)
+        size = sizeof(WAVEFORMATEXTENSIBLE);
+    else
+        size = sizeof(WAVEFORMATEX);
+
+    ret = malloc(size);
+    if(!ret)
+        return NULL;
+
+    memcpy(ret, fmt, size);
+
+    ret->Format.cbSize = size - sizeof(WAVEFORMATEX);
+
+    return ret;
+}
+
+static NTSTATUS oss_create_stream(void *args)
+{
+    struct create_stream_params *params = args;
+    WAVEFORMATEXTENSIBLE *fmtex;
+    struct oss_stream *stream;
+    int32_t capacity, burst;
+    SIZE_T size;
+
+    params->result = S_OK;
+
+    stream = calloc(1, sizeof(*stream));
+    if(!stream){
+        params->result = E_OUTOFMEMORY;
+        return STATUS_SUCCESS;
+    }
+
+    stream->flow = params->flow;
+    pthread_mutex_init(&stream->lock, NULL);
+
+    params->result = check_format(params->share, params->fmt);
+    if(FAILED(params->result))
+        goto exit;
+
+    params->result = open_aaudio_stream(params->flow, params->fmt, &stream->aas,
+                                        &stream->convert_to_i16);
+    if(FAILED(params->result))
+        goto exit;
+
+    fmtex = clone_format(params->fmt);
+    if(!fmtex){
+        params->result = E_OUTOFMEMORY;
+        goto exit;
+    }
+    stream->fmt = &fmtex->Format;
+
+    stream->period = params->period;
+    stream->period_frames = muldiv(params->fmt->nSamplesPerSec, params->period, 10000000);
+
+    if (stream->period_frames == 0)
+    {
+        params->result = E_INVALIDARG;
+        goto exit;
+    }
+
+    stream->bufsize_frames = muldiv(params->duration, params->fmt->nSamplesPerSec, 10000000);
+    if(params->share == AUDCLNT_SHAREMODE_EXCLUSIVE)
+        stream->bufsize_frames -= stream->bufsize_frames % stream->period_frames;
+
+    burst = AAudioStream_getFramesPerBurst(stream->aas);
+    capacity = AAudioStream_getBufferCapacityInFrames(stream->aas);
+
+    /* **Give the guest room to keep a burst in hand, whatever it asked for.**
+     *
+     * AAudio does not sip: it takes a whole burst at once, 868 frames on this
+     * device, 18 ms. A guest that keeps less than a burst queued therefore hands
+     * over everything it has on every pull, and the next pull finds nothing.
+     *
+     * Metro asks for 30 ms, 1440 frames. Measured 2026-08-11 with the oss channel
+     * on: `held` -- what the guest has produced and not yet had taken -- spent the
+     * session between 96 and 960 frames and reached 0 twice. It never approached
+     * 1440. So the guest was running a fifth of a burst ahead of a consumer that
+     * takes a burst at a time, and the queue hit zero about a tenth of every
+     * second: 54,240 underrun frames per ten seconds by AudioFlinger's count, 11%
+     * of the stream, heard as a continuous buzz.
+     *
+     * Raising the *device* buffer does not fix that, and this comment exists
+     * because two rebuilds went into finding out. `in_oss_frames` is by
+     * construction a subset of `held_frames` -- it is the part of the guest's
+     * ring already handed over -- so the device queue can never exceed what the
+     * guest has produced, however large the device buffer is. The binding
+     * constraint is this ring, and nothing downstream of it.
+     *
+     * Three bursts, because two is the trough of a single-burst oscillation and
+     * leaves nothing for the guest's own jitter, which the same trace shows is
+     * substantial: it produces in gulps of ~960, not evenly. On this device that
+     * is 2604 frames, 54 ms -- more latency than the guest asked for, and the
+     * trade WASAPI explicitly allows: `IAudioClient::GetBufferSize` returns what
+     * the driver chose and a client is required to ask rather than assume.
+     *
+     * Not applied to EXCLUSIVE mode, where the client owns the timing contract
+     * and a driver rounding its buffer up would be breaking a promise rather
+     * than keeping one. */
+    if(params->share != AUDCLNT_SHAREMODE_EXCLUSIVE && burst > 0){
+        UINT32 floor_frames = 3 * (UINT32)burst;
+
+        /* **Stated in bursts, so it costs nothing when the burst is small.**
+         * That is the point of expressing it this way rather than in
+         * milliseconds: on the MMAP path a burst is ~192 frames and the floor
+         * works out at 576 -- well under the 1440 any guest already asks for,
+         * so it never fires and the guest keeps exactly the latency it chose.
+         * It only bites on the legacy mixer's 868-frame burst, where a guest
+         * that stays under one gulp cannot be fed at all. Fix the burst and
+         * this quietly stops applying. */
+        if(stream->bufsize_frames < floor_frames){
+            TRACE("raising the client buffer from %u to %u frames (burst %d)\n",
+                  stream->bufsize_frames, floor_frames, burst);
+            stream->bufsize_frames = floor_frames;
+        }
+    }
+
+    /* The timer thread tops the device up once per period, so the device buffer
+     * must hold several periods or the low-latency default (a couple of bursts,
+     * single-digit milliseconds) underruns between ticks.
+     *
+     * It must also never be bigger than the client's own buffer, and that is
+     * the half that took three attempts to see. AudioFlinger will not start a
+     * track until its queue reaches the buffer size, and the driver can never
+     * queue more frames than the client has handed it -- at most
+     * bufsize_frames, the whole mmdevapi buffer. Size the device buffer above
+     * that and the threshold is unreachable by construction: the track sits in
+     * STARTED with frames waiting and never consumes one.
+     *
+     * Metro is exactly this case and is why the check exists. Measured from a
+     * session log on 2026-08-11: burst 868, capacity 1736, so the old code
+     * asked for 4*480+868 = 2788 and got the capacity, 1736. The game's buffer
+     * is 30 ms -- 1440 frames, three periods, all it ever has. One write of
+     * 1440 went in, and then 2072 consecutive passes read back "held: 1440,
+     * in_oss: 1440" with the queue frozen, because 1440 is less than 1736 and
+     * always would be. A waveOut tone asks for a much longer buffer, sails past
+     * the threshold and plays, which is why fixing this driver against
+     * tools/audio/tonewin.c left the game as silent as it started.
+     *
+     * Ordered after bufsize_frames for that reason; it used to run before it.
+     * `burst` and `capacity` are read above now, because the floor applied to
+     * bufsize_frames needs the burst too. */
+    size_device_buffer(stream);
+
+    /* AAudio floors the buffer size at one burst, so a client whose entire
+     * buffer is shorter than a burst cannot reach the threshold however this is
+     * sized. Nothing here can fix that -- it needs frames the client has not
+     * written -- but it is worth saying out loud rather than going quiet again. */
+    if(stream->bufsize_frames < (UINT32)AAudioStream_getBufferSizeInFrames(stream->aas))
+        WARN("client buffer %u frames is under the device minimum %d; the track "
+             "may never reach its start threshold\n", stream->bufsize_frames,
+             AAudioStream_getBufferSizeInFrames(stream->aas));
+
+    size = stream->bufsize_frames * params->fmt->nBlockAlign;
+    if(NtAllocateVirtualMemory(GetCurrentProcess(), (void **)&stream->local_buffer, zero_bits,
+                               &size, MEM_COMMIT, PAGE_READWRITE)){
+        params->result = E_OUTOFMEMORY;
+        goto exit;
+    }
+
+    stream->share = params->share;
+    stream->flags = params->flags;
+
+exit:
+    if(FAILED(params->result)){
+        if(stream->aas) AAudioStream_close(stream->aas);
+        if(stream->local_buffer){
+            size = 0;
+            NtFreeVirtualMemory(GetCurrentProcess(), (void **)&stream->local_buffer, &size, MEM_RELEASE);
+        }
+        pthread_mutex_destroy(&stream->lock);
+        free(stream->fmt);
+        free(stream);
+    }else{
+        *params->channel_count = params->fmt->nChannels;
+        *params->stream = (stream_handle)(UINT_PTR)stream;
+    }
+
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS oss_release_stream(void *args)
+{
+    struct release_stream_params *params = args;
+    struct oss_stream *stream = handle_get_stream(params->stream);
+    SIZE_T size;
+
+    if(stream->timer_thread){
+        stream->please_quit = TRUE;
+        NtWaitForSingleObject(stream->timer_thread, FALSE, NULL);
+        NtClose(stream->timer_thread);
+    }
+
+    if(stream->aas){
+        AAudioStream_requestStop(stream->aas);
+        AAudioStream_close(stream->aas);
+    }
+    if(stream->local_buffer){
+        size = 0;
+        NtFreeVirtualMemory(GetCurrentProcess(), (void **)&stream->local_buffer, &size, MEM_RELEASE);
+    }
+    if(stream->tmp_buffer){
+        size = 0;
+        NtFreeVirtualMemory(GetCurrentProcess(), (void **)&stream->tmp_buffer, &size, MEM_RELEASE);
+    }
+    if(stream->conv_buffer){
+        size = 0;
+        NtFreeVirtualMemory(GetCurrentProcess(), (void **)&stream->conv_buffer, &size, MEM_RELEASE);
+    }
+    free(stream->fmt);
+    pthread_mutex_destroy(&stream->lock);
+    free(stream);
+
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+static void silence_buffer(struct oss_stream *stream, BYTE *buffer, UINT32 frames)
+{
+    memset(buffer, 0, frames * stream->fmt->nBlockAlign);
+}
+
+/**
+ * The guest's float frames as int16, in a buffer AAudio can take.
+ *
+ * Returns NULL when the scratch buffer cannot be grown, and the caller then
+ * writes nothing this pass rather than writing the wrong bytes -- a silent gap
+ * is recoverable and a misread buffer is a noise burst at full scale.
+ *
+ * Saturating rather than wrapping, because a guest is entitled to hand over
+ * samples slightly outside -1..1 and the wrap of an overflow is a click at full
+ * amplitude where the clamp is a moment of distortion nobody hears.
+ */
+static const BYTE *convert_to_i16_frames(struct oss_stream *stream, const BYTE *src, UINT32 frames)
+{
+    const float *in = (const float *)src;
+    UINT32 samples = frames * stream->fmt->nChannels;
+    INT16 *out;
+    UINT32 i;
+
+    if(stream->conv_buffer_frames < frames){
+        SIZE_T size = frames * stream->fmt->nChannels * sizeof(INT16);
+        void *buffer = NULL;
+
+        if(stream->conv_buffer){
+            SIZE_T old = 0;
+            NtFreeVirtualMemory(GetCurrentProcess(), (void **)&stream->conv_buffer, &old, MEM_RELEASE);
+            stream->conv_buffer = NULL;
+            stream->conv_buffer_frames = 0;
+        }
+        if(NtAllocateVirtualMemory(GetCurrentProcess(), &buffer, 0, &size,
+                                   MEM_COMMIT, PAGE_READWRITE)){
+            WARN("could not grow the conversion buffer to %u frames\n", frames);
+            return NULL;
+        }
+        stream->conv_buffer = buffer;
+        stream->conv_buffer_frames = frames;
+    }
+
+    out = (INT16 *)stream->conv_buffer;
+    for(i = 0; i < samples; i++){
+        float v = in[i] * 32768.0f;
+
+        if(v > 32767.0f) v = 32767.0f;
+        else if(v < -32768.0f) v = -32768.0f;
+        out[i] = (INT16)v;
+    }
+
+    return stream->conv_buffer;
+}
+
+/* Frames handed to AAudio and not yet played. The difference of the two
+ * monotonic counters is what SNDCTL_DSP_GETOSPACE used to report as the
+ * filled part of the device buffer. */
+/* AAudio's request* calls are asynchronous. They return before the stream has
+ * reached the state they asked for, and anything that depends on the new state
+ * has to wait for it -- which this driver did not do, and every audible symptom
+ * came from that. Measured on the device 2026-08-10 with winecfg's Test Sound:
+ * 1323 frames were handed to a stream that had not finished STARTING, so the
+ * zero-timeout write dropped them; oss_get_position then returned 0 about 430
+ * times while the client waited for a position that could never move; and the
+ * give-up path called requestFlush() straight after requestPause(), which
+ * returned AAUDIO_ERROR_INVALID_STATE because the stream was still PAUSING.
+ * The cycle repeated five times and the test was silent.
+ *
+ * Bounded at ~200 ms because this runs under oss_lock, and a transition that
+ * has not happened in 200 ms is not going to. Returns the state actually
+ * reached, so a caller can decline a request that would be illegal from it. */
+static aaudio_stream_state_t aaudio_await(AAudioStream *aas,
+                                          aaudio_stream_state_t from,
+                                          aaudio_stream_state_t want)
+{
+    aaudio_stream_state_t state = from;
+    aaudio_result_t res;
+    int spins;
+
+    for(spins = 0; spins < 20 && state != want; spins++){
+        res = AAudioStream_waitForStateChange(aas, state, &state, 10 * 1000000LL);
+        if(res != AAUDIO_OK && res != AAUDIO_ERROR_TIMEOUT){
+            WARN("waitForStateChange failed: %d (%s)\n", res,
+                 AAudio_convertResultToText(res));
+            return AAudioStream_getState(aas);
+        }
+    }
+
+    if(state != want)
+        WARN("stream stayed in %s, wanted %s\n",
+             AAudio_convertStreamStateToText(state),
+             AAudio_convertStreamStateToText(want));
+    return state;
+}
+
+static UINT32 aaudio_queued_frames(struct oss_stream *stream)
+{
+    int64_t queued = AAudioStream_getFramesWritten(stream->aas)
+                   - AAudioStream_getFramesRead(stream->aas);
+    if(queued < 0)
+        queued = 0;
+    return queued;
+}
+
+/**
+ * Build a fresh stream after Android disconnected the old one.
+ *
+ * **The failure this exists for, measured 2026-08-11.** A 42-minute session lost
+ * audio partway through and never got it back: 47,834 consecutive
+ * `AAUDIO_ERROR_DISCONNECTED` writes, `in_oss: 0` with `held: 2200` -- the guest
+ * still producing, the device taking nothing -- until the game was restarted,
+ * which fixed it because a new process opens a new stream. It did not reproduce
+ * because the trigger is not the game: a route change disconnects the stream,
+ * and connecting a Bluetooth device is enough to cause one.
+ *
+ * AAudio is explicit that a disconnected stream is dead. Every subsequent write
+ * returns -899 forever; the only recovery is to close it and open another. This
+ * driver had no such path and simply logged the warning ten times a second.
+ *
+ * Everything about the guest's side survives: `local_buffer`, `bufsize_frames`,
+ * `held_frames` and `lcl_offs_frames` describe frames the guest wrote, which the
+ * disconnect did not touch. Only `in_oss_frames` must be cleared -- it counts
+ * frames handed to a device that no longer exists, and the new stream has taken
+ * nothing. Leaving it set would make `oss_write_data` believe the device already
+ * held two thousand frames it had never seen.
+ *
+ * Returns FALSE when the reopen failed, and the caller backs off rather than
+ * asking again in ten milliseconds: `openStream` is not cheap, and a device
+ * genuinely gone should cost one attempt a second, not a hundred.
+ */
+static BOOL reopen_aaudio_stream(struct oss_stream *stream)
+{
+    AAudioStream *fresh = NULL;
+    BOOL convert = FALSE;
+
+    if(stream->aas){
+        AAudioStream_close(stream->aas);
+        stream->aas = NULL;
+    }
+
+    if(FAILED(open_aaudio_stream(stream->flow, stream->fmt, &fresh, &convert)) || !fresh){
+        WARN("could not reopen the audio stream after a disconnect\n");
+        return FALSE;
+    }
+
+    stream->aas = fresh;
+    stream->convert_to_i16 = convert;
+    stream->in_oss_frames = 0;
+    stream->last_xruns = 0;
+    size_device_buffer(stream);
+
+    if(stream->playing){
+        aaudio_result_t res = AAudioStream_requestStart(stream->aas);
+
+        if(res != AAUDIO_OK){
+            WARN("the reopened stream would not start: %s\n", AAudio_convertResultToText(res));
+            return FALSE;
+        }
+        aaudio_await(stream->aas, AAUDIO_STREAM_STATE_STARTING, AAUDIO_STREAM_STATE_STARTED);
+    }
+
+    ERR("aaudio: the stream was disconnected and has been rebuilt\n");
+    return TRUE;
+}
+
+/**
+ * One disconnected write, turned into at most one reopen attempt a second.
+ *
+ * The backoff is the whole of the policy. A route change is momentary and the
+ * first attempt almost always takes; a device that is genuinely gone -- the last
+ * output removed, the HAL restarting -- would otherwise have this calling
+ * `openStream` a hundred times a second on the timer thread, which is a worse
+ * failure than the silence it is trying to end.
+ */
+static void handle_disconnect(struct oss_stream *stream)
+{
+    if(stream->reopen_backoff){
+        stream->reopen_backoff--;
+        return;
+    }
+    if(!reopen_aaudio_stream(stream))
+        stream->reopen_backoff = DISCONNECT_RETRY_PASSES;
+}
+
+static void oss_write_data(struct oss_stream *stream)
+{
+    UINT32 written_frames, in_oss_frames, write_limit, max_period, write_offs_frames, new_frames;
+    UINT32 fill_target;
+    SIZE_T to_write_frames, advanced;
+    aaudio_result_t written;
+    int32_t buffer_frames;
+    BYTE *buf;
+
+    in_oss_frames = aaudio_queued_frames(stream);
+
+    if(in_oss_frames > stream->in_oss_frames){
+        TRACE("Capping reported frames from %u to %u\n",
+                in_oss_frames, stream->in_oss_frames);
+        in_oss_frames = stream->in_oss_frames;
+    }
+
+    max_period = stream->period_frames;
+
+    /* How full to keep the device. Upstream tops up to three periods and that
+     * is enough for OSS, which starts playing whatever you give it. AudioFlinger
+     * does not: it holds the track inactive until the queue reaches the stream's
+     * buffer size (Track::isReady against mStartThresholdInFrames), so a target
+     * below that size is a queue that is never once long enough to start.
+     *
+     * Measured on the device 2026-08-11 with tools/audio/aaudiotone.c --stall,
+     * which writes a fixed number of frames and then only watches. At a buffer
+     * size of 3472, stopping at 1440 frames — three 10 ms periods, exactly what
+     * upstream's target works out to here — left framesRead at 0 for two full
+     * seconds with the stream reporting STARTED. Writing one chunk past 3472 had
+     * it draining before the last write returned. Nothing between those two runs
+     * differed but the number of frames queued.
+     *
+     * That is the whole of the "guest audio is silent" bug, and it hid for two
+     * sessions because falling short is silent: with the queue stuck at 1440 the
+     * loop below computes a write_limit of zero and returns without a trace, so
+     * a timer thread doing its job once every 10 ms looked exactly like a timer
+     * thread that had died after one pass.
+     *
+     * Read fresh each pass rather than cached at create time: AAudio is entitled
+     * to move the buffer size, and a target that has drifted below it brings the
+     * silence straight back. */
+    fill_target = max_period * 3;
+    buffer_frames = AAudioStream_getBufferSizeInFrames(stream->aas);
+    if(buffer_frames > 0 && (UINT32)buffer_frames > fill_target)
+        fill_target = buffer_frames;
+
+    write_limit = 0;
+    while(write_limit + in_oss_frames < fill_target)
+        write_limit += max_period;
+    if(write_limit == 0){
+        /* The device is as full as we intend to keep it. Traced because this is
+         * the one path out of here that writes nothing and says nothing, and
+         * reading its silence as a dead thread is what cost the two sessions
+         * above. */
+        TRACE("device full: %u of %u frames queued, nothing to add\n",
+                in_oss_frames, fill_target);
+        return;
+    }
+
+    /*        vvvvvv - in_oss_frames
+     * [--xxxxxxxxxx]
+     *       [xxxxxxxxxx--]
+     *        ^^^^^^^^^^ - held_frames
+     *        ^ - lcl_offs_frames
+     */
+    advanced = stream->in_oss_frames - in_oss_frames;
+    if(advanced > stream->held_frames)
+        advanced = stream->held_frames;
+    stream->lcl_offs_frames += advanced;
+    stream->lcl_offs_frames %= stream->bufsize_frames;
+    stream->held_frames -= advanced;
+    stream->in_oss_frames = in_oss_frames;
+    TRACE("advanced by %lu, lcl_offs: %u, held: %u, in_oss: %u\n",
+            advanced, stream->lcl_offs_frames, stream->held_frames, stream->in_oss_frames);
+
+
+    if(stream->held_frames == stream->in_oss_frames)
+        return;
+
+    write_offs_frames = (stream->lcl_offs_frames + stream->in_oss_frames) % stream->bufsize_frames;
+    new_frames = stream->held_frames - stream->in_oss_frames;
+
+    if(write_offs_frames + new_frames > stream->bufsize_frames)
+        to_write_frames = stream->bufsize_frames - write_offs_frames;
+    else
+        to_write_frames = new_frames;
+
+    to_write_frames = min(to_write_frames, write_limit);
+    TRACE("going to write %lu frames from %u (%lu of %u)\n", to_write_frames,
+            write_offs_frames, to_write_frames + write_offs_frames,
+            stream->bufsize_frames);
+
+    buf = stream->local_buffer + write_offs_frames * stream->fmt->nBlockAlign;
+
+    if(stream->mute)
+        silence_buffer(stream, buf, to_write_frames);
+
+    if(stream->convert_to_i16 && !(buf = (BYTE *)convert_to_i16_frames(stream, buf, to_write_frames)))
+        return;
+
+    written = AAudioStream_write(stream->aas, buf, to_write_frames, 0);
+    if(written < 0){
+        /* A disconnect is recoverable and nothing else here is: an argument
+         * error or an out-of-memory will still be true next pass, and only the
+         * dead-stream case is cured by building another one. */
+        if(written == AAUDIO_ERROR_DISCONNECTED)
+            handle_disconnect(stream);
+        else
+            WARN("write failed: %d (%s)\n", written, AAudio_convertResultToText(written));
+        return;
+    }
+    written_frames = written;
+    TRACE("wrote %d of %lu frames, state %s, queued %u\n", written, to_write_frames,
+          AAudio_convertStreamStateToText(AAudioStream_getState(stream->aas)),
+          aaudio_queued_frames(stream));
+
+    stream->in_oss_frames += written_frames;
+
+    /* **Grow the device buffer when, and only when, it actually runs dry.**
+     *
+     * This was a one-shot jump to two bursts the moment the track started. That
+     * fixed nothing measurable here -- the binding constraint is the guest's own
+     * ring, see the floor in oss_create_stream -- and it charged every stream on
+     * every device a burst of latency for a cushion most of them never need.
+     *
+     * AAudio counts its own underruns, so ask rather than guess: grow by one
+     * burst each time the count moves, up to the capacity, and never shrink.
+     * That is the sizing loop Android documents, and it converges on the
+     * smallest buffer this device and this guest actually get away with.
+     *
+     * Never shrinking is deliberate. A buffer that grew on a burst of xruns and
+     * shrank when they stopped would oscillate around the threshold, and the
+     * audible cost of being one burst too large is nothing while the audible
+     * cost of being one burst too small is the buzz this whole patch is about.
+     *
+     * Only after the device has taken frames: before that, the start threshold
+     * is still the constraint and raising the buffer would push it out of reach.
+     * `fill_target` reads the buffer size fresh each pass, so the top-up above
+     * follows this up without being told separately. */
+    if(AAudioStream_getFramesRead(stream->aas) > 0){
+        int32_t xruns = AAudioStream_getXRunCount(stream->aas);
+
+        if(xruns > stream->last_xruns){
+            int32_t size = AAudioStream_getBufferSizeInFrames(stream->aas);
+            int32_t capacity = AAudioStream_getBufferCapacityInFrames(stream->aas);
+            int32_t burst = AAudioStream_getFramesPerBurst(stream->aas);
+            int32_t want = size + (burst > 0 ? burst : (int32_t)stream->period_frames);
+
+            if(capacity > 0 && want > capacity)
+                want = capacity;
+            if(want > size){
+                AAudioStream_setBufferSizeInFrames(stream->aas, want);
+                TRACE("%d underruns: buffer %d -> %d frames (burst %d, capacity %d)\n",
+                      xruns, size, AAudioStream_getBufferSizeInFrames(stream->aas),
+                      burst, capacity);
+            }
+            stream->last_xruns = xruns;
+        }
+    }
+
+    if(written_frames < to_write_frames){
+        /* AAudio buffer probably full */
+        return;
+    }
+
+    if(new_frames > written_frames && written_frames < write_limit){
+        /* wrapped and have some data back at the start to write */
+
+        to_write_frames = min(write_limit - written_frames, new_frames - written_frames);
+
+        if(stream->mute)
+            silence_buffer(stream, stream->local_buffer, to_write_frames);
+
+        TRACE("wrapping to write %lu frames from beginning\n", to_write_frames);
+
+        buf = stream->local_buffer;
+        if(stream->convert_to_i16 && !(buf = (BYTE *)convert_to_i16_frames(stream, buf, to_write_frames)))
+            return;
+
+        written = AAudioStream_write(stream->aas, buf, to_write_frames, 0);
+        if(written < 0){
+            if(written == AAUDIO_ERROR_DISCONNECTED)
+                handle_disconnect(stream);
+            else
+                WARN("write failed: %d (%s)\n", written, AAudio_convertResultToText(written));
+            return;
+        }
+        stream->in_oss_frames += written;
+    }
+}
+
+static void oss_read_data(struct oss_stream *stream)
+{
+    UINT64 pos, readable_frames;
+    aaudio_result_t nread;
+
+    pos = (stream->held_frames + stream->lcl_offs_frames) % stream->bufsize_frames;
+    readable_frames = stream->bufsize_frames - pos;
+
+    nread = AAudioStream_read(stream->aas,
+            stream->local_buffer + pos * stream->fmt->nBlockAlign, readable_frames, 0);
+    if(nread < 0){
+        WARN("read failed: %d (%s)\n", nread, AAudio_convertResultToText(nread));
+        return;
+    }
+
+    stream->held_frames += nread;
+
+    if(stream->held_frames > stream->bufsize_frames){
+        WARN("Overflow of unread data\n");
+        stream->lcl_offs_frames += stream->held_frames;
+        stream->lcl_offs_frames %= stream->bufsize_frames;
+        stream->held_frames = stream->bufsize_frames;
+    }
+}
+
+static void oss_timer_loop(void *args)
+{
+    struct oss_stream *stream = args;
+    LARGE_INTEGER delay, now, next;
+    int adjust;
+
+    oss_lock(stream);
+
+    delay.QuadPart = -stream->period;
+    NtQueryPerformanceCounter(&now, NULL);
+    next.QuadPart = now.QuadPart + stream->period;
+
+    /* This loop is the only caller of oss_write_data, so if it ever stops
+     * iterating the guest goes silent with nothing else in the log to say so.
+     * One line at each end costs nothing per stream and tells a future reader
+     * which half of the driver to suspect. */
+    TRACE("timer loop entered, period %d hns\n", (int)stream->period);
+
+    while(!stream->please_quit){
+        if(stream->playing){
+            if(stream->flow == eRender && stream->held_frames)
+                oss_write_data(stream);
+            else if(stream->flow == eCapture)
+                oss_read_data(stream);
+        }
+        if(stream->event)
+            NtSetEvent(stream->event, NULL);
+        oss_unlock(stream);
+
+        NtDelayExecution(FALSE, &delay);
+
+        oss_lock(stream);
+        NtQueryPerformanceCounter(&now, NULL);
+        adjust = next.QuadPart - now.QuadPart;
+        if(adjust > stream->period / 2)
+            adjust = stream->period / 2;
+        else if(adjust < -stream->period / 2)
+            adjust = -stream->period / 2;
+        delay.QuadPart = -(stream->period + adjust);
+        next.QuadPart += stream->period;
+    }
+
+    TRACE("timer loop leaving: quit=%d playing=%d held=%u\n",
+          stream->please_quit, stream->playing, stream->held_frames);
+    oss_unlock(stream);
+}
+
+static NTSTATUS oss_start(void *args)
+{
+    struct start_params *params = args;
+    struct oss_stream *stream = handle_get_stream(params->stream);
+    static const WCHAR name[] = {'a','u','d','i','o','_','c','l','i','e','n','t','_','t','i','m','e','r',0};
+    aaudio_result_t res;
+
+    oss_lock(stream);
+
+    if((stream->flags & AUDCLNT_STREAMFLAGS_EVENTCALLBACK) && !stream->event)
+        return oss_unlock_result(stream, &params->result, AUDCLNT_E_EVENTHANDLE_NOT_SET);
+
+    if(stream->playing)
+        return oss_unlock_result(stream, &params->result, AUDCLNT_E_NOT_STOPPED);
+
+    if((res = AAudioStream_requestStart(stream->aas)) != AAUDIO_OK)
+        WARN("requestStart failed: %d (%s)\n", res, AAudio_convertResultToText(res));
+    else
+        aaudio_await(stream->aas, AAUDIO_STREAM_STATE_STARTING,
+                     AAUDIO_STREAM_STATE_STARTED);
+
+    stream->playing = TRUE;
+    if (!stream->timer_thread) create_unix_thread( &stream->timer_thread, name, oss_timer_loop, stream );
+
+    return oss_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS oss_stop(void *args)
+{
+    struct stop_params *params = args;
+    struct oss_stream *stream = handle_get_stream(params->stream);
+    aaudio_result_t res;
+
+    oss_lock(stream);
+
+    if(!stream->playing)
+        return oss_unlock_result(stream, &params->result, S_FALSE);
+
+    /* Pause rather than stop: Stop() on an audio client freezes the clock,
+     * it does not flush. For capture there is no pause, stop is it. */
+    if(stream->flow == eRender){
+        res = AAudioStream_requestPause(stream->aas);
+        if(res == AAUDIO_OK)
+            aaudio_await(stream->aas, AAUDIO_STREAM_STATE_PAUSING,
+                         AAUDIO_STREAM_STATE_PAUSED);
+    }else{
+        res = AAudioStream_requestStop(stream->aas);
+        if(res == AAUDIO_OK)
+            aaudio_await(stream->aas, AAUDIO_STREAM_STATE_STOPPING,
+                         AAUDIO_STREAM_STATE_STOPPED);
+    }
+    if(res != AAUDIO_OK)
+        WARN("pause/stop failed: %d (%s)\n", res, AAudio_convertResultToText(res));
+
+    stream->playing = FALSE;
+    stream->in_oss_frames = 0;
+
+    return oss_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS oss_reset(void *args)
+{
+    struct reset_params *params = args;
+    struct oss_stream *stream = handle_get_stream(params->stream);
+    aaudio_result_t res;
+
+    oss_lock(stream);
+
+    if(stream->playing)
+        return oss_unlock_result(stream, &params->result, AUDCLNT_E_NOT_STOPPED);
+
+    if(stream->getbuf_last)
+        return oss_unlock_result(stream, &params->result, AUDCLNT_E_BUFFER_OPERATION_PENDING);
+
+    if(stream->flow == eRender){
+        /* Drop what the device still holds; the paused stream would
+         * otherwise play stale audio when restarted. */
+        /* Only from PAUSED or STOPPED -- AAudio refuses a flush from any
+         * other state, and asking anyway is what filled the log with
+         * AAUDIO_ERROR_INVALID_STATE. A stream that never started is in OPEN
+         * and has nothing to drop. */
+        aaudio_stream_state_t fstate = AAudioStream_getState(stream->aas);
+
+        if(fstate == AAUDIO_STREAM_STATE_PAUSED ||
+           fstate == AAUDIO_STREAM_STATE_STOPPED){
+            if((res = AAudioStream_requestFlush(stream->aas)) != AAUDIO_OK)
+                WARN("requestFlush failed: %d (%s)\n", res, AAudio_convertResultToText(res));
+            else
+                aaudio_await(stream->aas, AAUDIO_STREAM_STATE_FLUSHING,
+                             AAUDIO_STREAM_STATE_FLUSHED);
+        }else
+            TRACE("no flush from %s\n", AAudio_convertStreamStateToText(fstate));
+        stream->written_frames = 0;
+        stream->last_pos_frames = 0;
+    }else{
+        stream->written_frames += stream->held_frames;
+    }
+    stream->held_frames = 0;
+    stream->lcl_offs_frames = 0;
+    stream->in_oss_frames = 0;
+
+    return oss_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS oss_get_render_buffer(void *args)
+{
+    struct get_render_buffer_params *params = args;
+    struct oss_stream *stream = handle_get_stream(params->stream);
+    UINT32 write_pos, frames = params->frames;
+    BYTE **data = params->data;
+    SIZE_T size;
+
+    oss_lock(stream);
+
+    if(stream->getbuf_last)
+        return oss_unlock_result(stream, &params->result, AUDCLNT_E_OUT_OF_ORDER);
+
+    if(!frames)
+        return oss_unlock_result(stream, &params->result, S_OK);
+
+    if(stream->held_frames + frames > stream->bufsize_frames)
+        return oss_unlock_result(stream, &params->result, AUDCLNT_E_BUFFER_TOO_LARGE);
+
+    write_pos =
+        (stream->lcl_offs_frames + stream->held_frames) % stream->bufsize_frames;
+    if(write_pos + frames > stream->bufsize_frames){
+        if(stream->tmp_buffer_frames < frames){
+            if(stream->tmp_buffer){
+                size = 0;
+                NtFreeVirtualMemory(GetCurrentProcess(), (void **)&stream->tmp_buffer, &size, MEM_RELEASE);
+                stream->tmp_buffer = NULL;
+            }
+            size = frames * stream->fmt->nBlockAlign;
+            if(NtAllocateVirtualMemory(GetCurrentProcess(), (void **)&stream->tmp_buffer, zero_bits,
+                                       &size, MEM_COMMIT, PAGE_READWRITE)){
+                stream->tmp_buffer_frames = 0;
+                return oss_unlock_result(stream, &params->result, E_OUTOFMEMORY);
+            }
+            stream->tmp_buffer_frames = frames;
+        }
+        *data = stream->tmp_buffer;
+        stream->getbuf_last = -frames;
+    }else{
+        *data = stream->local_buffer + write_pos * stream->fmt->nBlockAlign;
+        stream->getbuf_last = frames;
+    }
+
+    silence_buffer(stream, *data, frames);
+
+    return oss_unlock_result(stream, &params->result, S_OK);
+}
+
+static void oss_wrap_buffer(struct oss_stream *stream, BYTE *buffer, UINT32 written_frames)
+{
+    UINT32 write_offs_frames =
+        (stream->lcl_offs_frames + stream->held_frames) % stream->bufsize_frames;
+    UINT32 write_offs_bytes = write_offs_frames * stream->fmt->nBlockAlign;
+    UINT32 chunk_frames = stream->bufsize_frames - write_offs_frames;
+    UINT32 chunk_bytes = chunk_frames * stream->fmt->nBlockAlign;
+    UINT32 written_bytes = written_frames * stream->fmt->nBlockAlign;
+
+    if(written_bytes <= chunk_bytes){
+        memcpy(stream->local_buffer + write_offs_bytes, buffer, written_bytes);
+    }else{
+        memcpy(stream->local_buffer + write_offs_bytes, buffer, chunk_bytes);
+        memcpy(stream->local_buffer, buffer + chunk_bytes,
+                written_bytes - chunk_bytes);
+    }
+}
+
+static NTSTATUS oss_release_render_buffer(void *args)
+{
+    struct release_render_buffer_params *params = args;
+    struct oss_stream *stream = handle_get_stream(params->stream);
+    UINT32 written_frames = params->written_frames;
+    UINT flags = params->flags;
+    BYTE *buffer;
+
+    oss_lock(stream);
+
+    if(!written_frames){
+        stream->getbuf_last = 0;
+        return oss_unlock_result(stream, &params->result, S_OK);
+    }
+
+    if(!stream->getbuf_last)
+        return oss_unlock_result(stream, &params->result, AUDCLNT_E_OUT_OF_ORDER);
+
+    if(written_frames > (stream->getbuf_last >= 0 ? stream->getbuf_last : -stream->getbuf_last))
+        return oss_unlock_result(stream, &params->result, AUDCLNT_E_INVALID_SIZE);
+
+    if(stream->getbuf_last >= 0)
+        buffer = stream->local_buffer + stream->fmt->nBlockAlign *
+          ((stream->lcl_offs_frames + stream->held_frames) % stream->bufsize_frames);
+    else
+        buffer = stream->tmp_buffer;
+
+    if(flags & AUDCLNT_BUFFERFLAGS_SILENT)
+        silence_buffer(stream, buffer, written_frames);
+
+    if(stream->getbuf_last < 0)
+        oss_wrap_buffer(stream, buffer, written_frames);
+
+    stream->held_frames += written_frames;
+    stream->written_frames += written_frames;
+    stream->getbuf_last = 0;
+
+    return oss_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS oss_get_capture_buffer(void *args)
+{
+    struct get_capture_buffer_params *params = args;
+    struct oss_stream *stream = handle_get_stream(params->stream);
+    UINT64 *devpos = params->devpos, *qpcpos = params->qpcpos;
+    UINT32 *frames = params->frames;
+    UINT *flags = params->flags;
+    BYTE **data = params->data;
+    SIZE_T size;
+
+    oss_lock(stream);
+
+    if(stream->getbuf_last)
+        return oss_unlock_result(stream, &params->result, AUDCLNT_E_OUT_OF_ORDER);
+
+    if(stream->held_frames < stream->period_frames){
+        *frames = 0;
+        return oss_unlock_result(stream, &params->result, AUDCLNT_S_BUFFER_EMPTY);
+    }
+
+    *flags = 0;
+
+    *frames = stream->period_frames;
+
+    if(stream->lcl_offs_frames + *frames > stream->bufsize_frames){
+        UINT32 chunk_bytes, offs_bytes, frames_bytes;
+        if(stream->tmp_buffer_frames < *frames){
+            if(stream->tmp_buffer){
+                size = 0;
+                NtFreeVirtualMemory(GetCurrentProcess(), (void **)&stream->tmp_buffer, &size, MEM_RELEASE);
+                stream->tmp_buffer = NULL;
+            }
+            size = *frames * stream->fmt->nBlockAlign;
+            if(NtAllocateVirtualMemory(GetCurrentProcess(), (void **)&stream->tmp_buffer, zero_bits,
+                                       &size, MEM_COMMIT, PAGE_READWRITE)){
+                stream->tmp_buffer_frames = 0;
+                return oss_unlock_result(stream, &params->result, E_OUTOFMEMORY);
+            }
+            stream->tmp_buffer_frames = *frames;
+        }
+
+        *data = stream->tmp_buffer;
+        chunk_bytes = (stream->bufsize_frames - stream->lcl_offs_frames) *
+            stream->fmt->nBlockAlign;
+        offs_bytes = stream->lcl_offs_frames * stream->fmt->nBlockAlign;
+        frames_bytes = *frames * stream->fmt->nBlockAlign;
+        memcpy(stream->tmp_buffer, stream->local_buffer + offs_bytes, chunk_bytes);
+        memcpy(stream->tmp_buffer + chunk_bytes, stream->local_buffer,
+                frames_bytes - chunk_bytes);
+    }else
+        *data = stream->local_buffer +
+            stream->lcl_offs_frames * stream->fmt->nBlockAlign;
+
+    stream->getbuf_last = *frames;
+
+    if(devpos)
+       *devpos = stream->written_frames;
+    if(qpcpos){
+        LARGE_INTEGER stamp, freq;
+        NtQueryPerformanceCounter(&stamp, &freq);
+        *qpcpos = (stamp.QuadPart * (INT64)10000000) / freq.QuadPart;
+    }
+
+    return oss_unlock_result(stream, &params->result, *frames ? S_OK : AUDCLNT_S_BUFFER_EMPTY);
+}
+
+static NTSTATUS oss_release_capture_buffer(void *args)
+{
+    struct release_capture_buffer_params *params = args;
+    struct oss_stream *stream = handle_get_stream(params->stream);
+    UINT32 done = params->done;
+
+    oss_lock(stream);
+
+    if(!done){
+        stream->getbuf_last = 0;
+        return oss_unlock_result(stream, &params->result, S_OK);
+    }
+
+    if(!stream->getbuf_last)
+        return oss_unlock_result(stream, &params->result, AUDCLNT_E_OUT_OF_ORDER);
+
+    if(stream->getbuf_last != done)
+        return oss_unlock_result(stream, &params->result, AUDCLNT_E_INVALID_SIZE);
+
+    stream->written_frames += done;
+    stream->held_frames -= done;
+    stream->lcl_offs_frames += done;
+    stream->lcl_offs_frames %= stream->bufsize_frames;
+    stream->getbuf_last = 0;
+
+    return oss_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS oss_is_format_supported(void *args)
+{
+    struct is_format_supported_params *params = args;
+
+    params->result = check_format(params->share, params->fmt_in);
+
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS oss_get_mix_format(void *args)
+{
+    struct get_mix_format_params *params = args;
+    WAVEFORMATEXTENSIBLE *fmt = params->fmt;
+
+    if(params->flow != eRender && params->flow != eCapture){
+        params->result = E_UNEXPECTED;
+        return STATUS_SUCCESS;
+    }
+
+    /* 48 kHz stereo signed 16-bit: the native rate of effectively every
+     * Android device, and AAUDIO_FORMAT_PCM_I16 needs no conversion. */
+    fmt->Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
+    fmt->Format.wBitsPerSample = 16;
+    fmt->SubFormat = KSDATAFORMAT_SUBTYPE_PCM;
+    fmt->Format.nChannels = 2;
+    fmt->Format.nSamplesPerSec = 48000;
+    fmt->dwChannelMask = get_channel_mask(fmt->Format.nChannels);
+    fmt->Format.nBlockAlign = (fmt->Format.wBitsPerSample *
+            fmt->Format.nChannels) / 8;
+    fmt->Format.nAvgBytesPerSec = fmt->Format.nSamplesPerSec *
+        fmt->Format.nBlockAlign;
+    fmt->Samples.wValidBitsPerSample = fmt->Format.wBitsPerSample;
+    fmt->Format.cbSize = sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX);
+
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
