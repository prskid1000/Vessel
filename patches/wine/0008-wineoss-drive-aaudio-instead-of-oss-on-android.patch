+static NTSTATUS oss_test_connect(void *args)
+{
+    struct test_connect_params *params = args;
+    WAVEFORMATEX fmt =
+    {
+        .wFormatTag = WAVE_FORMAT_PCM,
+        .nChannels = 2,
+        .nSamplesPerSec = 48000,
+        .nAvgBytesPerSec = 48000 * 4,
+        .nBlockAlign = 4,
+        .wBitsPerSample = 16,
+    };
+    AAudioStream *probe;
+    /* The probe only asks whether a stream opens; how it is fed is not its
+     * question, so the answer is taken and dropped. */
+    BOOL probe_convert = FALSE;
+
+    if(FAILED(open_aaudio_stream(eRender, &fmt, &probe, &probe_convert))){
+        TRACE("Priority_Unavailable: could not open an AAudio output stream\n");
+        params->priority = Priority_Unavailable;
+        return STATUS_SUCCESS;
+    }
+    AAudioStream_close(probe);
+
+    TRACE("Priority_Preferred: AAudio output stream opened\n");
+    params->priority = Priority_Preferred;
+    return STATUS_SUCCESS;
+}
