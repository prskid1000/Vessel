+static NTSTATUS oss_get_endpoint_ids(void *args)
+{
+    struct get_endpoint_ids_params *params = args;
+    static const WCHAR nameW[] = {'A','n','d','r','o','i','d',' ','A','u','d','i','o',0};
+    static const char device[] = "aaudio";
+    struct endpoint *endpoint = params->endpoints;
+    unsigned int name_len = ARRAY_SIZE(nameW), device_len = sizeof(device);
+    unsigned int needed, offset;
+
+    /* One fixed render endpoint. Capture is deliberately not enumerated:
+     * the app has no RECORD_AUDIO permission, so an input stream could
+     * never open, and a microphone that is listed but always fails is
+     * worse for programs than no microphone at all. */
+    if(params->flow != eRender){
+        params->num = 0;
+        params->default_idx = 0;
+        params->result = S_OK;
+        return STATUS_SUCCESS;
+    }
+
+    offset = sizeof(*endpoint);
+    needed = offset + name_len * sizeof(WCHAR) + ((device_len + 1) & ~1);
+
+    if(needed <= params->size){
+        endpoint->name = offset;
+        memcpy((char *)params->endpoints + offset, nameW, name_len * sizeof(WCHAR));
+        offset += name_len * sizeof(WCHAR);
+        endpoint->device = offset;
+        memcpy((char *)params->endpoints + offset, device, device_len);
+    }
+
+    params->num = 1;
+    params->default_idx = 0;
+
+    if(needed > params->size){
+        params->size = needed;
+        params->result = HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+    } else
+        params->result = S_OK;
+
+    return STATUS_SUCCESS;
+}
