+/**
+ * Validate and announce a stream that opened, whichever path it came from.
+ *
+ * The rate check is not paranoia: the legacy path honours a requested rate by
+ * resampling, so a mismatch here means something is deeply wrong -- and a stream
+ * running at a different rate than the frames fed to it is a pitch shift, which
+ * is worse than no audio at all.
+ */
+/**
+ * Size the device buffer against the client's ring. Create time, and reopen.
+ *
+ * Extracted so the two agree by construction: a stream rebuilt after a
+ * disconnect that kept AAudio's default buffer would run dry from its first
+ * pass, and that failure would read as a new bug rather than a missing line.
+ */
+static void size_device_buffer(struct oss_stream *stream)
+{
+    int32_t burst = AAudioStream_getFramesPerBurst(stream->aas);
+    int32_t capacity = AAudioStream_getBufferCapacityInFrames(stream->aas);
+    UINT32 want = 4 * stream->period_frames + (burst > 0 ? (UINT32)burst : 0);
+
+    if(capacity > 0 && want > (UINT32)capacity)
+        want = (UINT32)capacity;
+    if(want > stream->bufsize_frames)
+        want = stream->bufsize_frames;
+    AAudioStream_setBufferSizeInFrames(stream->aas, want);
+    TRACE("burst %d, capacity %d, client buffer %u, asked for %u, buffer size set to %d\n",
+          burst, capacity, stream->bufsize_frames, want,
+          AAudioStream_getBufferSizeInFrames(stream->aas));
+}
+
+static HRESULT finish_aaudio_stream(AAudioStream *aas, const WAVEFORMATEX *fmt)
+{
+    /* The one line that says whether the latency below is going to be small.
+     * ERR so it survives a session log at its default level: a burst this
+     * driver did not expect is the first thing to look at when audio is rough,
+     * and it costs one line per stream. */
+    ERR("aaudio: %s, burst %d, capacity %d, %d Hz x%d, format %d\n",
+        AAudioStream_getSharingMode(aas) == AAUDIO_SHARING_MODE_EXCLUSIVE
+            ? "exclusive (mmap)" : "shared",
+        AAudioStream_getFramesPerBurst(aas),
+        AAudioStream_getBufferCapacityInFrames(aas),
+        AAudioStream_getSampleRate(aas),
+        AAudioStream_getChannelCount(aas),
+        AAudioStream_getFormat(aas));
+
+    if(AAudioStream_getSampleRate(aas) != (int32_t)fmt->nSamplesPerSec ||
+            AAudioStream_getChannelCount(aas) != fmt->nChannels){
+        WARN("stream opened at %d Hz x%d, wanted %u Hz x%u\n",
+                AAudioStream_getSampleRate(aas), AAudioStream_getChannelCount(aas),
+                (unsigned)fmt->nSamplesPerSec, fmt->nChannels);
+        AAudioStream_close(aas);
+        return AUDCLNT_E_UNSUPPORTED_FORMAT;
+    }
+
+    return S_OK;
+}
+
+static HRESULT open_aaudio_stream(EDataFlow flow, const WAVEFORMATEX *fmt, AAudioStream **out,
+                                  BOOL *convert_to_i16)
+{
+    AAudioStreamBuilder *builder;
+    aaudio_format_t format = get_aaudio_format(fmt);
+    aaudio_result_t res;
+
+    *out = NULL;
+
+    if(format == AAUDIO_FORMAT_INVALID)
+        return AUDCLNT_E_UNSUPPORTED_FORMAT;
+
+    if((res = AAudio_createStreamBuilder(&builder)) != AAUDIO_OK){
+        WARN("AAudio_createStreamBuilder failed: %d (%s)\n", res, AAudio_convertResultToText(res));
+        return AUDCLNT_E_SERVICE_NOT_RUNNING;
+    }
+
+    AAudioStreamBuilder_setDirection(builder, flow == eRender ? AAUDIO_DIRECTION_OUTPUT
+                                                              : AAUDIO_DIRECTION_INPUT);
+    AAudioStreamBuilder_setPerformanceMode(builder, AAUDIO_PERFORMANCE_MODE_LOW_LATENCY);
+    AAudioStreamBuilder_setSampleRate(builder, fmt->nSamplesPerSec);
+    AAudioStreamBuilder_setChannelCount(builder, fmt->nChannels);
+
+    /* **Int16 first when the guest is float, because MMAP takes nothing else.**
+     *
+     * Read off this device 2026-08-11, `/vendor/etc/audio_policy_configuration.xml`:
+     *
+     *     <mixPort name="mmap_no_irq_out" flags="... AUDIO_OUTPUT_FLAG_MMAP_NOIRQ">
+     *       <profile format="AUDIO_FORMAT_PCM_16_BIT" samplingRates="48000"
+     *                channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
+     *
+     * One profile, one format. The rate and the channel mask already matched;
+     * the format was the only thing between this driver and the low-latency
+     * path, and a float stream is refused before anything else is considered.
+     * `aaudio.mmap_policy` is 2 here, so the path is permitted -- it was the
+     * format, not the policy, and the two look identical from the failure.
+     *
+     * The conversion costs one pass over a period -- 480 frames of stereo, a
+     * few microseconds -- against a burst that drops from 868 to about 192.
+     * Everything downstream is a multiple of that burst, so this is the one
+     * change that makes latency smaller rather than trading it away.
+     */
+    if(format == AAUDIO_FORMAT_PCM_FLOAT){
+        AAudioStreamBuilder_setFormat(builder, AAUDIO_FORMAT_PCM_I16);
+        AAudioStreamBuilder_setSharingMode(builder, AAUDIO_SHARING_MODE_EXCLUSIVE);
+        if(AAudioStreamBuilder_openStream(builder, out) == AAUDIO_OK){
+            HRESULT hr;
+
+            TRACE("exclusive int16 stream for a float guest; converting on the way out\n");
+            AAudioStreamBuilder_delete(builder);
+            if(FAILED(hr = finish_aaudio_stream(*out, fmt))){
+                *out = NULL;
+                return hr;
+            }
+            *convert_to_i16 = TRUE;
+            return S_OK;
+        }
+        TRACE("no exclusive int16 stream; keeping the guest's own format\n");
+    }
+
+    AAudioStreamBuilder_setFormat(builder, format);
+
+    /* **Ask for the MMAP path first, because the burst is the whole game.**
+     *
+     * Everything about the cushion this driver has to keep is a multiple of
+     * AAudio's burst: the device takes exactly one burst per pull, so the guest
+     * must stay a burst ahead or the queue empties, and every frame of that
+     * cushion is latency the player hears.
+     *
+     * Measured 2026-08-11: this stream was getting a burst of **868 frames, 18
+     * ms**, while the device's own fast mixer on the same thread runs 144-frame
+     * periods at 3 ms (`dumpsys media.audio_flinger`). That is the legacy mixer,
+     * not the low-latency path, despite LOW_LATENCY being asked for -- and it is
+     * why the cushion had to be tens of milliseconds. A burst six times smaller
+     * makes the cushion six times smaller for free.
+     *
+     * EXCLUSIVE is what selects MMAP NOIRQ, where the guest writes into a buffer
+     * the DSP reads directly. It is refused whenever anything else holds the
+     * device, or the HAL has no MMAP support at all, so SHARED is not a fallback
+     * for an error case but the ordinary outcome on many devices -- attempted,
+     * not assumed, and the mode actually granted is logged rather than believed.
+     */
+    AAudioStreamBuilder_setSharingMode(builder, AAUDIO_SHARING_MODE_EXCLUSIVE);
+    res = AAudioStreamBuilder_openStream(builder, out);
+    if(res != AAUDIO_OK){
+        TRACE("no exclusive stream (%s); asking for a shared one\n",
+              AAudio_convertResultToText(res));
+        AAudioStreamBuilder_setSharingMode(builder, AAUDIO_SHARING_MODE_SHARED);
+        res = AAudioStreamBuilder_openStream(builder, out);
+    }
+    AAudioStreamBuilder_delete(builder);
+
+    if(res != AAUDIO_OK){
+        WARN("AAudioStreamBuilder_openStream failed: %d (%s)\n", res, AAudio_convertResultToText(res));
+        *out = NULL;
+        return AUDCLNT_E_UNSUPPORTED_FORMAT;
+    }
+
+    {
+        HRESULT hr = finish_aaudio_stream(*out, fmt);
+
+        if(FAILED(hr)) *out = NULL;
+        return hr;
+    }
+}
