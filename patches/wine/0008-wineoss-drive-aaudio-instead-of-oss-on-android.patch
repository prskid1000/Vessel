+/* Aux driver: OSS exposed the /dev/mixer channels here. Android has no
+ * mixer device, so there are no aux devices. */
+
+static NTSTATUS oss_aux_message(void *args)
+{
+    struct aux_message_params *params = args;
+
+    switch (params->msg)
+    {
+    case DRVM_INIT:
+    case DRVM_EXIT:
+    case DRVM_ENABLE:
+    case DRVM_DISABLE:
+        *params->err = 0;
+        break;
+    case AUXDM_GETNUMDEVS:
+        *params->err = 0;
+        break;
+    default:
+        *params->err = MMSYSERR_NOTENABLED;
+        break;
+    }
+
+    return STATUS_SUCCESS;
+}
