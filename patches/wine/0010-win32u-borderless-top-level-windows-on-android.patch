+/* Vessel: VESSEL_BORDERLESS=1 removes the non-client frame from every top-level
+ * window. Read once — this cannot change within a process, and the answer is
+ * needed on the window-creation path. Unset, every branch guarded by it is a
+ * no-op and Wine's framing is exactly upstream's. */
+static BOOL vessel_borderless_windows(void)
+{
+    static int cached = -1;
+
+    if (cached == -1)
+    {
+        const char *value = getenv( "VESSEL_BORDERLESS" );
+        cached = value && value[0] == '1';
+    }
+    return cached;
+}
