+/* MIT-SHM without System V shared memory.
+ *
+ * bionic exports shmget and friends but Android refuses them -- the NDK header
+ * says as much ("Not useful on Android because it's disallowed by SELinux"),
+ * and they fail at runtime rather than at link time. Wine then quietly drops
+ * to XPutImage, which is correct but copies every damaged region through the
+ * socket.
+ *
+ * A SysV shmid could not be used here even if it were allowed: it names a
+ * segment in the kernel IPC namespace, and the X server on the other end is a
+ * Java process inside the app that can only mmap a descriptor. So the app runs
+ * a tiny fd-passing service (com.winlator.sysvshm) and hands out its own ids.
+ * Three requests, native byte order, and the id that comes back is what goes
+ * into XShmAttach -- the server matches it against its own table:
+ *
+ *     SHMGET  0  u32 size   -> i32 shmid
+ *     GET_FD  1  i32 shmid  -> u8 status, descriptor via SCM_RIGHTS
+ *     DELETE  2  i32 shmid  -> nothing
+ *
+ * The server frees nothing when a client disconnects, so no connection has to
+ * be held open; one is opened per allocation and per release.
+ *
+ * Winlator solves the same problem by patching glibc to redirect shmget; on
+ * bionic there is no libc to patch, so the client half lives here instead.
+ *
+ * Inert unless WINE_SYSVSHM_SOCKET names the socket, so a build that does not
+ * set it behaves exactly as upstream.
+ */
+static BOOL vessel_shm_enabled(void)
+{
+    static int enabled = -1;
+    const char *path;
+
+    if (enabled == -1)
+    {
+        path = getenv( "WINE_SYSVSHM_SOCKET" );
+        enabled = (path && path[0]);
+        if (enabled) ERR_(winediag)( "vessel: MIT-SHM over %s\n", path );
+        else TRACE( "vessel: WINE_SYSVSHM_SOCKET is unset, MIT-SHM stays off\n" );
+    }
+    return enabled;
+}
+
+static int vessel_shm_connect(void)
+{
+    const char *path = getenv( "WINE_SYSVSHM_SOCKET" );
+    struct sockaddr_un addr;
+    int fd;
+
+    if (!path || !path[0] || strlen( path ) >= sizeof(addr.sun_path)) return -1;
+    memset( &addr, 0, sizeof(addr) );
+    addr.sun_family = AF_UNIX;
+    strcpy( addr.sun_path, path );
+    if ((fd = socket( AF_UNIX, SOCK_STREAM, 0 )) == -1) return -1;
+    if (!connect( fd, (const struct sockaddr *)&addr, sizeof(addr) )) return fd;
+    close( fd );
+    return -1;
+}
+
+static void vessel_shm_delete( int shmid )
+{
+    unsigned char req[5] = { 2 };
+    int sock;
+
+    if ((sock = vessel_shm_connect()) == -1) return;
+    memcpy( req + 1, &shmid, sizeof(shmid) );
+    if (write( sock, req, sizeof(req) ) != sizeof(req))
+        WARN( "could not release shm segment %d\n", shmid );
+    close( sock );
+}
+
+/* Returns the server's shmid and maps it, or -1. */
+static int vessel_shm_alloc( size_t size, void **addr )
+{
+    /* A char array is only byte-aligned, and the kernel writes a size_t at the
+     * head of the control message. The union is what forces the alignment
+     * cmsg(3) requires. */
+    union
+    {
+        struct cmsghdr align;
+        char buffer[CMSG_SPACE(sizeof(int))];
+    } control;
+    struct msghdr msg;
+    struct cmsghdr *cmsg;
+    struct iovec iov;
+    unsigned char req[5], status;
+    unsigned int size32 = size;
+    int sock, shmid = -1, fd = -1;
+
+    *addr = NULL;
+    if (size != (size_t)size32) return -1;  /* the request field is 32-bit */
+    if ((sock = vessel_shm_connect()) == -1) return -1;
+
+    req[0] = 0;  /* SHMGET */
+    memcpy( req + 1, &size32, sizeof(size32) );
+    if (write( sock, req, sizeof(req) ) != sizeof(req)) goto done;
+    if (read( sock, &shmid, sizeof(shmid) ) != sizeof(shmid) || shmid <= 0)
+    {
+        shmid = -1;
+        goto done;
+    }
+
+    req[0] = 1;  /* GET_FD */
+    memcpy( req + 1, &shmid, sizeof(shmid) );
+    if (write( sock, req, sizeof(req) ) != sizeof(req)) goto fail;
+
+    memset( &msg, 0, sizeof(msg) );
+    iov.iov_base = &status;
+    iov.iov_len = sizeof(status);
+    msg.msg_iov = &iov;
+    msg.msg_iovlen = 1;
+    msg.msg_control = control.buffer;
+    msg.msg_controllen = sizeof(control.buffer);
+    if (recvmsg( sock, &msg, 0 ) != sizeof(status)) goto fail;
+    if (!(cmsg = CMSG_FIRSTHDR( &msg )) || cmsg->cmsg_level != SOL_SOCKET ||
+        cmsg->cmsg_type != SCM_RIGHTS || cmsg->cmsg_len != CMSG_LEN(sizeof(fd)))
+        goto fail;
+    memcpy( &fd, CMSG_DATA( cmsg ), sizeof(fd) );
+
+    *addr = mmap( NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 );
+    close( fd );
+    if (*addr != MAP_FAILED) goto done;
+    *addr = NULL;
+
+fail:
+    vessel_shm_delete( shmid );
+    shmid = -1;
+done:
+    close( sock );
+    return shmid;
+}
+
 static XImage *create_shm_image( const XVisualInfo *vis, int width, int height, x11drv_xshm_info_t *shminfo )
 {
