+        shminfo->shmid = shmget( IPC_PRIVATE, image->bytes_per_line * height, IPC_CREAT | 0700 );
+        if (shminfo->shmid == -1) goto failed;
 
-    shminfo->shmaddr = shmat( shminfo->shmid, 0, 0 );
+        shminfo->shmaddr = shmat( shminfo->shmid, 0, 0 );
+    }
     if (shminfo->shmaddr != (char *)-1)
     {
         BOOL ok;
@@ -1626,12 +1788,36 @@ static XImage *create_shm_image( const XVisualInfo *vis, int width, int height,
         if (!X11DRV_check_error() && ok)
         {
             image->data = shminfo->shmaddr;
-            shmctl( shminfo->shmid, IPC_RMID, 0 );
+            /* A SysV segment is removed immediately so it dies with the last
+             * detach. The socket server has no such rule -- it holds the
+             * segment until DELETE, which destroy_shm_image sends. */
+            if (vessel_shm_enabled())
+            {
+                static BOOL reported;
+                if (!reported)
+                {
+                    reported = TRUE;
+                    ERR_(winediag)( "vessel: MIT-SHM is live, first segment %d of %d bytes\n",
+                                    shminfo->shmid, image->bytes_per_line * height );
+                }
+            }
+            else shmctl( shminfo->shmid, IPC_RMID, 0 );
             return image;
         }
-        shmdt( shminfo->shmaddr );
+        if (vessel_shm_enabled())
+        {
+            static BOOL reported;
+            if (!reported)
+            {
+                reported = TRUE;
+                ERR_(winediag)( "vessel: XShmAttach was refused; falling back to XPutImage\n" );
+            }
+            munmap( shminfo->shmaddr, (size_t)image->bytes_per_line * height );
+        }
+        else shmdt( shminfo->shmaddr );
     }
-    shmctl( shminfo->shmid, IPC_RMID, 0 );
+    if (vessel_shm_enabled()) vessel_shm_delete( shminfo->shmid );
+    else shmctl( shminfo->shmid, IPC_RMID, 0 );
     shminfo->shmid = -1;
 
 failed:
@@ -1644,7 +1830,14 @@ static BOOL destroy_shm_image( XImage *image, x11drv_xshm_info_t *shminfo )
     if (shminfo->shmid == -1) return FALSE;
 
     XShmDetach( gdi_display, shminfo );
-    shmdt( shminfo->shmaddr );
+    if (vessel_shm_enabled())
+    {
+        /* The size is recovered from the image rather than stored: shminfo is
+         * Xlib's XShmSegmentInfo and has nowhere to keep it. */
+        munmap( shminfo->shmaddr, (size_t)image->bytes_per_line * image->height );
+        vessel_shm_delete( shminfo->shmid );
+    }
+    else shmdt( shminfo->shmaddr );
 
     return TRUE;
 }
