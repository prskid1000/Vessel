nsiproxy: enumerate interfaces with getifaddrs on Android.

The reasoning for the fallback itself is in the code, beside it. One thing is
worth stating here because it is a property of the base rather than of the fix:

This patch also adds <errno.h>, which is not incidental. Upstream Wine includes
it in this file and Valve's proton_11.0 does not, so the fallback below -- which
reports errno in both its ERR and its WARN -- compiles on upstream and fails on
Proton with

    dlls/nsiproxy.sys/ndis.c:362: error: use of undeclared identifier 'errno'

The include is unconditional because every path that reports a failure here
needs it, and it costs nothing on a tree that already has it.

diff --git a/dlls/nsiproxy.sys/ndis.c b/dlls/nsiproxy.sys/ndis.c
index 158a39e558..67ce0fc81d 100644
--- a/dlls/nsiproxy.sys/ndis.c
+++ b/dlls/nsiproxy.sys/ndis.c
@@ -29,6 +29,11 @@
 #include <sys/socket.h>
 #include <sys/ioctl.h>
 #include <unistd.h>
+#include <errno.h>
+
+#ifdef HAVE_IFADDRS_H
+#include <ifaddrs.h>
+#endif
 
 #ifdef HAVE_NET_IF_H
 #include <net/if.h>
@@ -328,19 +333,92 @@ static struct if_entry *add_entry( UINT index, const char *name )
     return entry;
 }
 
+#ifdef HAVE_IFADDRS_H
+/* VESSEL: enumerate through getifaddrs() when if_nameindex() is refused.
+ *
+ * Android denies an untrusted app bind() on a NETLINK_ROUTE socket, and
+ * bionic's if_nameindex() binds one, so it fails with EACCES and Wine ends up
+ * with no interfaces at all. The symptom is precise and misleading: ipconfig
+ * prints nothing, GetAdaptersAddresses returns an empty list, and every program
+ * that asks "is there a network" is told there is none -- while a socket to the
+ * same host connects perfectly. Measured on a Motorola Signature running
+ * Android 16: a WinHTTP GET returned status 200 in the same session in which
+ * ipconfig printed nothing at all.
+ *
+ * getifaddrs() reaches the kernel over an *unbound* netlink socket, which is
+ * permitted, so it answers where if_nameindex() cannot. It yields one entry per
+ * address rather than one per interface; find_entry_from_index() already
+ * de-duplicates, which is why this loop needs no set of its own.
+ *
+ * Tried second rather than first, so nothing changes on a platform where
+ * if_nameindex() works.
+ */
+static unsigned int update_if_table_from_ifaddrs( void )
+{
+    struct ifaddrs *addrs, *cur;
+    unsigned int append_count = 0;
+
+    if (getifaddrs( &addrs ) < 0)
+    {
+        ERR( "getifaddrs failed, errno %d.\n", errno );
+        return 0;
+    }
+
+    for (cur = addrs; cur; cur = cur->ifa_next)
+    {
+        unsigned int index;
+
+        if (!cur->ifa_name) continue;
+        index = if_nametoindex( cur->ifa_name );
+        if (!index) continue;
+        if (!find_entry_from_index( index ) && add_entry( index, cur->ifa_name ))
+            ++append_count;
+    }
+
+    freeifaddrs( addrs );
+    return append_count;
+}
+#endif
+
 static unsigned int update_if_table( void )
 {
     struct if_nameindex *indices = if_nameindex(), *entry;
     unsigned int append_count = 0;
     struct if_entry *if_entry;
 
-    for (entry = indices; entry->if_index; entry++)
+    /* VESSEL: empty counts as failure, not just NULL. Measured on Android 16:
+     * ipconfig still printed nothing with the fallback in place, because
+     * bionic's if_nameindex() does not return NULL when the netlink bind is
+     * refused -- it returns a list whose first entry is the terminator. A NULL
+     * check alone never fired and the getifaddrs path below was dead code.
+     *
+     * Note this falls through rather than returning, so the fake ethernet
+     * adapter below is still considered on the getifaddrs path. */
+    if (!indices || !indices->if_index)
+    {
+        if (indices) if_freenameindex( indices );
+        indices = NULL;
+#ifdef HAVE_IFADDRS_H
+        {
+            static int warned;
+
+            append_count = update_if_table_from_ifaddrs();
+            if (!warned++)
+                WARN( "if_nameindex gave nothing (errno %d); getifaddrs found %u.\n",
+                      errno, append_count );
+        }
+#else
+        ERR( "if_nameindex failed, errno %d.\n", errno );
+#endif
+    }
+
+    for (entry = indices; entry && entry->if_index; entry++)
     {
         if (!find_entry_from_index( entry->if_index ) && add_entry( entry->if_index, entry->if_name ))
             ++append_count;
     }
 
-    if_freenameindex( indices );
+    if (indices) if_freenameindex( indices );
 
     if (!have_ethernet_iface && fake_ethernet_adapter() && (if_entry = add_entry( 0xdeadbeef, "eth0faked" )))
     {
diff --git a/dlls/nsiproxy.sys/nsi.c b/dlls/nsiproxy.sys/nsi.c
index a13d77a47a..437eeb3241 100644
--- a/dlls/nsiproxy.sys/nsi.c
+++ b/dlls/nsiproxy.sys/nsi.c
@@ -190,11 +190,23 @@ static NTSTATUS add_notification( const NPI_MODULEID *module, UINT32 table )
 static NTSTATUS poll_events(void)
 {
     static int netlink_fd = -1;
+    /* VESSEL: remember a refusal instead of repeating it.
+     *
+     * Android will not let an untrusted app bind() a NETLINK_ROUTE socket, so
+     * this fails on every call -- fifty identical ERR lines in one session log,
+     * for a facility whose absence is already handled. Returning
+     * STATUS_NOT_IMPLEMENTED means "no address-change notifications", and the
+     * interface table is still read on demand. Failing once loudly and then
+     * quietly is the honest shape; failing loudly for ever buries the lines
+     * that matter. */
+    static int unavailable;
     char buffer[PIPE_BUF];
     struct nlmsghdr *nlh;
     NTSTATUS status;
     int len;
 
+    if (unavailable) return STATUS_NOT_IMPLEMENTED;
+
     if (netlink_fd == -1)
     {
         struct sockaddr_nl addr;
@@ -212,7 +224,8 @@ static NTSTATUS poll_events(void)
         {
             close( netlink_fd );
             netlink_fd = -1;
-            ERR( "bind failed, errno %d.\n", errno );
+            unavailable = 1;
+            ERR( "bind failed, errno %d; address-change notifications are off.\n", errno );
             return STATUS_NOT_IMPLEMENTED;
         }
     }
