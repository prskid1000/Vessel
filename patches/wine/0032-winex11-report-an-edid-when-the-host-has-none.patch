+/* Vessel: a synthetic EDID for a monitor the host gave us none for.
+ *
+ * DXVK reads the monitor's EDID out of the registry to work out colour space
+ * and HDR capability, and without one it logs
+ *   readMonitorEdidFromKey: Failed to get EDID reg key size
+ *   DXGI: Failed to parse display metadata + colorimetry info, using blank.
+ * on every session.
+ *
+ * This has to be supplied here rather than seeded into the registry. win32u
+ * writes the monitor key from what add_monitor is given, and
+ * sysparams.c:prepare_devices() calls reg_empty_key( enum_key, "DISPLAY" ) on
+ * every display initialisation -- anything written under Enum\DISPLAY by hand
+ * is deleted before Wine repopulates it. Seeding was tried and measured to
+ * vanish. The XRandR output property that would normally carry an EDID is not
+ * available either: Vessel's X server implements no RandR extension.
+ *
+ * What this block claims is deliberately conservative. sRGB primaries, gamma
+ * 2.2, and NO CTA-861 extension block, which is the only place an EDID can
+ * advertise HDR static metadata -- the session composites SDR, and telling DXGI
+ * otherwise would give washed-out output and a bug report pointing anywhere but
+ * here. Physical size is left undefined because Android decides the surface
+ * size; inventing one would give every guest program a wrong DPI.
+ *
+ * Built field by field with a computed checksum rather than pasted as a byte
+ * literal: an EDID whose last byte was not updated after an edit is rejected
+ * whole, and silently, which is the same failure this exists to remove.
+ *
+ * The static is written identically by any thread that reaches it, so the lack
+ * of a lock cannot produce a value that was never valid.
+ */
+static const unsigned char *vessel_default_edid( UINT *len )
+{
+    static unsigned char edid[128];
+    unsigned int i, sum = 0;
+
+    memset( edid, 0, sizeof(edid) );
+
+    /* Fixed header. A block without it is rejected before any field is read. */
+    edid[0] = 0x00;
+    for (i = 1; i <= 6; i++) edid[i] = 0xff;
+    edid[7] = 0x00;
+
+    /* Manufacturer "VSL", three letters packed five bits each, big-endian. Not
+     * a registered PNP id on purpose: this is a virtual display, and borrowing
+     * a real vendor's code would make it identify as hardware it is not. */
+    edid[8] = 0x5a;
+    edid[9] = 0x6c;
+    edid[10] = 0x01;   /* product code, little-endian */
+    edid[11] = 0x00;
+    /* 12-15 serial, 16 week: left zero, meaning unspecified. */
+    edid[17] = 2024 - 1990;
+    edid[18] = 0x01;   /* EDID 1.4 */
+    edid[19] = 0x04;
+    edid[20] = 0x95;   /* digital, 8 bits per colour, DisplayPort */
+    /* 21-22 physical size in cm: zero is the spec's "undefined". */
+    edid[23] = 0x78;   /* gamma, stored as gamma * 100 - 100, so 2.2 */
+    edid[24] = 0x06;   /* sRGB is the default colour space; descriptor 1 is the
+                        * preferred timing, which 1.4 requires to be detailed */
+
+    /* Chromaticity: exactly sRGB. Red .640/.330, green .300/.600,
+     * blue .150/.060, white D65 .3127/.3290, ten bits each with the low two
+     * bits of all eight packed into the first two bytes. */
+    {
+        static const unsigned char chroma[10] =
+            { 0xee, 0x91, 0xa3, 0x54, 0x4c, 0x99, 0x26, 0x0f, 0x50, 0x54 };
+        memcpy( edid + 25, chroma, sizeof(chroma) );
+    }
+
+    /* 35-37 established timings: none claimed. The mode list a program sees
+     * comes from the settings handler, not from here. */
+
+    /* 38-53 standard timings: 0x01,0x01 is the spec's "unused". Zero is
+     * reserved and is not the same thing. */
+    for (i = 38; i <= 53; i++) edid[i] = 0x01;
+
+    /* 54-71 descriptor 1, the preferred detailed timing: 1920x1080 @ 60 Hz,
+     * 148.5 MHz in 10 kHz units, 1920 active + 280 blanking horizontally,
+     * 1080 + 45 vertically, sync offsets 88/44 and 4/5, no borders, digital
+     * separate sync with both polarities positive. Image size stays zero for
+     * the same reason bytes 21 and 22 do. */
+    {
+        static const unsigned char dtd[18] =
+            { 0x02, 0x3a, 0x80, 0x18, 0x71, 0x38, 0x2d, 0x40, 0x58,
+              0x2c, 0x45, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x1e };
+        memcpy( edid + 54, dtd, sizeof(dtd) );
+    }
+
+    /* 72-89 descriptor 2, the monitor name. Thirteen bytes, ended by 0x0a and
+     * padded with spaces, which is how a name shorter than the field is
+     * written. */
+    edid[75] = 0xfc;
+    memcpy( edid + 77, "Vessel SDR\n  ", 13 );
+
+    /* 90-107 and 108-125, descriptors 3 and 4: unused. 0x10 is the spec's
+     * "empty descriptor" tag; left at zero they would read as detailed timings
+     * with a zero pixel clock. */
+    edid[93] = 0x10;
+    edid[111] = 0x10;
+
+    /* 126 extension blocks: none. One that is counted and absent invalidates
+     * the whole EDID -- and a CTA-861 block is where HDR would be claimed. */
+    edid[126] = 0x00;
+
+    /* 127 checksum: the 128 bytes must sum to zero mod 256. */
+    for (i = 0; i < 127; i++) sum += edid[i];
+    edid[127] = (unsigned char)((256 - (sum & 0xff)) & 0xff);
+
+    *len = sizeof(edid);
+    return edid;
+}
+
 UINT X11DRV_UpdateDisplayDevices( const struct gdi_device_manager *device_manager, void *param )
 {
     INT gpu_count, adapter_count, monitor_count, current_adapter_count = 0;
@@ -530,6 +641,14 @@ UINT X11DRV_UpdateDisplayDevices( const struct gdi_device_manager *device_manage
             for (monitor = 0; monitor < monitor_count; monitor++)
             {
                 monitors[monitor].hdr_enabled = hdr_enabled;
+                if (!monitors[monitor].edid || !monitors[monitor].edid_len)
+                {
+                    /* Only when the host gave us nothing. A real EDID, if one
+                     * ever arrives from RandR, always wins. */
+                    monitors[monitor].edid =
+                        (unsigned char *)vessel_default_edid( &monitors[monitor].edid_len );
+                    TRACE( "no host EDID for monitor %d, reporting the built-in SDR block\n", monitor );
+                }
                 device_manager->add_monitor( &monitors[monitor], param );
             }
 
