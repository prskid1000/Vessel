+static UINT32 vessel_collection_find_alias(struct dwrite_fontcollection *collection, const WCHAR *name)
+{
+    unsigned int i, j;
+
+    for (i = 0; i < ARRAY_SIZE(vessel_family_aliases); ++i)
+    {
+        if (wcsicmp(vessel_family_aliases[i].requested, name)) continue;
+
+        for (j = 0; j < ARRAY_SIZE(vessel_family_aliases[i].targets); ++j)
+        {
+            const WCHAR *target = vessel_family_aliases[i].targets[j];
+            UINT32 index;
+
+            if (!target) break;
+
+            if ((index = collection_find_family(collection, target)) != ~0u)
+            {
+                TRACE("aliased absent family %s to %s.\n", debugstr_w(name), debugstr_w(target));
+                return index;
+            }
+        }
+
+        WARN("no target present for absent family %s.\n", debugstr_w(name));
+        break;
+    }
+
+    return ~0u;
+}
