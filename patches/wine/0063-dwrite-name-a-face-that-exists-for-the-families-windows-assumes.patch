+    /* Only after the real lookup has failed, so a device holding the genuine
+     * face always gets it and this table never shadows anything installed. */
+    if (*index == ~0u)
+        *index = vessel_collection_find_alias(collection, name);
     *exists = *index != ~0u;
     return S_OK;
