+/* Vessel: a ceiling on a pure reservation, chosen per container.
+ *
+ * **This was an unconditional 8 GB clamp and it had to go, because it lied.** A
+ * pure MEM_RESERVE larger than 8 GB was silently cut to 8 GB and reported as
+ * success. V8 does not merely commit inside its pointer-compression cage: it
+ * validates the reservation it was handed, rejects one of the wrong size,
+ * releases it and asks again smaller, walking a ladder from 1.5 TB down. A
+ * success it never got is a rung it can never descend past, so the ladder stops
+ * dead -- one Electron session took 36,043 clamped reservations and 59,601
+ * attempts at a single size, forever. That is why the clamp was deleted
+ * outright at revision 61, and why nothing here restores it by default.
+ *
+ * What the deletion cost, which revision 61 predicted and did not measure. Not
+ * every caller walks a ladder. An allocator that reserves a large range once
+ * and treats failure as fatal -- Unreal's Binned3 asks for up to 512 GB and
+ * aborts if it cannot have it -- was being carried by the lie, and a 39-bit-VA
+ * kernel hands out 512 GB of user address space in total, so the honest answer
+ * to that request is no.
+ *
+ * **Those two callers want opposite answers to the same question, and the
+ * request does not distinguish them.** V8 needs the failure in order to
+ * descend; Binned3 needs the success in order to start. Both arrive as a pure
+ * MEM_RESERVE with no base and a size that does not fit. No threshold, no
+ * protection flag and no alignment separates them, which is the whole reason
+ * this is a setting and not a heuristic -- a heuristic here would be the 8 GB
+ * clamp again, wearing a larger number.
+ *
+ * So it defaults to off, and off is byte-for-byte the behaviour of revision 61.
+ * V8, Chromium, Electron and VS Code are unaffected by this patch existing:
+ * they get the honest STATUS_NO_MEMORY that lets the ladder find the rung that
+ * fits, which is what made them work in the first place. A container running a
+ * title that dies on a large reservation sets WINE_MAX_RESERVATION_GB to a size
+ * that does fit, and pays the old price knowingly -- the guest is told it owns
+ * address space it does not, and a program that reads back what it reserved
+ * finds a different number than it asked for.
+ *
+ * Deliberately the same shape as WINE_COMMIT_GRANULARITY_KB above: a property
+ * of the machine a program expects, which this kernel does not have, named as a
+ * per-container choice rather than decided once for everybody.
+ */
+static SIZE_T max_reservation_size(void)
+{
+    static SIZE_T limit = ~(SIZE_T)0;
+
+    if (limit == ~(SIZE_T)0)
+    {
+        const char *e = getenv( "WINE_MAX_RESERVATION_GB" );
+        unsigned int gb = e ? atoi( e ) : 0;   /* off unless a container asks */
+
+        /* Above 256 GB there is nothing left on a 39-bit kernel for the clamp
+         * to land in, so a value that large is a typo rather than a request. */
+        if (!gb || gb > 256) limit = 0;
+        else
+        {
+            limit = (SIZE_T)gb << 30;
+            /* WARN rather than ERR, once per process, for the reason
+             * commit_granularity_mask gives directly above: this is a statement
+             * of configuration and not a failure, and a session has many
+             * processes. Enable warn+virtual to confirm the setting took. */
+            WARN( "pure reservations above %u GB will be clamped to it\n", gb );
+        }
+    }
+    return limit;
+}
+
 
 static NTSTATUS allocate_virtual_memory( void **ret, SIZE_T *size_ptr, ULONG type, ULONG protect,
                                          ULONG_PTR limit_low, ULONG_PTR limit_high,
                                          ULONG_PTR align, ULONG attributes )
@@ -5887,6 +5949,20 @@ static NTSTATUS allocate_virtual_memory( void **ret, SIZE_T *size_ptr, ULONG typ
         if ((type & MEM_COMMIT) && commit_granularity_mask() != page_mask)
             size = ROUND_SIZE( base, size, commit_granularity_mask() );
 
+        /* Vessel: a reservation this kernel cannot honour, clamped only if the
+         * container asked for that. See max_reservation_size -- the default is
+         * off, which is the honest STATUS_NO_MEMORY that lets V8 walk its
+         * fallback ladder down to a size that fits. Pure reservations only: one
+         * that commits is asking for memory rather than for address space, and
+         * shortening it would hand back a buffer smaller than the caller sized
+         * its writes for. */
+        if ((type & MEM_RESERVE) && !(type & MEM_COMMIT) && !base
+            && max_reservation_size() && size > max_reservation_size())
+        {
+            WARN( "oversized reservation of 0x%lx bytes clamped to 0x%lx\n", size, max_reservation_size() );
+            size = max_reservation_size();
+        }
+
         if (!(status = get_vprot_flags( protect, &vprot, FALSE )))
         {
             if (type & MEM_COMMIT) vprot |= VPROT_COMMITTED;
