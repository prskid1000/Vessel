+/***********************************************************************
+ *           FlsGetValue2   (kernelbase.@)
+ *
+ * Undocumented, and present in kernelbase.dll since Windows 11. The newer
+ * Visual C++ runtime resolves it by name at startup and uses it in place of
+ * FlsGetValue; a game shipping its own VCRUNTIME140 therefore asks for it on
+ * every platform, including this one.
+ *
+ * The difference from FlsGetValue is the SetLastError() below it, which this
+ * one does not do. That is the whole point of the second entry point: the write
+ * to the TEB is pure cost on a path the CRT takes constantly. Failing the
+ * lookup is what breaks callers, because GetProcAddress hands back NULL and the
+ * caller stores it as a function pointer.
+ */
+PVOID WINAPI DECLSPEC_HOTPATCH FlsGetValue2( DWORD index )
+{
+    void *data;
+
+    if (!set_ntstatus( RtlFlsGetValue( index, &data ))) return NULL;
+    return data;
+}
+
+
 /***********************************************************************
  *           FlsSetValue   (kernelbase.@)
  */
