+/* Vessel: name the branch that resumed a fault, when one page keeps coming back.
+ *
+ * Diagnostic only. Nothing here changes what is continued or when.
+ *
+ * This function is where the 2026-08-14 offline-compiler loop closes, and the
+ * measurement that says so is in the comment on
+ * OvercommitTracker::HandleAccessViolation: 155,039 identical
+ * `RtlInitializeExtendedContext2 context 000000000011E630` lines against
+ * exactly one `dispatch_exception`. Wine builds that context and calls
+ * pResetToConsistentState *before* it calls dispatch_exception
+ * (dlls/ntdll/signal_arm64ec.c:1343-1366), so a fault that never reaches
+ * vectored dispatch was resumed here, by one of the NtContinueNative calls
+ * below -- and the log could not say which, because none of them says anything.
+ *
+ * 0008 fixes the overcommit branch outright. The other three exits from
+ * ResetToConsistentStateImpl -- CallRetStack, the JIT guard page, and the RWX
+ * SMC handler -- can each resume a fault too, and only one of them is the one
+ * that was looping. This line is what makes the next run answer that instead of
+ * needing another round of inference.
+ *
+ * Page-granular and rate-limited, because on a healthy session the SMC branch
+ * legitimately resumes the same page many times: a run of them is normal, so
+ * this is tuned to be silent below 4096 and unmissable above it. */
+static void NoteFaultContinue(EXCEPTION_RECORD* Exception, const char* Site) {
+  if (Exception->ExceptionCode != EXCEPTION_ACCESS_VIOLATION) {
+    return;
+  }
+
+  static std::atomic<uint64_t> LastPage {~0ULL};
+  static std::atomic<uint64_t> Repeats {0};
+
+  const uint64_t Page = static_cast<uint64_t>(Exception->ExceptionInformation[1]) & FEXCore::Utils::FEX_PAGE_MASK;
+  if (LastPage.exchange(Page, std::memory_order_relaxed) != Page) {
+    Repeats.store(0, std::memory_order_relaxed);
+    return;
+  }
+
+  const uint64_t Count = Repeats.fetch_add(1, std::memory_order_relaxed) + 1;
+  if ((Count % 4096) == 0) {
+    LogMan::Msg::EFmt("Fault on page {:X} resumed {} times running by {}", Page, Count, Site);
+  }
+}
+
