-        const auto AlignedFaultAddress = reinterpret_cast<void*>(FaultAddress & FEXCore::Utils::FEX_PAGE_MASK);
-        VirtualAlloc(AlignedFaultAddress, std::min(Query.Size, MaxFaultCommitSize), MEM_COMMIT, PAGE_READWRITE);
+        MEMORY_BASIC_INFORMATION Info {};
+        SIZE_T ResultLength = 0;
+        const NTSTATUS Status = NtQueryVirtualMemory(NtCurrentProcess(), reinterpret_cast<void*>(FaultAddress),
+                                                     MemoryBasicInformation, &Info, sizeof(Info), &ResultLength);
+        if (!NT_SUCCESS(Status) || ResultLength < sizeof(Info)) {
+          LogMan::Msg::EFmt("Overcommit: NtQueryVirtualMemory({:X}) failed {:X}, cannot repair", FaultAddress, static_cast<uint32_t>(Status));
+          return false;
+        }
+
+        if (Info.State != MEM_RESERVE) {
+          // Already committed (or freed) and still faulting: not ours to fix.
+          LogMan::Msg::EFmt("Overcommit: {:X} faulted with State={:X} Protect={:X}, not an uncommitted page", FaultAddress,
+                            static_cast<uint32_t>(Info.State), static_cast<uint32_t>(Info.Protect));
+          return false;
+        }
+
+        if (!VirtualAlloc(Info.BaseAddress, Info.RegionSize, MEM_COMMIT, PAGE_READWRITE)) {
+          LogMan::Msg::EFmt("Overcommit: MEM_COMMIT of {:X}+{:X} for fault {:X} failed ({:X})", reinterpret_cast<uint64_t>(Info.BaseAddress),
+                            static_cast<uint64_t>(Info.RegionSize), FaultAddress, static_cast<uint32_t>(GetLastError()));
+          return false;
+        }
+        return true;
       }
+
+      static constexpr size_t MaxFaultCommitSize = 1024 * 64;
+      const auto AlignedFaultAddress = reinterpret_cast<void*>(FaultAddress & FEXCore::Utils::FEX_PAGE_MASK);
+      if (!VirtualAlloc(AlignedFaultAddress, std::min(Query.Size, MaxFaultCommitSize), MEM_COMMIT, PAGE_READWRITE)) {
+        LogMan::Msg::EFmt("Overcommit: MEM_COMMIT for fault {:X} failed ({:X})", FaultAddress, static_cast<uint32_t>(GetLastError()));
