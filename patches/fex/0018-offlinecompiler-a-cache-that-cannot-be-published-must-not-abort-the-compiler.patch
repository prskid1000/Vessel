+    std::error_code RenameError;
+    std::filesystem::rename(FilenameNew.c_str(), Filename.c_str(), RenameError);
+    if (!RenameError) {
+      return Filename;
+    }
+
+    auto FilenameReady = Filename + ".ready";
+    std::error_code HandoffError;
+    std::filesystem::rename(FilenameNew.c_str(), FilenameReady.c_str(), HandoffError);
