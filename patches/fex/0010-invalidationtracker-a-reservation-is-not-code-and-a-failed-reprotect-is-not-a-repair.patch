+       * EFmt, not IFmt: 0003's default ceiling is ERROR, which is the mistake
+       * that kept 0006's thrash counter invisible. */
       if (!NT_SUCCESS(ProtStatus)) {
         static std::atomic<uint64_t> FailedReprotects {0};
         const uint64_t Seen = FailedReprotects.fetch_add(1, std::memory_order_relaxed) + 1;
         if (Seen == 1 || (Seen % 4096) == 0) {
