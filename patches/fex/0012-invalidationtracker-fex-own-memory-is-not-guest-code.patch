+/* Vessel: FEX's own bookkeeping memory is not guest code, and this is where the
+ * two get told apart.
+ *
+ * **The distinction, and why the withdrawn MEM_COMMIT gate was the wrong one.**
+ * That gate asked "is this range committed?" and a real guest turned out to
+ * depend on reserve-time classification, so it killed Metro 2033. The question
+ * that actually separates the two is ownership: a range handed to
+ * MarkOvercommitRange is FEXCore's own lookup table, and **no guest allocation
+ * ever reaches that call** -- its one caller is LookupCache.cpp:49, on memory
+ * LookupCache.cpp:41 just reserved for itself. So this touches guest
+ * classification in exactly zero cases, which is the property the gate lacked.
+ *
+ * **Removal, not just prevention.** The allocation is notified at
+ * LookupCache.cpp:41 and marked at :49, so by the time we are told it is
+ * private it has already been classified. MarkPrivateRange therefore removes it
+ * from XIntervals and RWXIntervals as well as recording it, and this function
+ * then declines to put it back.
+ *
+ * **What this fixes and what it cannot reach.** In a session the LookupCache and
+ * the InvalidationTracker are the same module's, so the exclusion is exact and
+ * free. In FEXOfflineCompiler they are not: MarkOvercommitRange goes to the
+ * tool's own OvercommitTracker (FEXOfflineCompiler/Main.cpp:131) while the
+ * notification is delivered to the emulation module's InvalidationTracker --
+ * two FEXCore instances in one process, with no channel between them. Nothing
+ * in this patch crosses that boundary, so the offline compiler is fixed by the
+ * decline in HandleRWXAccessViolation below instead, which needs no channel.
+ *
+ * A channel was considered and rejected: exporting a mark/unmark pair from
+ * libarm64ecfex.dll for the tool to resolve with GetProcAddress. It would work,
+ * but ARM64EC export tables carry EXP+# aliasing and fast-forward sequences, so
+ * a wrongly-resolved pointer is a plausible silent failure that cannot be
+ * checked without a device -- a poor trade for a case the decline already
+ * covers. The other candidate, reserving FEX-private regions PAGE_NOACCESS so
+ * ProtIsReadable() is false, was rejected because it only hides the *reserve*
+ * step: the moment OvercommitTracker commits a run as PAGE_READWRITE, DEP
+ * promotion reclassifies it and the lookup table goes back to being trapped and
+ * invalidated on every write. That converts a hang into a permanent tax and
+ * leaves the classification wrong, which is the actual defect. */
+void InvalidationTracker::MarkPrivateRange(uint64_t Address, uint64_t Size) {
+  const auto AlignedBase = Address & FEXCore::Utils::FEX_PAGE_MASK;
+  const auto AlignedSize = (Address - AlignedBase + Size + FEXCore::Utils::FEX_PAGE_SIZE - 1) & FEXCore::Utils::FEX_PAGE_MASK;
+  const FEXCore::IntervalList<uint64_t>::Interval Range {AlignedBase, AlignedBase + AlignedSize};
+
+  std::unique_lock Lock(IntervalsLock);
+  PrivateIntervals.Insert(Range);
+  XIntervals.Remove(Range);
+  RWXIntervals.Remove(Range);
+  DEPPromotedIntervals.Remove(Range);
+}
+
+void InvalidationTracker::UnmarkPrivateRange(uint64_t Address, uint64_t Size) {
+  const auto AlignedBase = Address & FEXCore::Utils::FEX_PAGE_MASK;
+  const auto AlignedSize = (Address - AlignedBase + Size + FEXCore::Utils::FEX_PAGE_SIZE - 1) & FEXCore::Utils::FEX_PAGE_MASK;
+
+  std::unique_lock Lock(IntervalsLock);
+  PrivateIntervals.Remove({AlignedBase, AlignedBase + AlignedSize});
+}
+
 void InvalidationTracker::HandleMemoryProtectionNotification(uint64_t Address, uint64_t Size, ULONG Prot) {
+  {
+    // Emulator-private memory is never guest code, whatever protection it was
+    // allocated with. Checked before anything else so a later commit of the
+    // same reservation cannot reclassify it.
+    std::shared_lock Lock(IntervalsLock);
+    if (PrivateIntervals.Query(Address).Enclosed) {
+      return;
+    }
+  }
+
   const auto AlignedBase = Address & FEXCore::Utils::FEX_PAGE_MASK;
   const auto AlignedSize = (Address - AlignedBase + Size + FEXCore::Utils::FEX_PAGE_SIZE - 1) & FEXCore::Utils::FEX_PAGE_MASK;
 
