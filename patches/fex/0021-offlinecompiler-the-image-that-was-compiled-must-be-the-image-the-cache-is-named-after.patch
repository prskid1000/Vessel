+ * `CodeCache::ComputeCodeMapId` (CodeCache.cpp:275-283), which hashes the path
+ * and nothing else -- there is no header field to compare and nothing here would
+ * transfer. */
+static std::optional<FEXCore::CodeMapFileId> ImageIdOnDisk(std::string_view Path) {
+  std::ifstream File(std::string {Path}, std::ios_base::binary);
+
+  uint32_t NtOffset;
+  File.seekg(0x3c);
+  File.read(reinterpret_cast<char*>(&NtOffset), sizeof(NtOffset));
+  if (!File) {
+    return std::nullopt;
+  }
+
+  char Signature[4];
+  File.seekg(NtOffset);
+  File.read(Signature, sizeof(Signature));
+  if (!File || Signature[0] != 'P' || Signature[1] != 'E' || Signature[2] || Signature[3]) {
+    return std::nullopt;
+  }
+
+  uint32_t TimeDateStamp;
+  File.seekg(NtOffset + 8);
+  File.read(reinterpret_cast<char*>(&TimeDateStamp), sizeof(TimeDateStamp));
+
+  uint32_t SizeOfImage;
+  File.seekg(NtOffset + 24 + 56);
+  File.read(reinterpret_cast<char*>(&SizeOfImage), sizeof(SizeOfImage));
+  if (!File) {
+    return std::nullopt;
+  }
+
+  return FEX::Windows::ComputeCodeMapId(FEX::Windows::BaseName(Path), TimeDateStamp, SizeOfImage);
+}
+#endif
