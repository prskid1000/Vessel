diff --git a/Source/Windows/Common/InvalidationTracker.cpp b/Source/Windows/Common/InvalidationTracker.cpp
index 155403d35..d111647c4 100644
--- a/Source/Windows/Common/InvalidationTracker.cpp
+++ b/Source/Windows/Common/InvalidationTracker.cpp
@@ -28,6 +28,24 @@ InvalidationTracker::InvalidationTracker(FEXCore::Context::Context& CTX, const s
 
     Address = BaseAddress + Info.RegionSize;
   }
+
+  // VESSEL: honour DisableDEP, because nothing else on this path ever can.
+  //
+  // DEPDisabled is only ever set by HandleProcessExecuteFlagsChange, and the
+  // one caller of that is BTCpuNotifyProcessExecuteFlagsChange in the WOW64
+  // module. The ARM64EC module has no equivalent, so for a 64-bit guest the
+  // flag is false at construction and stays false for the life of the process
+  // -- a program that legitimately runs with DEP off is still treated as
+  // strict, and the permissive path below is unreachable rather than declined.
+  //
+  // Routed through the same handler rather than assigning the flag, so the
+  // DEP-promoted interval bookkeeping and the VirtualQuery sweep it does run
+  // exactly as they would for a guest that asked. Called after the sweep above
+  // so the intervals it re-walks are already populated.
+  FEX_CONFIG_OPT(DisableDEP, DISABLEDEP);
+  if (DisableDEP) {
+    HandleProcessExecuteFlagsChange(MEM_EXECUTE_OPTION_ENABLE);
+  }
