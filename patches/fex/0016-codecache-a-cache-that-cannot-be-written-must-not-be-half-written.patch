+// Vessel: the largest number of bytes any single relocation can emit.
+// SelectCodeRangeToFinalize already assumes this exact bound, in its own words
+// "Upper bound for relocation size"; named here so the two cannot drift.
+static constexpr size_t MaxRelocationSize = 16;
+
