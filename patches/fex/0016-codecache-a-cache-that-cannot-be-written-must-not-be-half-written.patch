+    if (!Saved) {
+      LogMan::Msg::EFmt("Not publishing {}: the cache could not be written", Filename);
+      std::error_code Ignored;
+      std::filesystem::remove(FilenameNew.c_str(), Ignored);
+      return {};
+    }
+
     std::filesystem::rename(FilenameNew.c_str(), Filename.c_str());
     return Filename;
   }
