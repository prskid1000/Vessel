   header.NumRelocations = Relocations.size();
   header.SerializedBaseAddress = SerializedBaseAddress;
+
+  /* Vessel: refuse before the first write, not after the last one.
+   *
+   * The only validation this function had was ApplyCodeRelocations, five writes
+   * later, and its failure path is
+   *
+   *     LOGMAN_THROW_A_FMT(false, "Failed to apply code relocations");
+   *     return false;
+   *
+   * -- which is compiled out of this Release build, so it was a silent return
+   * that left the header, the block list and the relocation table already on
+   * disk with no code section behind them. The next launch mmaps that file,
+   * walks into the missing code, and rejects it. Measured on Resident Evil
+   * Requiem, every single session:
+   *
+   *     Code cache relocation 1863801 offset 0x6630e70 (base 0x0) does not fit
+   *       a 107151044 byte buffer; refusing to apply          <- generation
+   *     Code cache relocation 1878114 of 7952524 targets 0x66f403c, outside a
+   *       0x66f4000 byte code buffer                          <- load
+   *     Failed to load cache: re9.exe-a7b10b28eeac3098
+   *
+   * So roughly 74 seconds of ahead-of-time compilation was spent, ~100 MB was
+   * written, and the result was discarded on load every time. The game ran on
+   * the runtime JIT throughout while appearing to have a warm cache.
+   *
+   * WHY THE TABLE IS BAD IS ALREADY KNOWN, and 0011 wrote it down as an
+   * inference; these logs are the observation that confirms it. When generation
+   * exhausts the code buffer, JIT.cpp calls ClearCodeCache, which installs a
+   * fresh buffer and restarts LatestOffset at zero, while relocations are
+   * deliberately kept across that point. Everything recorded before the swap
+   * then carries an offset into a buffer that no longer exists, and both the
+   * block list and the relocation table are written against the *new*
+   * LatestOffset.
+   *
+   * Raising MAX_CODE_SIZE is not the fix. Its own comment says why -- "we don't
+   * want to move above 128MB atm because that means we will have to encode
+   * longer jumps" -- and that is the Â±128 MB reach of an AArch64 b/bl, not a
+   * preference.
+   *
+   * A cache that spans a swap cannot be repaired here, because the code those
+   * offsets referred to is gone. What can be fixed is writing it anyway: this
+   * checks the same invariants the loader will, before anything is written, and
+   * leaves an empty file rather than a plausible one. */
+  {
+    const uint64_t CodeSize = CTX.LatestOffset;
+    uint64_t PreviousOffset = 0;
+    size_t Rejected = 0;
+
+    for (size_t i = 0; i < Relocations.size(); ++i) {
+      const uint64_t Offset = Relocations[i].Header.Offset;
+      if (Offset + MaxRelocationSize > CodeSize) {
+        if (!Rejected++) {
+          LogMan::Msg::EFmt("Code cache not written: relocation {} of {} is at {:#x}, past the {:#x} "
+                            "bytes of code this cache would hold; the code buffer was replaced during "
+                            "generation and everything recorded before that points into the old one",
+                            i, Relocations.size(), Offset, CodeSize);
+        }
+      } else if (Offset < PreviousOffset) {
+        if (!Rejected++) {
+          LogMan::Msg::EFmt("Code cache not written: relocation {} offset {:#x} is below its predecessor "
+                            "{:#x}; the table is not sorted, which LoadCache's page partitioning requires",
+                            i, Offset, PreviousOffset);
+        }
+      }
+      PreviousOffset = Offset;
+    }
+
+    for (const auto& [Guest, BlockEntry] : LookupCache.BlockList) {
+      const uint64_t HostCode = BlockEntry.HostCode - reinterpret_cast<uintptr_t>(CodeBuffer->Ptr);
+      if (HostCode >= CodeSize) {
+        if (!Rejected++) {
+          LogMan::Msg::EFmt("Code cache not written: block for guest {:#x} maps to host offset {:#x}, "
+                            "past the {:#x} bytes of code this cache would hold",
+                            Guest, HostCode, CodeSize);
+        }
+        break;
+      }
+    }
+
+    if (Rejected) {
