@@ -37,8 +37,30 @@
 #include <errno.h>
 #include <stddef.h>
 #include <stdint.h>
+#include <sys/ioctl.h>
 #include <sys/types.h>
 
+/* Vessel: drmIoctl, which is the one libdrm entry point that does real work
+ * rather than returning "no such device". It is a restarting ioctl and nothing
+ * more, so the shim is the whole thing rather than a stub — src/util/os_drm.h
+ * already carries a byte-identical copy under the name drm_ioctl.
+ *
+ * Needed because wsi_common_drm.c issues DMA_BUF_IOCTL_{EX,IM}PORT_SYNC_FILE
+ * through it, and that file is now compiled on pseudo-drm platforms that have
+ * no libdrm at all. See HAVE_WSI_DRM in the top-level meson.build.
+ */
+static inline int
+drmIoctl(int fd, unsigned long request, void *arg)
+{
+   int ret;
+
+   do {
+      ret = ioctl(fd, request, arg);
+   } while (ret == -1 && (errno == EINTR || errno == EAGAIN));
+
+   return ret;
+}
+
 #define DRM_NODE_PRIMARY 0
 #define DRM_NODE_CONTROL 1
 #define DRM_NODE_RENDER  2
