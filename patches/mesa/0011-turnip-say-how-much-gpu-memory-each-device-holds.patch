--- a/src/freedreno/vulkan/tu_knl.cc
+++ b/src/freedreno/vulkan/tu_knl.cc
@@ -27,6 +27,102 @@
 #include "tu_queue.h"
 #include "tu_rmv.h"
 
+#include "util/os_time.h"
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+/* Vessel: how much GPU memory each device holds, for the host to graph.
+ *
+ * Every graphics API Vessel runs reaches the GPU through this driver -- DXVK,
+ * vkd3d and Zink are all Vulkan clients of Turnip -- so a byte count here is the
+ * one VRAM figure that covers D3D 8 to 12, OpenGL and Vulkan alike. The layers
+ * above keep their own books (DXVK writes its allocator's view to
+ * VESSEL_GFX_STATS) but each sees only itself, and the kernel's per-process
+ * counters are all denied to apps on the phones this ships to.
+ *
+ * The count moves where a BO is really created and really destroyed, in the
+ * kernel backend: tu_bo_finish() runs once per *reference*, so counting there
+ * would subtract a shared BO once per holder. Imported dma-bufs are counted --
+ * a swapchain image the device holds is memory the device holds -- and sparse
+ * VMAs are not, because they reserve address space rather than memory.
+ *
+ * Published as one file per device, VESSEL_GPU_MEM_DIR/<pid>-<device>, holding
+ * "<bytes held> <heap size>" and a newline. Written from tu_queue_submit(), which every API
+ * reaches every frame, at most once a second and only when the figure moved;
+ * written with a rename so the host never reads half a number; removed when the
+ * device is destroyed. A process that dies without destroying its device
+ * leaves a file whose pid is gone, and the host drops it. With the variable
+ * unset -- anything but a Vessel session -- all of this is one branch. */
+
+static const char *
+vessel_gpu_mem_dir(void)
+{
+   static const char *dir = getenv("VESSEL_GPU_MEM_DIR");
+   return dir && *dir ? dir : NULL;
+}
+
+static void
+vessel_gpu_mem_path(struct tu_device *dev, char *out, size_t size)
+{
+   snprintf(out, size, "%s/%d-%" PRIxPTR, vessel_gpu_mem_dir(), (int) getpid(),
+            (uintptr_t) dev);
+}
+
+void
+tu_vessel_gpu_mem_add(struct tu_device *dev, int64_t bytes)
+{
+   __atomic_fetch_add(&dev->vessel_bo_bytes, (uint64_t) bytes, __ATOMIC_RELAXED);
+}
+
+void
+tu_vessel_gpu_mem_publish(struct tu_device *dev)
+{
+   if (!vessel_gpu_mem_dir())
+      return;
+
+   const uint64_t now = os_time_get_nano();
+   uint64_t last = __atomic_load_n(&dev->vessel_bo_published_ns, __ATOMIC_RELAXED);
+   if (last && now - last < 1000000000ull)
+      return;
+
+   const uint64_t bytes = __atomic_load_n(&dev->vessel_bo_bytes, __ATOMIC_RELAXED);
+   if (last && bytes == __atomic_load_n(&dev->vessel_bo_published_bytes, __ATOMIC_RELAXED))
+      return;
+
+   /* One writer per second across however many queues submit concurrently. */
+   if (!__atomic_compare_exchange_n(&dev->vessel_bo_published_ns, &last, now, false,
+                                    __ATOMIC_RELAXED, __ATOMIC_RELAXED))
+      return;
+
+   char path[512], tmp[520];
+   vessel_gpu_mem_path(dev, path, sizeof(path));
+   snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+
+   FILE *f = fopen(tmp, "w");
+   if (!f)
+      return;
+   /* The heap size beside it: it is the budget the application was told, and
+    * Vessel sets it from the container's VRAM setting, so the host can draw
+    * the line against the ceiling that actually applies. */
+   fprintf(f, "%" PRIu64 " %" PRIu64 "\n", bytes, dev->physical_device->heap.size);
+   if (fclose(f) == 0 && rename(tmp, path) == 0)
+      __atomic_store_n(&dev->vessel_bo_published_bytes, bytes, __ATOMIC_RELAXED);
+}
+
+void
+tu_vessel_gpu_mem_retire(struct tu_device *dev)
+{
+   if (!vessel_gpu_mem_dir())
+      return;
+
+   char path[512];
+   vessel_gpu_mem_path(dev, path, sizeof(path));
+   unlink(path);
+}
+
 VkResult
 tu_bo_init_new_explicit_iova(struct tu_device *dev,
                              struct vk_object_base *base,
