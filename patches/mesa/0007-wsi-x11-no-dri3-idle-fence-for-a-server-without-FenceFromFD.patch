+/* Vessel: whether to give each DRI3 pixmap an xshmfence idle fence.
+ *
+ * Off by default here, and that is a statement about one X server rather than
+ * about DRI3. Vessel's X server does not implement DRI3 FenceFromFD (opcode 4)
+ * — and refusing a request is not free, because the fd that came with it over
+ * SCM_RIGHTS stays in the connection's ancillary-fd queue. Every later
+ * PixmapFromBuffer then pops the *previous* image's fence page instead of its
+ * own dma-buf. Measured: the second present died in the server with
+ *   signal 7 (SIGBUS), code 2 (BUS_ADRERR), fault addr <src+0x1000>
+ *   __memmove_aarch64_nt / com.winlator.xserver.Drawable.copyArea
+ *   / PresentExtension.presentPixmap
+ * — a 3686400-byte copy out of a 4096-byte xshmfence page, faulting on its
+ * second page.
+ *
+ * Skipping the fence is sound against this server specifically, and not a
+ * shortcut: PresentExtension.presentPixmap copies the pixmap synchronously,
+ * under the window's render lock, *before* it sends PresentIdleNotify. The
+ * idle event is therefore already a complete signal, which is the thing the
+ * fence exists to add for servers whose copy outlives the notification.
+ *
+ * Set VESSEL_WSI_DRI3_FENCE=1 to ask for it again — the one thing to do after
+ * the server grows FenceFromFD, so the change can be measured rather than
+ * assumed.
+ */
+static bool
+x11_wants_dri3_fence(void)
+{
+   static int want = -1;
+   if (unlikely(want < 0))
+      want = debug_get_bool_option("VESSEL_WSI_DRI3_FENCE", false) ? 1 : 0;
+   return want == 1;
+}
+
 static VkResult
 x11_image_init(VkDevice device_h, struct x11_swapchain *chain,
                const VkSwapchainCreateInfoKHR *pCreateInfo,
@@ -2820,6 +2855,16 @@
 #endif
 
