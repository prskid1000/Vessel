+    * "no fence" is the deliberate state here and not an omission, and because
+    * XCB_NONE is what x11_present_to_x11_dri3 then passes as the idle fence. */
+   if (!x11_wants_dri3_fence()) {
+      image->shm_fence = NULL;
+      image->sync_fence = XCB_NONE;
+      return VK_SUCCESS;
+   }
