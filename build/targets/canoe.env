# Target: canoe — Motorola Signature / Snapdragon SM8845 / Adreno 829
#
# Everything chip-specific lives here. Adding a second device means adding a
# second file in this directory; no build script changes.
#
# All values verified on-device 2026-08-07 via adb (see docs/ARCHITECTURE.md).
# shellcheck disable=SC2034

TARGET_NAME=canoe
TARGET_DESC="Snapdragon SM8845 (Oryon) / Adreno 829"

# --- CPU ---------------------------------------------------------------------
# /proc/cpuinfo: implementer 0x51 (Qualcomm), part 0x002 (Oryon), 8 cores,
# 6x 3.32 GHz + 2x 3.80 GHz.
#
# Reported features: fp asimd aes pmull sha1 sha2 crc32 atomics fphp asimdhp
# jscvt fcma lrcpc dcpop sha3 sm3 sm4 asimddp sha512 sve asimdfhm dit uscat
# ilrcpc flagm ssbs sb paca pacg dcpodp sve2 sveaes svepmull svesha3 svesm4
# flagm2 frint svei8mm svebf16 i8mm bf16 rng bti ecv afp rpres sme smei8i32
# smef16f32 smeb16f32 smef32f32 lrcpc3
#
# Notably ABSENT: FEAT_TSO. Memory-ordering emulation is therefore the single
# most performance-relevant runtime setting on this device.
TARGET_MARCH="armv8.7-a+crypto+sm4+sha3+fp16+sve+sve2+i8mm+bf16"
TARGET_MTUNE="oryon-1"

# Preferred over march/mtune when the compiler accepts it (clang >= 19 / gcc >= 15).
# build/common.sh probes this and falls back to TARGET_MARCH/TARGET_MTUNE,
# logging which one it used — it never silently drops the flag.
TARGET_MCPU="oryon-1"

# SVE2 vector length is 128-bit on Oryon. This matters: FEX's fast AVX path
# wants 256-bit, so AVX is emulated as two 128-bit halves. Do not assume
# SVE width from the ISA version.
TARGET_SVE_BITS=128

# 4 KB pages (kernel 6.12.38-android16-5-...-4k). Box64's PAGE16K must stay OFF.
TARGET_PAGE_SIZE=4096

# --- GPU ---------------------------------------------------------------------
# Adreno 829, gen8 family, KGSL kernel driver (/dev/kgsl-3d0 present).
# Stock Qualcomm driver reports Vulkan 1.4 (build dated 2026-03-18) but lacks
# extensions DXVK 2.x needs, which is why we build Turnip.
TARGET_GPU=a829
TARGET_GPU_GEN=gen8
TARGET_KMD=kgsl

# --- Android -----------------------------------------------------------------
TARGET_ABI=arm64-v8a
TARGET_API=36

# --- Component-specific selections -------------------------------------------

# Box64 CMake preset. SD8EG5 ("Snapdragon 8 Elite Gen 5") sets
# -march=armv8.7-a+crypto+sm4+sha3+fp16+sve+sve2 -mtune=oryon-1 upstream,
# which matches this chip exactly.
BOX64_PRESET=SD8EG5

# --- Runtime defaults --------------------------------------------------------
# Exported into the .wcp metadata and consumed by the app as the default
# container profile for this target. Rationale for each is in
# docs/ARCHITECTURE.md#runtime-defaults.

# GMEM (tiled) rendering is broken on gen8-class Adreno in current Turnip
# builds; system memory rendering is the working path.
RUNTIME_TU_DEBUG=sysmem

# FEX: keep TSO emulation on (disabling it breaks multithreaded apps), but
# use the cheap half-barrier form. Vector TSO stays off — games are
# vector-heavy and the cost is severe.
RUNTIME_FEX_TSOENABLED=1
RUNTIME_FEX_HALFBARRIERTSO=1
RUNTIME_FEX_VECTORTSO=0

# Box64: start at the fast end. Raise STRONGMEM to 1-2 only if a title shows
# threading glitches. DynaCache is on by default in 0.4.4 and worth keeping.
RUNTIME_BOX64_DYNAREC_STRONGMEM=0
RUNTIME_BOX64_DYNAREC_BIGBLOCK=2
RUNTIME_BOX64_DYNACACHE=1
