<?xml version="1.0" encoding="utf-8"?>
<!--
  Identical to ic_launcher. Adaptive icons are masked by the launcher, so the
  round variant needs no separate artwork — the glyph is already inside the
  safe zone a circular mask leaves. It exists because some launchers still ask
  for android:roundIcon by name.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
