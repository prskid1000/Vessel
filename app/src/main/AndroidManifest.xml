<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network is used for the component registry and .wcp downloads only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      `appCategory="game"` is a performance setting on this hardware, not a
      label for the launcher.

      Measured on the device before it was set: `cmd game list-modes app.vessel`
      answered *"Package app.vessel is not of game type"*, and a Metro session
      ran its whole length with the cores at 1713-1977 MHz out of a 3321/3801
      ceiling — under 60% of the clock that was available, at 84% GPU. Nothing
      told the platform this was a game, so nothing raised anything.

      This phone has a lot listening for that answer: `pm list features` reports
      `com.motorola.software.game_mode` and `com.motorola.game_moment`, and
      `service list` has `motorola.hardware.power.IMdpfExt` next to Qualcomm's
      `vendor.qti.hardware.power.powermodule.IPowerModule`. All of it keys off
      the app category, and all of it was being asked to treat a game engine as
      a productivity app.

      It also unlocks the user-facing half — Game Dashboard, and the per-app
      Performance/Battery choice — which `res/xml/game_mode_config.xml` gives
      defaults for.
    -->
    <application
        android:name=".VesselApplication"
        android:allowBackup="false"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vessel">

        <!--
          What each Game Mode means for a container. Read by GameManager when the
          user picks a mode in the Game Dashboard.

          Vessel does not scale its own render resolution from these — the guest
          decides its resolution and `display.resolution` is the user's — so both
          modes are declared with `allowDownscale="false"` and differ only in
          what they ask the platform's power path for. Claiming a downscale this
          app cannot perform would have the system budget for a frame that never
          gets cheaper.
        -->
        <meta-data
            android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />

        <!--
          `configChanges` is why rotating no longer blanks the desktop.

          The display server is a singleton and owns the GLSurfaceView the guest
          draws into, so that view outlives any one Activity by design. A
          rotation destroyed the Activity underneath it, taking the window and
          the EGL surface with it, and the view was then re-parented into a new
          Activity while still holding the dead one's Context. What came back
          was a black rectangle with a running Wine session behind it.

          Compose recomposes correctly on a configuration change without the
          Activity being rebuilt, so handling them costs nothing. `density` and
          `fontScale` are listed because Android 12+ can deliver those without a
          rotation, and they would recreate the Activity just the same.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Vessel"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Exported session logs, and nothing else. Scoped to
            `cacheDir/log-export/` by res/xml/file_paths.xml so a share sheet can
            read one log file and cannot reach a container's Wine prefix.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Component downloads survive the app being swiped away. -->
        <service
            android:name=".service.ComponentDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            The running container. `specialUse` because none of the defined
            types describe hosting a Windows process tree — it is not media, not
            a sync, and not a location fix — and Android 14+ requires a type.
        -->
        <service
            android:name=".service.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="running a Windows application the user started" />
        </service>
    </application>
</manifest>
