# Component pins — the single source of truth for what Vessel builds.
#
# Every build script sources this file, clones/fetches the repo into
# native/<name>, checks out the exact ref, applies patches/<name>/*.patch,
# and builds. Bumping a version here is the entire update procedure:
# change the ref, push, CI rebuilds that component and publishes a new .wcp.
#
# CI watches this file: a change to <NAME>_REF or patches/<name>/ triggers
# exactly the matching workflow, nothing else.
#
# shellcheck disable=SC2034

# --- Translation engines -----------------------------------------------------

# Box64 — x86_64 interpreter/JIT. Ships the SD8EG5 preset that matches Oryon.
BOX64_REPO=https://github.com/ptitSeb/box64.git
BOX64_REF=v0.4.4

# FEX-Emu — primary engine. Built as Windows PE DLLs (arm64ec + wow64),
# loaded inside Wine. Tagged monthly.
FEX_REPO=https://github.com/FEX-Emu/FEX.git
FEX_REF=FEX-2608
# Vessel's own patch revision on top of that tag. The component store is keyed
# by type and version code, so a rebuild that carries a new patch but the same
# upstream tag installs nothing and looks exactly like a patch that did not
# work. Bump this whenever patches/fex/ changes what the build produces.
#   0 -> 260800, 1 -> 260801, and the next tag FEX-2609 is 260900, still above.
# 1: patches/fex/0003 (log level ceiling) and 0004 (the ARM64EC notify deadlock).
# 2: 0004 again, without thread_local -- v1 faulted inside FEX during startup
#    because these hooks run before TLS is usable for a BT-loaded module.
# 3: patches/fex/0005. A per-app JSON config that will not parse killed the
#    process from ProcessInit, two lines before Logging::Init runs -- so it
#    presented as an unexplained c000001d at libarm64ecfex.dll +0x1747E4 and
#    took every tools/gfx harness with it.
FEX_REVISION=3

# --- Wine --------------------------------------------------------------------

# Upstream Wine, not a fork. ARM64EC is mainline now, which is the whole reason
# this moved: bylaws/wine was the place FEX/ARM64EC integration lived ahead of
# mainline, but its newest branch (upstream-arm64ec) still builds 10.13 from
# August 2025 and nothing there tracks 11.x.
#
# What mainline gives us, checked in the 11.14 tree rather than assumed:
#   - configure knows --enable-archs=arm64ec
#   - ntdll has the real ARM64EC machinery: is_arm64ec(), hybrid image loading,
#     redirect_arm64ec_rva(), a separate arm64ec unix call dispatcher
#   - load_arm64ec_module() reads
#     HKLM\Software\Microsoft\Wow64\amd64 and loads C:\windows\system32\<value>,
#     defaulting to xtajit64.dll. Pointing that value at libarm64ecfex.dll is
#     how FEX plugs in, so the emulator hook is a registry entry, not a patch.
#
# Dropping the fork also dropped a patch: 0001 existed only to fix a shm_open
# call in bylaws' FEX stats hook, and that code is not upstream.
WINE_REPO=https://github.com/ValveSoftware/wine.git
# Valve's experimental branch, not proton_11.0, and the difference is 461
# commits on the same Wine 11.0 base. Four of them land on problems measured
# here: ARM64EC cooperative suspend, "don't hold the InSyscallCallback flag
# during the NtReadFile syscall" (the Wine-side twin of patches/fex/0004),
# "winevulkan: do not show debug assertion dialog on Unix side exceptions"
# (which is the _wassert vkCreateSwapchainKHR that killed Requiem), and
# D3D12_FENCE_SUBMIT_INFO support in win32u_vkQueueSubmit. All 25 patches in
# patches/wine/ were checked against it and apply unchanged.
#
# Note this is Wine *11.0*: there is no Proton on a newer Wine base. Valve
# rebases the Proton delta onto a newer stable only occasionally and has not
# done so for 11.x, so choosing Proton means trading 14 Wine point releases
# for ~1,660 Valve patches.
WINE_REF=experimental_11.0
# A branch moves. Frozen to the commit that was tested, for the reason the
# Mesa pin below records: a branch advancing mid-session silently changed what
# was built. Bump deliberately, never by accident.
WINE_EXACT=19d8528d64db0090f59779386b962e6a9ca40c38
# Vessel's patch revision on top of that tag -- see FEX_REVISION for why this
# exists at all. 1: patches/wine/0018 (null swapchain surface) and 0019 (a log
# line longer than 1019 bytes killing the process).
# 2: patches/wine/0027, the swapchain extent clamped to maxImageExtent.
# 3: patches/wine/0028, the whole swapchain create_info and its pNext chain.
# 4: patches/wine/0029, the futexwho channel. Requiem reaches a created
#    swapchain and then never draws, with 492,808 RtlWakeAddressAll against 259
#    RtlWaitOnAddress on one address -- a wake storm that starves the wait,
#    because RtlWaitOnAddress returns without queueing when the compared value
#    has changed. The counts came from `sync`; this names the thread.
# 5: no patch — the build gained GnuTLS. Wine's bcrypt had no unix backend
#    at all (dlls/bcrypt/gnutls.c is wrapped in HAVE_GNUTLS_CIPHER_INIT and
#    the sysroot shipped no GnuTLS), so every asymmetric call returned
#    STATUS_NOT_IMPLEMENTED. The payload changes, so the code must too.
# 6: no patch — gmp is now built shared. Revision 5 shipped and ran, and every
#    session logged
#      winediag:gnutls_process_attach Compiled without DH support.
#    because bcrypt gates DH on `HAVE_GMP_H && SONAME_LIBGMP` and only the
#    first was defined: WINE_CHECK_SONAME link-tested -lgmp successfully
#    against a static libgmp.a and then found no NEEDED entry to name. The
#    payload gains libgmp.so and bcrypt.so gains the DH paths, so the code
#    must move again — same reason as 5.
# 7: no patch — the build gained a Media Foundation backend. Revisions up to 6
#    shipped a complete-looking PE Media Foundation (mfplat, mf, mfreadwrite,
#    mfmediaengine, mfsrcsnk, mfmp4srcsnk, mfasfsrcsnk all present in
#    lib/wine/aarch64-windows) on top of NOTHING: lib/wine/aarch64-unix had no
#    winegstreamer.so, and winedmo.so was there but compiled without FFmpeg.
#    Every media open therefore ended at mfsrcsnk/media_source.c's fallback,
#      Failed to create SourceReader with registered byte stream handler.
#      error(c00d36c4)     MF_E_UNSUPPORTED_BYTESTREAM_TYPE
#      ole:com_get_class_object class {317df618-...} not registered
#    which is Resident Evil Requiem's modal dialog. The payload gains
#    winegstreamer.so, a real winedmo.so, GLib, the GStreamer libraries and
#    plugins, and FFmpeg — so the code must move, same reason as 5 and 6.
# 8: patches/wine/0033. wine.inf's [InfFiles] gives every .inf a display name
#    as a string resource *inside the driver that owns it* --
#    wineusb.inf,"@%12%\wineusb.sys,-1" -- and build/wine.sh configures
#    --without-usb, so wineusb.sys is never built. setupapi then reads a
#    resource out of a file that does not exist and logs
#      copy error 1812   (ERROR_RESOURCE_DATA_NOT_FOUND)
#    four times on every provisioning pass. Confirmed against the revision 7
#    package: 38 .sys drivers present, no wineusb anywhere, and exactly one
#    wineusb line in share/wine/wine.inf. Revision 7 is installed on the
#    device, so a payload that kept its code would install as bytes the store
#    already has -- see FEX_REVISION for that failure mode.
WINE_REVISION=8

# Wine Mono and Gecko: pinned and documented, deliberately not shipped.
# dlls/appwiz.cpl/addons.c looks in share/wine/{mono,gecko} before offering to
# download, so staging them there removes the dialog a new container shows.
# Measured: both 249.6 MiB, mono only 146.1 MiB, neither 66.3 MiB, and none of
# it compresses -- an .msi is a CAB already, so xz -9 took the mono payload
# from 85,504,000 to 83,246,320 bytes, 2.6%. Against that: Gecko is the
# embedded MSHTML control that engines replace with CEF, and Mono is .NET
# Framework only -- no WPF, nothing for .NET 5 and later, and Unity ships its
# own. build/wine.sh keeps the fetch helper and the four-line recipe.
WINE_MONO_VERSION=10.4.1
WINE_MONO_SHA256=071f4b2887e1c97a11d791ff3d65be9429eed6dec4c2708888bfd546ba358e23
WINE_GECKO_VERSION=2.47.4
WINE_GECKO_X86_SHA256=26cecc47706b091908f7f814bddb074c61beb8063318e9efc5a7f789857793d6
WINE_GECKO_X86_64_SHA256=e590b7d988a32d6aa4cf1d8aa3aa3d33766fdd4cf4c89c2dcc2095ecb28d066f

# --- Graphics ----------------------------------------------------------------

# Mesa/Turnip for Adreno gen8 (a829). NOT in Mesa mainline as of 2026-08:
# gallium gen8 landed in 26.0-devel, Vulkan is still out-of-tree.
# This branch moves fast and has no tags — the build records the exact SHA
# into the .wcp metadata so any build is reproducible after the fact.
MESA_REPO=https://github.com/whitebelyash/mesa-unified.git
MESA_REF=turnip/gen8

# Prefer pinning to a known-good commit over tracking the branch head.
#
# Community reference: StevenMXZ "Turnip Gen8" V33, built from this same
# whitebelyash turnip/gen8 branch plus Mesa upstream. It lists explicit support
# for a840/a830/a829/a825/810 and reports Vulkan 1.4.354. V33 is confirmed
# working on this device, so it is the behaviour our build should match or beat.
#   Release: https://github.com/StevenMXZ/freedreno_turnip-CI/releases (tag v33)
#   Build recipe: StevenMXZ/Adreno-Tools-Drivers @ A8xx, build_turnip.sh
#
# Note: the "50cbd61" shown on that release page is a commit in the *CI* repo
# (the build scripts), not a Mesa commit — it identifies the recipe, not the
# source. The Mesa SHA has to come from the CI run log or from the built
# driver itself:
#   strings libvulkan_freedreno.so | grep -iE 'mesa [0-9]|git-[0-9a-f]{7,}'
#
# Leave empty to build the branch head; set it to freeze a reproducible build.
# Pinned 2026-08-07. The branch head moved under us mid-session (9c51ede5 ->
# 9c475fc3) and both Mesa components silently changed version, which is exactly
# what a moving ref does. 9c475fc3 is the commit Turnip and Zink were both
# verified against. Clear this to track the head again.
MESA_SHA=9c475fc3

# Zink — desktop OpenGL over Vulkan, built from Mesa as an ARM64EC PE
# opengl32.dll (see build/zink.sh for why a native opengl32.dll rather than
# winex11.drv). It is built from the SAME checkout as Turnip above, so it has
# no ref of its own and MESA_REF versions both.
#
# These two exist only as an escape hatch. The Turnip tree is a fork carrying
# out-of-tree freedreno gen8 work and nothing in its CI builds for Windows, so
# it is possible for a rebase there to break the WGL path while Turnip itself
# is fine. Setting ZINK_MESA_REF moves the Zink build to its own checkout at
# native/mesa-zink (upstream Mesa unless ZINK_MESA_REPO says otherwise) and
# leaves Turnip untouched. Also update ref_var in .github/workflows/zink.yml
# if you set it, or CI will keep watching MESA_REF.
#
# Leave both empty to share the Turnip tree, which is the intended state.
ZINK_MESA_REPO=
ZINK_MESA_REF=

# libadrenotools — the only reason a Mesa driver can be loaded on Android at all.
# Turnip builds as an Android Vulkan HAL (one exported symbol, HMI), so the
# platform loader is the only thing that can load it, and it will only load a
# driver out of a vendor namespace. libadrenotools interposes android_dlopen_ext
# so the driver can come from app storage instead. See
# docs/ARCHITECTURE.md#turnip-does-need-adrenotools.
#
# VENDORED, NOT FETCHED — unlike everything else in this file. It ships inside
# the APK rather than as a .wcp, because its hook objects must live in
# `applicationInfo.nativeLibraryDir` and nowhere else works; the reasoning is in
# app/src/main/cpp/adrenotools/README.md. No build script reads these two values
# and there is no ADRENOTOOLS_REF for CI to watch. They are here because this
# file is where the question "what version of X does Vessel build?" is answered,
# and an exception that is not written down is a version nobody can find.
#
# Updating it means re-copying the source into app/src/main/cpp/adrenotools/ and
# changing the commit here and in that directory's README.
ADRENOTOOLS_REPO=https://github.com/bylaws/libadrenotools.git
ADRENOTOOLS_SHA=8fae8ce
ADRENOTOOLS_LINKERNSBYPASS_SHA=aa39758

DXVK_REPO=https://github.com/doitsujin/dxvk.git
DXVK_REF=v2.7.1

VKD3D_REPO=https://github.com/HansKristian-Work/vkd3d-proton.git
VKD3D_REF=v3.0.1
# Vessel's patch revision on top of that tag -- see FEX_REVISION.
# 1: patches/vkd3d/0001, the per-shader DXBC header chatter demoted to TRACE.
VKD3D_REVISION=1

# --- Wine's Android dependencies -----------------------------------------------
#
# The NDK ships no X11 and no FreeType, so build/x11-sysroot.sh cross-builds them
# into a staging sysroot that Wine's unix side links against. These are upstream
# release tarballs, not git refs, so they are pinned by version string; the URLs
# are assembled in x11-sysroot.sh from these values.
#
# Every one of these is the newest release that still ships an autotools
# configure script — verified 2026-08-07 by unpacking each tarball. X.Org is
# migrating to meson, and several of these (xorgproto, libXau, libXfixes,
# libXrandr, libXcomposite, libXxf86vm, libXinerama) already carry a meson.build
# alongside. When one of them drops configure entirely, either pin the last
# autotools release or teach x11-sysroot.sh to use meson for that package;
# the script fails loudly on a missing configure rather than skipping it.
#
# Bumping any value here invalidates the sysroot stamp and rebuilds the stack.
X11_UTIL_MACROS=1.20.2
X11_XORGPROTO=2025.1
X11_XTRANS=1.6.0
X11_LIBXAU=1.0.12
X11_XCBPROTO=1.17.0
X11_PTHREAD_STUBS=0.5
X11_LIBXCB=1.17.0
# libxshmfence is not Wine's dependency — it is Mesa's. The X11 WSI in
# wsi_x11.c uses a shared-memory fence per DRI3 buffer to know when the server
# has finished with it, so `-Dplatforms=x11` will not configure without
# xshmfence.pc. Newest release; still autotools (verified by unpacking).
X11_LIBXSHMFENCE=1.3.3
X11_LIBX11=1.8.13
X11_LIBXEXT=1.3.7
X11_LIBXRENDER=0.9.12
X11_LIBXFIXES=6.0.2
X11_LIBXI=1.8.3
X11_LIBXRANDR=1.5.5
X11_LIBXCURSOR=1.2.3
X11_LIBXCOMPOSITE=0.4.7
X11_LIBXXF86VM=1.1.7
X11_LIBXINERAMA=1.1.6

# GnuTLS and its dependencies, also not X11 and also sharing this sysroot.
#
# Wine's bcrypt has no asymmetric crypto without them, and it fails silently:
# dlls/bcrypt/gnutls.c is the entire unix backend and is wrapped in
# `#ifdef HAVE_GNUTLS_CIPHER_INIT`, so a configure that does not find GnuTLS
# produces a bcrypt.so that returns STATUS_NOT_IMPLEMENTED from every
# asymmetric call and logs "no encryption support". Titles doing licence or
# anti-tamper work through BCryptCreateKeyPair get that and generally crash.
#
# Order matters: gmp, then nettle (whose hogweed half needs gmp and is the part
# GnuTLS uses), then libtasn1, then GnuTLS itself.
#
# All four are LGPL and ship in the .wcp, so they belong in the source offer
# alongside the X11 set.
#
# gmp is the one of the four that must be built SHARED, and the version is not
# what carries that -- build/x11-sysroot.sh's configure flags are. bcrypt gates
# Diffie-Hellman on `HAVE_GMP_H && SONAME_LIBGMP` (dlls/bcrypt/gnutls.c:653) and
# dlopen()s the soname at runtime, so a static libgmp.a leaves SONAME_LIBGMP
# undefined and every session logs "Compiled without DH support." The full
# mechanism, with the config.log lines, is on the gmp entry in that script.
GMP_VERSION=6.3.0
# 3.10, and it must be at least 3.10 -- that is the release that added
# rsa_oaep_sha256_encrypt, which is the function GnuTLS's configure tests to
# decide whether to compile its own RSA-OAEP backport:
#
#   configure.ac:793
#   AM_CONDITIONAL([NEED_RSA_OAEP],
#     [test "$ac_cv_func_nettle_rsa_oaep_sha256_encrypt" != yes])
#
# That backport (lib/nettle/Makefile.am:117-131) includes rsa-sign-tr.c, which
# defines nettle_rsa_compute_root_tr -- a symbol nettle already exports. Compile
# both and the link dies:
#
#   ld.lld: error: duplicate symbol: nettle_rsa_compute_root_tr
#   >>> rsa-sign-tr.o in archive nettle/.libs/libcrypto.a
#
# The check is AC_CHECK_FUNC, which does not survive a cross build, so configure
# concludes the function is absent however new nettle is. build/x11-sysroot.sh
# therefore forces the cache variable on GnuTLS's configure line. Going back to
# 3.9.1 was tried and is strictly worse: that release really does lack the
# function, so the backport is genuinely needed and the collision is unavoidable.
NETTLE_VERSION=3.10
LIBTASN1_VERSION=4.19.0
GNUTLS_VERSION=3.8.4
GNUTLS_SERIES=3.8

# FreeType is not X11 but shares the same sysroot: Wine's configure treats a
# missing FreeType as a hard error, and a Wine without it has no glyph
# rasterizer at all.
FREETYPE_VERSION=2.14.3

# --- GStreamer, and the Media Foundation backend it is ------------------------
#
# Wine's whole media stack is winegstreamer. mfplat, mfreadwrite, mf, mfsrcsnk
# and the DirectShow parsers are PE modules that do format negotiation and
# nothing else; every demux and every decode happens in winegstreamer.so on the
# unix side. Build Wine --without-gstreamer and those PE DLLs still install, so
# the tree *looks* complete -- and then
#
#   MFCreateSourceReaderFromByteStream -> 0xC00D36C4  MF_E_UNSUPPORTED_BYTESTREAM_TYPE
#   ole:com_get_class_object class {317df618-5e5a-468a-9f15-d827a9a08162} not registered
#
# That CLSID is CLSID_GStreamerByteStreamHandler
# (dlls/winegstreamer/winegstreamer_classes.idl). It is the only byte stream
# handler Wine has for anything that is not a raw WAV or MP3, so with
# winegstreamer absent every media open fails and titles that gate on their
# intro video stop on a modal dialog. Measured with Resident Evil Requiem.
#
# configure.ac:1731 names the pkg-config modules, and all five must resolve or
# WINE_PACKAGE_FLAGS leaves GSTREAMER_CFLAGS empty and skips the rest of the
# check silently:
#
#   gstreamer-1.0 gstreamer-video-1.0 gstreamer-audio-1.0
#   gstreamer-tag-1.0 gstreamer-gl-1.0
#
# gstreamer-gl-1.0 is not optional and not a mistake: unixlib.c and wg_parser.c
# both #include <gst/gl/gl.h>. It is a build-time dependency only --
# gst_gl_display_new() failing at runtime is a GST_ERROR, not a fatal.
#
# The GStreamer modules are one release, always. Mixing 1.28 core with 1.26
# plugins is not supported upstream and the failure is a plugin that loads and
# then reports no features.
GSTREAMER_VERSION=1.28.6

# GLib is GStreamer's whole object system, and it needs these two. Both are
# glib meson subprojects when absent, which would make the build fetch from the
# network mid-run -- so they are pinned and built here instead.
#
# pcre2 is built --disable-jit deliberately. PCRE2's JIT wants an anonymous
# PROT_EXEC mapping, which is the same execmod restriction that shapes how this
# project loads everything else on Android, and GRegex is not on any path where
# the JIT would pay for the risk.
LIBFFI_VERSION=3.4.8
PCRE2_VERSION=10.45
GLIB_VERSION=2.88.3
GLIB_SERIES=2.88

# The third GLib dependency, and the one that is not obvious: bionic has no
# gettext and no libintl at all, and `-Dnls=disabled` does NOT make GLib stop
# needing one -- meson.build:2352 asks for the `intl` dependency unconditionally
# and falls straight through to its subproject:
#
#   Run-time dependency intl found: NO  (tried builtin and system)
#   Looking for a fallback subproject for the dependency intl
#   ERROR: Subproject proxy-libintl is buildable: NO
#   meson.build:2352:12: ERROR: Automatic wrap-based subproject downloading is disabled
#
# proxy-libintl is the stub GLib's own subprojects/proxy-libintl.wrap names, and
# 0.5 is the exact version and tarball that wrap points at -- sha256
# f7a1cbd7579baaf575c66f9d99fb6295e9b0684a28b095967cfda17857595303, verified
# against the wrap file in the GLib tarball. Building it explicitly rather than
# letting meson download it keeps the rule this file exists for: everything
# built is answerable from this repository, and no build reaches the network for
# a source it did not pin.
PROXY_LIBINTL_VERSION=0.5

# FFmpeg, reached only through gst-libav. This is the H.264 and AAC decoder --
# without it the plugin set can demux an MP4 and then has nothing to hand the
# video track to, which meets the letter of "winegstreamer builds" and none of
# the point of it.
#
# LGPL, not GPL: no --enable-gpl and no --enable-nonfree. Wine is LGPL-2.1 and
# so is the rest of this payload; enabling GPL components would change the
# license of the package. It also costs nothing we want -- the GPL pieces here
# are x264/x265 encoders and the yadif deinterlacer, and GStreamer does its own
# deinterlacing.
#
# --target-os=android is load-bearing beyond the obvious. FFmpeg's configure
# has an explicit android case that sets SLIB_INSTALL_NAME='$(SLIBNAME)' and
# SLIB_INSTALL_LINKS='', i.e. UNVERSIONED sonames -- libavcodec.so, not
# libavcodec.so.62. Everything else in this payload is unversioned too (bionic
# has no versioned-symlink chain and build/wine.sh copies *.so by glob), so a
# linux target here would ship a libavcodec.so that no NEEDED entry names.
FFMPEG_VERSION=8.0.3

# --- Toolchain ---------------------------------------------------------------
# Pinned in the Dockerfile, restated here so one file answers "what versions?".
#
# NDK r29 is REQUIRED, and the reason is not the clang version number.
#
# Verified by probe on 2026-08-07:
#   r28c -> clang "19.0.1" (Android build of LLVM snapshot r530567e)
#           --print-supported-cpus tops out at cortex-x4. NO oryon-1.
#           Both -mcpu=oryon-1 and -mtune=oryon-1 are REJECTED.
#   r29  -> clang "21.0.0" (snapshot r563880c). oryon-1 present, both
#           -mcpu=oryon-1 and -mtune=oryon-1 accepted.
#
# oryon-1 landed in upstream LLVM 19, but Android's clang 19 is built from a
# pre-oryon snapshot, so the advertised version number is not a reliable proxy.
# Box64's SD8EG5 preset hardcodes -mtune=oryon-1, so on r28c the build fails at
# compile time. Do not "downgrade to a known-good NDK" without re-probing.
ANDROID_NDK_VERSION=r29
ANDROID_API_LEVEL=36

# llvm-mingw provides the arm64ec-w64-mingw32 target used for FEX's PE DLLs
# and Wine's ARM64EC build.
LLVM_MINGW_VERSION=20250910

# --- Target ------------------------------------------------------------------
# Selects the flag set in build/targets/<TARGET>.env
TARGET=canoe
